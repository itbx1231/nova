});

// ─── Local System Stats (for docker/node-exporter type) ──────────────────────
async function getLocalSystemStats(svc) {
  // If host is localhost or same machine — use si directly
  const isLocal = ['localhost', '127.0.0.1', '0.0.0.0', '::1'].includes((svc.host || '').toLowerCase());
  if (isLocal) {
    const [mem, fsArr, nets] = await Promise.all([
      si.mem().catch(() => ({})),
      si.fsSize().catch(() => []),
      si.networkStats().catch(() => []),
    ]);
    const cachedHost = state.hosts['localhost'] || {};
    const cpuPct   = cachedHost.cpu || 0;
    const memPct   = cachedHost.mem || (mem.total ? Math.round((mem.active / mem.total) * 100) : 0);
    const memUsed  = mem.active  ? (mem.active  / 1024 / 1024 / 1024).toFixed(2) : '0';
    const memTotal = mem.total   ? (mem.total   / 1024 / 1024 / 1024).toFixed(2) : '0';
    const rootFs   = (fsArr || []).find(f => f.mount === '/' || f.mount === 'C:' || f.mount === 'C:\\') || (fsArr || [])[0] || {};
    const diskFreeGb  = rootFs.available ? (rootFs.available  / 1024 / 1024 / 1024).toFixed(1) : '0';
    const diskTotalGb = rootFs.size      ? (rootFs.size       / 1024 / 1024 / 1024).toFixed(1) : '0';
    const diskUsedPct = rootFs.use       ? rootFs.use.toFixed(1) : '0';
    const net0     = (nets || [])[0] || {};
    const rxMB     = net0.rx_sec ? (net0.rx_sec / 1024 / 1024).toFixed(2) : '0';
    const txMB     = net0.tx_sec ? (net0.tx_sec / 1024 / 1024).toFixed(2) : '0';

    return {
      cpu_load_1m:   cpuPct,
      cpu_cores:     require('os').cpus().length,
      cpu_cores_data: [],
      mem_used_pct:  memPct,
      mem_used_gb:   parseFloat(memUsed),
      mem_total_gb:  parseFloat(memTotal),
      disk_free_gb:  parseFloat(diskFreeGb),
      disk_total_gb: parseFloat(diskTotalGb),
      disk_used_pct: parseFloat(diskUsedPct),
      net_rx_mb:     parseFloat(rxMB),
      net_tx_mb:     parseFloat(txMB),
      uptime_days:   Math.floor((si.time ? si.time().uptime : 0) / 86400),
      platform:      process.platform,
      hostname:      require('os').hostname(),
      // Legacy fields for compatibility
      status: 'online', latency: 0,
    };
  }

  // Remote: try Node Exporter HTTP API (port 9100)
  try {
    const resp = await axios.get(`http://${svc.host}:${svc.port || 9100}/metrics`, { timeout: 5000 });
    const text = resp.data || '';
    const parseMetric = (name) => {
      const m = text.match(new RegExp(`^${name}\\s+([0-9.e+]+)`, 'm'));
      return m ? parseFloat(m[1]) : null;
    };
    const cpuIdle = parseMetric('node_cpu_seconds_total{.*mode="idle"') ||
                   parseMetric('node_cpu_seconds_total.*idle');
    const memFree = parseMetric('node_memory_MemFree_bytes');
    const memTotal = parseMetric('node_memory_MemTotal_bytes');
    const diskFree = parseMetric('node_filesystem_avail_bytes{mountpoint="/"');
    const diskTotal = parseMetric('node_filesystem_size_bytes{mountpoint="/"');

    return {
      cpu_load_1m:   cpuIdle !== null ? Math.round((1 - cpuIdle) * 100) : null,
      mem_used_pct:  (memFree && memTotal) ? Math.round(((memTotal - memFree) / memTotal) * 100) : null,
      mem_used_gb:   (memFree && memTotal) ? parseFloat(((memTotal - memFree) / 1e9).toFixed(2)) : null,
      mem_total_gb:  memTotal ? parseFloat((memTotal / 1e9).toFixed(2)) : null,
      disk_free_gb:  diskFree ? parseFloat((diskFree / 1e9).toFixed(1)) : null,
      disk_total_gb: diskTotal ? parseFloat((diskTotal / 1e9).toFixed(1)) : null,
      status: 'online', latency: 0,
    };
  } catch (e) {
    // Fallback: TCP ping only
    const { ok, latency } = await tcpPing(svc.host, svc.port || 9100, 3000);
    return { status: ok ? 'online' : 'offline', latency };
  }
}

// ─── GET live stats for a service ────────────────────────────────────────────
app.get('/api/services/:id/stats', async (req, res) => {
  try {
    const services = await db.getServices();
    const svc = services.find(s => s.id === parseInt(req.params.id));
    if (!svc) return res.status(404).json({ error: 'Not found' });
    let stats = {};
    if (svc.type === 'postgres') stats = await getPgStats(svc);
    else if (svc.type === 'redis')   stats = await getRedisStats(svc);
    else if (svc.type === 'mongodb') stats = await getMongoStats(svc);
    else stats = await getLocalSystemStats(svc);  // docker / node-exporter
    await db.updateServiceStatus(svc.id, 'online', stats.latency || 0);
    res.json({ ...stats, service: svc });
  } catch (e) {
    const id = parseInt(req.params.id);
    await db.updateServiceStatus(id, 'offline', 0);
    res.status(500).json({ error: e.message });
  }
});

// ─── GET historical chart data for a service stat ─────────────────────────────
app.get('/api/services/:id/history', async (req, res) => {
  try {
    const data = await db.getServiceStats(
      parseInt(req.params.id),
      req.query.key || 'connections_active',
      parseInt(req.query.limit) || 30
    );
    res.json(data);
  } catch (e) { res.status(500).json({ error: e.message }); }
});

function getDefaultPort(type) {
  return { postgres: 5432, redis: 6379, mongodb: 27017, docker: 2375 }[type] || 80;
}

// ─── Background polling for registered services (every 30s) ──────────────────
async function pollServices() {
  try {
    const services = await db.getServices();
    for (const svc of services) {
      try {
        let stats = {};
        if (svc.type === 'postgres') stats = await getPgStats(svc);
        else if (svc.type === 'redis') stats = await getRedisStats(svc);
        else if (svc.type === 'mongodb') stats = await getMongoStats(svc);
        await db.updateServiceStatus(svc.id, 'online', stats.latency || 0);
        // Save key metrics for history charts
        const keyMap = {
          postgres: [['connections_active', stats.connections_active], ['cache_hit_pct', stats.cache_hit_pct]],
          redis:    [['used_memory_mb', stats.used_memory_mb], ['hit_rate_pct', stats.hit_rate_pct], ['total_commands_ps', stats.total_commands_ps]],
          mongodb:  [['connections_current', stats.connections_current], ['ops_query', stats.ops_query]],
        };
        (keyMap[svc.type] || []).forEach(([k, v]) => {
          if (v !== undefined) db.saveServiceStat(svc.id, k, parseFloat(v) || 0);
        });
        io.emit('service:update', { id: svc.id, status: 'online', stats });
      } catch {
        await db.updateServiceStatus(svc.id, 'offline', 0);
        io.emit('service:update', { id: svc.id, status: 'offline', stats: {} });
      }
    }
  } catch (e) { console.error('[Services] Poll error:', e.message); }
}
