// ═══════════════════════════════════════════════════════════════════════════
// AUTH API (JWT) — JWT_SECRET, authMiddleware, verifyAdmin defined at top of file
// ═══════════════════════════════════════════════════════════════════════════

// ─── Brute-Force Protection ──────────────────────────────────────────────────
const loginAttempts = new Map(); // IP -> { count, firstAttempt, locked }
const LOGIN_MAX_ATTEMPTS = 5;
const LOGIN_LOCKOUT_MS = 15 * 60 * 1000; // 15 minutes

const getClientIp = (req) => {
  return req.headers['x-forwarded-for']?.split(',')[0]?.trim()
    || req.headers['x-real-ip']
    || req.socket?.remoteAddress
    || 'unknown';
};

// POST /api/auth/login
app.post('/api/auth/login', async (req, res) => {
  const clientIp = getClientIp(req);
  const { username, password, remember } = req.body;
  const ts = new Date().toISOString();

  try {
    // ── Check brute-force lockout ──
    const record = loginAttempts.get(clientIp);
    if (record && record.locked && (Date.now() - record.lockedAt < LOGIN_LOCKOUT_MS)) {
      const remainMin = Math.ceil((LOGIN_LOCKOUT_MS - (Date.now() - record.lockedAt)) / 60000);
      db.logEvent('hub', 'security', `[BLOCKED] Login attempt from LOCKED IP ${clientIp} (user: '${username || '?'}'). ${remainMin}min remaining.`);
      return res.status(429).json({ error: `Account locked. Try again in ${remainMin} minutes.` });
    }
    // Reset if lockout expired
    if (record && record.locked && (Date.now() - record.lockedAt >= LOGIN_LOCKOUT_MS)) {
      loginAttempts.delete(clientIp);
    }

    // ── Validate input ──
    if (!username || !password) {
      db.logEvent('hub', 'security', `[FAILED_LOGIN] Empty credentials from IP ${clientIp}`);
      return res.status(400).json({ error: 'Username and password required' });
    }

    // ── Check user exists ──
    const user = await db.getUser(username);
    if (!user) {
      registerFailedAttempt(clientIp, username, 'USER_NOT_FOUND');
      db.logEvent('hub', 'security', `[FAILED_LOGIN] user='${username}' ip=${clientIp} reason=USER_NOT_FOUND at ${ts}`);
      return res.status(401).json({ error: 'Invalid credentials' });
    }

    // ── Verify password ──
    const valid = await bcrypt.compare(password, user.password_hash);
    if (!valid) {
      registerFailedAttempt(clientIp, username, 'WRONG_PASSWORD');
      db.logEvent('hub', 'security', `[FAILED_LOGIN] user='${username}' ip=${clientIp} reason=WRONG_PASSWORD at ${ts}`);
      return res.status(401).json({ error: 'Invalid credentials' });
    }

    // ── Success: clear failed attempts for this IP ──
    loginAttempts.delete(clientIp);
    await db.updateLastLogin(user.id);

    const expiresIn = remember ? '30d' : '24h';
    const token = jwt.sign({ id: user.id, username: user.username, role: user.role }, JWT_SECRET, { expiresIn });

    db.logEvent('hub', 'auth', `[SUCCESS_LOGIN] user='${username}' ip=${clientIp} role=${user.role} at ${ts}`);
    res.json({ token, user: { id: user.id, username: user.username, role: user.role } });
  } catch (e) {
    db.logEvent('hub', 'security', `[LOGIN_ERROR] user='${username || '?'}' ip=${clientIp} error=${e.message}`);
    res.status(500).json({ error: e.message });
  }
});

function registerFailedAttempt(ip, username, reason) {
  const record = loginAttempts.get(ip) || { count: 0, attempts: [] };
  record.count++;
  record.attempts.push({ username, reason, time: new Date().toISOString() });

  if (record.count >= LOGIN_MAX_ATTEMPTS) {
    record.locked = true;
    record.lockedAt = Date.now();
    db.logEvent('hub', 'security', `[LOCKOUT] IP ${ip} LOCKED after ${record.count} failed attempts. Last user tried: '${username}'`);
    console.warn(`[SECURITY] IP ${ip} locked out after ${record.count} failed login attempts.`);
  }

  loginAttempts.set(ip, record);
}

// GET /api/auth/verify
app.get('/api/auth/verify', authMiddleware, async (req, res) => {
  try {
    const user = await db.getUserById(req.user.id);
    if (!user) return res.status(401).json({ valid: false });
    // Sanitize user before sending back
    res.json({ valid: true, user: { id: user.id, username: user.username, role: user.role } });
  } catch { res.status(401).json({ valid: false }); }
});

// POST /api/auth/logout
app.post('/api/auth/logout', authMiddleware, (req, res) => {
  const clientIp = getClientIp(req);
  db.logEvent('hub', 'auth', `[LOGOUT] user='${req.user.username}' ip=${clientIp}`);
  res.json({ success: true });
});

// GET /api/security/failed-logins — Admin only: view all blocked IPs and failed attempts
app.get('/api/security/failed-logins', verifyAdmin, (req, res) => {
  const results = [];
  loginAttempts.forEach((record, ip) => {
    results.push({
      ip,
      count: record.count,
      locked: !!record.locked,
      lockedAt: record.lockedAt ? new Date(record.lockedAt).toISOString() : null,
      remainingLockoutMin: record.locked ? Math.max(0, Math.ceil((LOGIN_LOCKOUT_MS - (Date.now() - record.lockedAt)) / 60000)) : 0,
      attempts: record.attempts || []
    });
  });
  res.json(results);
});

// POST /api/security/unlock-ip — Admin only: manually unlock a blocked IP
app.post('/api/security/unlock-ip', verifyAdmin, (req, res) => {
  const { ip } = req.body;
  if (!ip) return res.status(400).json({ error: 'IP address required' });
  if (loginAttempts.has(ip)) {
    loginAttempts.delete(ip);
    db.logEvent('hub', 'security', `[ADMIN_UNLOCK] IP ${ip} manually unlocked by ${req.user.username}`);
    res.json({ success: true, message: `IP ${ip} unlocked.` });
  } else {
    res.json({ success: true, message: `IP ${ip} was not locked.` });
  }
});

// POST /api/auth/change-password
app.post('/api/auth/change-password', authMiddleware, async (req, res) => {
  try {
    const { currentPassword, newPassword } = req.body;
    const user = await db.getUser(req.user.username);
    const valid = await bcrypt.compare(currentPassword, user.password_hash);
    if (!valid) return res.status(400).json({ error: 'Current password incorrect' });
    const hash = await bcrypt.hash(newPassword, 12);
    await db.pool.query(`UPDATE users SET password_hash = $1 WHERE id = $2`, [hash, user.id]);
    res.json({ success: true });
  } catch (e) { res.status(500).json({ error: e.message }); }
});

// GET /api/auth/users
app.get('/api/auth/users', authMiddleware, verifyAdmin, async (req, res) => {
  try { res.json(await db.getUsers()); } catch (e) { res.status(500).json({ error: e.message }); }
});

// POST /api/auth/users (Create User)
app.post('/api/auth/users', authMiddleware, verifyAdmin, async (req, res) => {
  try {
    const { username, password, role } = req.body;
    if (!username || !password) return res.status(400).json({ error: 'Username and password required' });
    const existing = await db.getUser(username);
    if (existing) return res.status(400).json({ error: 'Username already exists' });
    const hash = await bcrypt.hash(password, 12);
    await db.createUser(username, hash, role || 'viewer');
    db.logEvent('hub', 'auth', `Admin created new user '${username}'`);
    res.json({ success: true });
  } catch (e) { res.status(500).json({ error: e.message }); }
});

// PUT /api/auth/users/:id/role
app.put('/api/auth/users/:id/role', authMiddleware, verifyAdmin, async (req, res) => {
  try {
    const { role } = req.body;
    if (!['admin', 'viewer'].includes(role)) return res.status(400).json({ error: 'Invalid role' });
    // Prevent self-demotion
    if (parseInt(req.params.id) === req.user.id && role !== 'admin') {
      return res.status(400).json({ error: 'Cannot demote yourself' });
    }
    await db.updateUserRole(req.params.id, role);
    db.logEvent('hub', 'auth', `Admin updated role to '${role}' for user ID ${req.params.id}`);
    res.json({ success: true });
  } catch (e) { res.status(500).json({ error: e.message }); }
});

// DELETE /api/auth/users/:id
app.delete('/api/auth/users/:id', authMiddleware, verifyAdmin, async (req, res) => {
  try {
    // Prevent self-deletion
    if (parseInt(req.params.id) === req.user.id) {
      return res.status(400).json({ error: 'Cannot delete yourself' });
    }
    await db.deleteUser(req.params.id);
    db.logEvent('hub', 'auth', `Admin deleted user ID ${req.params.id}`);
    res.json({ success: true });
  } catch (e) { res.status(500).json({ error: e.message }); }
});

// ═══════════════════════════════════════════════════════════════════════════
// PHASE 2: SMART ALERTS ENGINE
// ═══════════════════════════════════════════════════════════════════════════
const alertCooldown = new Map(); // serviceId -> lastAlertTimestamp
const ALERT_COOLDOWN_MS = 5 * 60 * 1000; // 5 minutes

async function sendAlertNotification(svc, message, severity = 'critical') {
  const now = Date.now();
  const last = alertCooldown.get(svc.id) || 0;
  if (now - last < ALERT_COOLDOWN_MS) return; // cooldown active
  alertCooldown.set(svc.id, now);

  db.logAlert({ service_id: svc.id, service_name: svc.name, service_type: svc.type, severity, message, channel: 'system', sent: false });
  io.emit('alert:new', { service_id: svc.id, service_name: svc.name, severity, message, timestamp: new Date().toISOString() });

  // Fetch webhooks
  const webhooks = await db.getWebhooks().catch(() => []);
  for (const wh of webhooks.filter(w => w.enabled)) {
    try {
      if (wh.type === 'discord' && wh.url) {
        await axios.post(wh.url, {
          embeds: [{
            title: `🚨 ${severity.toUpperCase()}: ${svc.name}`,
            description: message,
            color: severity === 'critical' ? 0xFF0000 : 0xFFA500,
            fields: [{ name: 'Service Type', value: svc.type, inline: true }, { name: 'Host', value: svc.host, inline: true }],
            timestamp: new Date().toISOString(),
            footer: { text: 'Disk Monitoring System GUI' }
          }]
        });
        db.logAlert({ service_id: svc.id, service_name: svc.name, service_type: svc.type, severity, message, channel: 'discord', sent: true });
      } else if (wh.type === 'telegram' && wh.token && wh.chatId) {
        const text = `🚨 *${severity.toUpperCase()}*: ${svc.name}\n${message}\nHost: \`${svc.host}\`\nType: ${svc.type}`;
        await axios.post(`https://api.telegram.org/bot${wh.token}/sendMessage`, { chat_id: wh.chatId, text, parse_mode: 'Markdown' });
        db.logAlert({ service_id: svc.id, service_name: svc.name, service_type: svc.type, severity, message, channel: 'telegram', sent: true });
      }
    } catch (err) { console.error('[Alert] Webhook failed:', err.message); }
  }
}

// GET /api/alerts - alert history
app.get('/api/alerts', async (req, res) => {
  try { res.json(await db.getAlertLog(parseInt(req.query.limit) || 100)); } catch (e) { res.status(500).json({ error: e.message }); }
});

// POST /api/alerts/test - test webhook (SSRF-protected)
app.post('/api/alerts/test', async (req, res) => {
  try {
    const { type, url, token, chatId } = req.body;
    if (type === 'discord' && url) {
      if (!validateExternalUrl(url)) {
        return res.status(400).json({ error: 'Invalid or blocked webhook URL' });
      }
      await axios.post(url, { content: '✅ **Nova Command Center** — Webhook test successful!' }, { timeout: 10000, maxRedirects: 2 });
    } else if (type === 'telegram' && token && chatId) {
      // Telegram API is always external, but sanitize token
      const safeToken = String(token).replace(/[^a-zA-Z0-9:_-]/g, '');
      const safeChatId = String(chatId).replace(/[^a-zA-Z0-9_@-]/g, '');
      await axios.post(`https://api.telegram.org/bot${safeToken}/sendMessage`, {
        chat_id: safeChatId,
        text: '✅ *Nova Command Center* — Webhook test successful!',
        parse_mode: 'Markdown'
      }, { timeout: 10000 });
    } else {
      return res.status(400).json({ error: 'Invalid webhook type or missing parameters' });
    }
    res.json({ success: true });
  } catch (e) { res.status(500).json({ error: 'Webhook test failed. Check URL and credentials.' }); }
});

// Hook alert engine into pollServices — patch the catch block
const _origPoll = pollServices;
// Replace pollServices with alert-aware version
(async () => {
  // Monkey-patch: wrap the existing pollServices to trigger alerts
  const originalInterval = setInterval; // already called above
})();

// Enhanced service poller WITH alerts
async function pollServicesWithAlerts() {
  try {
    const services = await db.getServices();
    for (const svc of services) {
      const wasOnline = svc.status === 'online';
      try {
        let stats = {};
        if (svc.type === 'postgres') stats = await getPgStats(svc);
        else if (svc.type === 'redis') stats = await getRedisStats(svc);
        else if (svc.type === 'mongodb') stats = await getMongoStats(svc);
        await db.updateServiceStatus(svc.id, 'online', stats.latency || 0);
        const keyMap = {
          postgres: [['connections_active', stats.connections_active], ['cache_hit_pct', stats.cache_hit_pct]],
          redis:    [['used_memory_mb', stats.used_memory_mb], ['hit_rate_pct', stats.hit_rate_pct], ['total_commands_ps', stats.total_commands_ps]],
          mongodb:  [['connections_current', stats.connections_current], ['ops_query', stats.ops_query]],
        };
        (keyMap[svc.type] || []).forEach(([k, v]) => {
          if (v !== undefined) db.saveServiceStat(svc.id, k, parseFloat(v) || 0);
        });
        io.emit('service:update', { id: svc.id, status: 'online', stats });
        // Recovery alert
        if (!wasOnline) {
          await sendAlertNotification(svc, `✅ ${svc.name} is back ONLINE on ${svc.host}`, 'info');
        }
      } catch {
        await db.updateServiceStatus(svc.id, 'offline', 0);
        io.emit('service:update', { id: svc.id, status: 'offline', stats: {} });
        if (wasOnline) {
          await sendAlertNotification(svc, `❌ ${svc.name} went OFFLINE on ${svc.host}:${svc.port}`, 'critical');
        }
      }
    }
  } catch (e) { console.error('[Services] Poll error:', e.message); }
}
setInterval(pollServicesWithAlerts, 30000);

// ═══════════════════════════════════════════════════════════════════════════
// PHASE 4: REPORTS API
// ═══════════════════════════════════════════════════════════════════════════
app.get('/api/reports/summary', async (req, res) => {
  try {
    const [services, events, hosts_data] = await Promise.all([
      db.getServices(),
      db.getEvents(200),
      Promise.resolve({}),
    ]);
    const summary = {
      generated_at: new Date().toISOString(),
      services: {
        total: services.length,
        online: services.filter(s => s.status === 'online').length,
        offline: services.filter(s => s.status === 'offline').length,
        by_type: services.reduce((acc, s) => { acc[s.type] = (acc[s.type] || 0) + 1; return acc; }, {}),
        list: services.map(s => ({ id:s.id, name:s.name, type:s.type, host:s.host, port:s.port, status:s.status, latency:s.latency, last_checked:s.last_checked }))
      },
      recent_events: events.slice(0, 50),
      alert_count: (await db.getAlertLog(500)).length,
    };
    res.json(summary);
  } catch (e) { res.status(500).json({ error: e.message }); }
});

app.get('/api/reports/services-csv', async (req, res) => {
  try {
    const services = await db.getServices();
    const header = 'id,name,type,host,port,status,latency_ms,last_checked\n';
    const rows = services.map(s => `${s.id},"${s.name}",${s.type},${s.host},${s.port||''},${s.status||'unknown'},${s.latency||0},${s.last_checked||''}`).join('\n');
    res.setHeader('Content-Type', 'text/csv');
    res.setHeader('Content-Disposition', 'attachment; filename="services-report.csv"');
    res.send(header + rows);
  } catch (e) { res.status(500).json({ error: e.message }); }
});

// ─── API Routes (Services) ──────────────────────────────────────────────────
// ─── Docker Container Management ──────────────────────────────────────────
const cp = require('child_process');
const util = require('util');
const execPromise = util.promisify(cp.exec);

app.post('/api/docker/:action', verifyAdmin, async (req, res) => {
  const action = req.params.action;
  const { containerId } = req.body;
  if (!['start', 'stop', 'restart'].includes(action)) {
    return res.status(400).json({ error: 'Invalid action' });
  }
  if (!containerId || !SAFE_CONTAINER_ID.test(containerId)) {
    db.logEvent('hub', 'security', `[BLOCKED] Invalid container ID format: '${String(containerId).substring(0, 50)}' from user ${req.user.username}`);
    return res.status(400).json({ error: 'Invalid container ID format. Only alphanumeric, dots, hyphens, and underscores allowed.' });
  }
  
  try {
    // Use execFile (not exec) to prevent shell injection entirely
    const { execFile } = require('child_process');
    const result = await new Promise((resolve, reject) => {
      execFile('docker', [action, containerId], { timeout: 30000 }, (err, stdout, stderr) => {
        if (err) return reject(err);
        resolve({ stdout, stderr });
      });
    });
    logEvent('system', `Docker container ${containerId} ${action}ed by ${req.user.username}`, { output: result.stdout || result.stderr });
    res.json({ success: true, message: `Container ${action}ed successfully.` });
  } catch (err) {
    logEvent('error', `Failed to ${action} docker container ${containerId}`, { error: err.message });
    res.status(500).json({ error: 'Docker operation failed. Check container status.' });
  }
});


// ═══════════════════════════════════════════════════════════════════════════
// FULL SYSTEM SCAN ENGINE
// ═══════════════════════════════════════════════════════════════════════════
async function runFullSystemScan(jobId, hostId, _io, scanMode) {
  const emitEvt = (event, data) => _io.emit(event, { jobId, ...data });
  const logMsg  = (msg)         => emitEvt('fullscan:log', { msg, ts: Date.now() });
  const mode    = scanMode || 'deep';
  const isDeep  = mode === 'deep' || mode === 'full';
  const isFull  = mode === 'full';

  // ── Step registry: id -> display name, modes that include it ─────────────
  const STEP_REGISTRY = [
    { id:'system',      name:'System Snapshot',       modes:['*'] },
    { id:'kernel',      name:'Kernel Deep Analysis',  modes:['deep','full','kernel'] },
    { id:'filesystem',  name:'Filesystem Intelligence', modes:['deep','full','storage','filesystem'] },
    { id:'logs',        name:'Log Intelligence',      modes:['deep','full','logs'] },
    { id:'services',    name:'Service Analysis',      modes:['quick','deep','full','services'] },
    { id:'network',     name:'Network Diagnostics',   modes:['quick','deep','full','network'] },
    { id:'security',    name:'Security Audit',        modes:['deep','full','security'] },
    { id:'docker',      name:'Containers & Docker',   modes:['deep','full','docker'] },
    { id:'database',    name:'Database Analysis',     modes:['deep','full','database'] },
    { id:'correlation', name:'AI Correlation Engine', modes:['*'] },
    { id:'rootcause',   name:'Root Cause Inference',  modes:['*'] },
    { id:'report',      name:'Report Generation',     modes:['*'] }
  ];
  const ACTIVE_STEPS = STEP_REGISTRY.filter(s => s.modes.includes('*') || s.modes.includes(mode));
  const STEPS = ACTIVE_STEPS.map(s => s.name);
  const totalSteps = ACTIVE_STEPS.length;
  const stepIdx = (id) => ACTIVE_STEPS.findIndex(s => s.id === id);
  const shouldRun = (id) => stepIdx(id) !== -1;
  const pctFor = (id, phase) => {
    const i = stepIdx(id); if (i < 0) return 0;
    const base = Math.round((i / totalSteps) * 100);
    const next = Math.round(((i+1) / totalSteps) * 100);
    return phase === 'done' ? next : base;
  };
  const stepStart = (id) => {
    const i = stepIdx(id); if (i < 0) return;
    emitEvt('fullscan:progress', { pct: pctFor(id,'start') });
    emitEvt('fullscan:step', { step: i, name: STEPS[i], status: 'running' });
  };
  const stepDone = (id) => {
    const i = stepIdx(id); if (i < 0) return;
    emitEvt('fullscan:progress', { pct: pctFor(id,'done') });
    emitEvt('fullscan:step', { step: i, name: STEPS[i], status: 'done' });
  };
  const stepError = (id) => {
    const i = stepIdx(id); if (i < 0) return;
    emitEvt('fullscan:step', { step: i, name: STEPS[i], status: 'error' });
  };

  emitEvt('fullscan:init', { mode, totalSteps, steps: ACTIVE_STEPS.map(s => ({ id: s.id, name: s.name })) });
  logMsg('[INIT] Scan started · Mode: ' + mode.toUpperCase() + ' · Target: ' + hostId + ' · Steps: ' + totalSteps);
  let results = {};

  // ── Determine if we scan locally or via SSH ─────────────────────────────
  const isRemote = hostId && hostId !== 'localhost' && hostId !== '127.0.0.1';
  let sshConn = null;

  if (isRemote) {
    const bareHost = hostId.replace(/^ssh-/, '');
    const findCfg = (cfgs) => (cfgs || []).find(h =>
      h.hostId === hostId || h.host === hostId || h.name === hostId ||
      h.host === bareHost || ('ssh-' + h.host) === hostId ||
      h.hostname === bareHost
    );
    let hostCfg = findCfg(sshConfigs);
    // Fallback: reload from DB if not found in memory (in-memory may be stale on cold start)
    if (!hostCfg) {
      try {
        const dbHosts = await db.getSshHosts();
        sshConfigs = dbHosts;
        hostCfg = findCfg(dbHosts);
        if (hostCfg) logMsg('[INIT] Loaded SSH config from DB (in-memory cache was empty)');
      } catch(e) { logMsg('[ERROR] DB fallback failed: ' + e.message); }
    }
    if (!hostCfg) {
      logMsg('[ERROR] Remote host not found in SSH configs: ' + hostId);
      emitEvt('fullscan:complete', { report: { error: 'Host not found', hostId, overallScore: 0, health: 'UNKNOWN' } });
      return;
    }
    logMsg('[INIT] Connecting to remote host: ' + (hostCfg.name || hostId));
    try {
      sshConn = await new Promise((resolve, reject) => {
        const { Client } = require('ssh2');
        const conn = new Client();
        conn.on('ready', () => resolve(conn));
        conn.on('error', reject);
        conn.connect({
          host: hostCfg.host || hostCfg.hostname || hostId,
          port: hostCfg.port || 22,
          username: hostCfg.user || hostCfg.username || 'ubuntu',
          password: hostCfg.password || hostCfg.pass,
          privateKey: hostCfg.privateKey || hostCfg.privatekey || hostCfg.private_key,
          readyTimeout: 20000
        });
      });
      logMsg('[INIT] SSH connected to ' + (hostCfg.name || hostId));
    } catch(e) {
      logMsg('[ERROR] SSH connection failed: ' + e.message);
      emitEvt('fullscan:complete', { report: { error: e.message, hostId, overallScore: 0, health: 'UNREACHABLE' } });
      return;
    }
  }

  // Safe command runner — never throws, always resolves
  function runCmd(cmd, timeoutMs) {
    const tms = timeoutMs || (isDeep ? 18000 : 12000);
    if (isRemote && sshConn) {
      return new Promise((resolve) => {
        let done = false;
        const fin = (v) => { if (!done) { done = true; resolve((v||'').trim()); } };
        try {
          sshConn.exec(cmd, { pty: false }, (err, stream) => {
            if (err) return fin('');
            let out = '';
            stream.on('data', d => { out += d.toString(); });
            stream.stderr.on('data', d => { out += d.toString(); });
            stream.on('close', () => fin(out));
            setTimeout(() => { try { stream.destroy(); } catch(_){} fin(out); }, tms);
          });
        } catch(e) { fin(''); }
      });
    }
    return new Promise((resolve) => {
      const cp = require('child_process');
      try {
        const out = cp.execSync(cmd, { timeout: tms, encoding: 'utf8', stdio: ['pipe','pipe','pipe'] });
        resolve((out || '').trim());
      } catch(e) { resolve(((e.stdout||'') + (e.stderr||'')).trim()); }
    });
  }

  // Run multiple commands in parallel, return array of results
  async function runAll(cmds) {
    return Promise.all(cmds.map(c => runCmd(c)));
  }

  // ═══════════════════════════════════════════════════════════════
  // STEP: System Snapshot  (always runs)
  // ═══════════════════════════════════════════════════════════════
  if (shouldRun('system')) {
  stepStart('system');
  logMsg('[SYSTEM] Collecting system snapshot...');
  try {
    const [uname, loadRaw, memRaw, cpuInfo, cpuCores, uptime, reboot, swapRaw, zombies, openFiles] = await runAll([
      'uname -a',
      'cat /proc/loadavg',
      'free -m',
      "grep -m1 'model name' /proc/cpuinfo 2>/dev/null || echo 'Unknown CPU'",
      'nproc',
      'uptime -p 2>/dev/null || uptime',
      "last reboot 2>/dev/null | head -4 || echo 'No reboot history'",
      "free -m | grep Swap || echo 'Swap: 0 0 0'",
      "ps aux 2>/dev/null | awk '{print $8}' | grep -c '^Z' || echo 0",
      "cat /proc/sys/fs/file-nr 2>/dev/null || echo '0 0 0'"
    ]);
    const topCpu = await runCmd("ps aux --sort=-%cpu 2>/dev/null | head -10 || echo ''");
    const lp = loadRaw.split(' ');
    const load1 = parseFloat(lp[0])||0, load5 = parseFloat(lp[1])||0, load15 = parseFloat(lp[2])||0;
    const mp = (memRaw.split('\n')[1]||'').split(/\s+/).filter(Boolean);
    const memTotal = parseInt(mp[1])||0, memUsed = parseInt(mp[2])||0;
    const memPct = memTotal > 0 ? Math.round(memUsed/memTotal*100) : 0;
    const sp = swapRaw.split(/\s+/).filter(Boolean);
    const swapTotal = parseInt(sp[1])||0, swapUsed = parseInt(sp[2])||0;
    const zombieCount = parseInt(zombies)||0;
    const openFileParts = openFiles.split(/\s+/);
    const openFd = parseInt(openFileParts[0])||0, maxFd = parseInt(openFileParts[2])||0;
    results.system = { uname, load1, load5, load15, memTotal, memUsed, memPct, swapTotal, swapUsed,
      cpuInfo: cpuInfo.replace(/model name\s*:\s*/i,''), cpuCores: parseInt(cpuCores)||1,
      uptime, zombieCount, openFd, maxFd, topCpu };
    logMsg('[SYSTEM] Kernel: ' + uname.split(' ').slice(0,3).join(' '));
    logMsg('[SYSTEM] Uptime: ' + uptime.trim().slice(0,70));
    logMsg('[SYSTEM] Load: ' + load1 + ' / ' + load5 + ' / ' + load15 + '  Cores: ' + (parseInt(cpuCores)||1));
    logMsg('[SYSTEM] Memory: ' + memUsed + 'MB / ' + memTotal + 'MB (' + memPct + '%)' + (swapUsed > 0 ? '  Swap: ' + swapUsed + 'MB / ' + swapTotal + 'MB' : ''));
    if (zombieCount > 0) logMsg('[SYSTEM] WARNING: ' + zombieCount + ' zombie process(es) detected');
    if (maxFd > 0 && openFd / maxFd > 0.8) logMsg('[SYSTEM] WARNING: File descriptors at ' + Math.round(openFd/maxFd*100) + '% capacity (' + openFd + '/' + maxFd + ')');
    topCpu.split('\n').slice(1,5).forEach(l => {
      const p = l.trim().split(/\s+/);
      const cmd = (p[10]||p[11]||'?');
      const base = String(cmd).split('/').pop();
      // skip the snapshot tooling itself (ps/sort/head pipeline reports ~100% as a measurement artifact)
      if (p[2] && parseFloat(p[2]) > 10 && !/^(ps|sort|head|awk|grep|aux)$/.test(base))
        logMsg('[SYSTEM] HIGH CPU: ' + cmd + ' ' + p[2] + '%');
    });
    reboot.split('\n').filter(l => l.trim() && !l.startsWith('wtmp')).slice(0,1)
      .forEach(l => logMsg('[SYSTEM] Last boot: ' + l.trim().replace(/\s+/g,' ').slice(0,80)));
    stepDone('system');
  } catch(e) { logMsg('[SYSTEM] ERROR: ' + e.message); stepError('system'); }
  } // end shouldRun(system)

  // ═══════════════════════════════════════════════════════════════
  // STEP: Kernel Deep Analysis
  if (shouldRun('kernel')) {
  // ═══════════════════════════════════════════════════════════════
  stepStart('kernel');
  logMsg('[KERNEL] Scanning kernel ring buffer and system state...');
  try {
    const [dmesgErr, oomEvents, kernelVer, oopsRaw, overcommit, panicVal, thermal, schedInfo, hugePgs] = await runAll([
      "dmesg -T --level=err,crit,alert,emerg 2>/dev/null | tail -40 || journalctl -k -p 3 -n 40 --no-pager 2>/dev/null | tail -40",
      "dmesg 2>/dev/null | grep -i 'oom\\|killed process\\|out of memory' | tail -10",
      'uname -r',
      "dmesg 2>/dev/null | grep -ic 'oops\\|panic\\|BUG:' || echo 0",
      "cat /proc/sys/vm/overcommit_memory 2>/dev/null || echo 0",
      "cat /proc/sys/kernel/panic 2>/dev/null || echo 0",
      "dmesg 2>/dev/null | grep -i 'thermal\\|temperature\\|cpu.*hot\\|overheat\\|throttl' | tail -8 || echo ''",
      "cat /proc/schedstat 2>/dev/null | head -5 || echo ''",
      "cat /proc/meminfo 2>/dev/null | grep -i 'huge\\|dirty\\|writeback\\|commit' | head -10 || echo ''"
    ]);
    const kernLog = await runCmd("grep -i 'oom\\|kill\\|panic\\|segfault\\|call trace\\|hardware error\\|mce' /var/log/kern.log 2>/dev/null | tail -20 || echo ''");
    // Hardware machine-check errors (MCE/EDAC) and hung/blocked tasks
    const [mceRaw, hungRaw, blockedTasks] = await runAll([
      "dmesg 2>/dev/null | grep -iE 'mce:|machine check|hardware error|edac|uncorrectable|memory error' | tail -8 || echo ''",
      "dmesg 2>/dev/null | grep -iE 'hung_task|blocked for more than|task.*blocked' | tail -6 || echo ''",
      "ps -eo stat,pid,comm 2>/dev/null | awk '$1 ~ /^D/{print $2,$3}' | head -8 || echo ''"
    ]);
    const errLines  = dmesgErr.split('\n').filter(l => l.trim());
    const oomLines  = oomEvents.split('\n').filter(l => l.trim());
    const kernLines = kernLog.split('\n').filter(l => l.trim());
    const thrmLines = thermal.split('\n').filter(l => l.trim());
    const mceLines  = mceRaw.split('\n').filter(l => l.trim());
    const hungLines = hungRaw.split('\n').filter(l => l.trim());
    const blockedLines = blockedTasks.split('\n').filter(l => l.trim());
    const oopsCount = parseInt(oopsRaw)||0;
    results.kernel = { errors: errLines, oomEvents: oomLines, version: kernelVer, oopsCount, errCount: errLines.length,
      kernLog: kernLines, thermalEvents: thrmLines, overcommit: parseInt(overcommit)||0,
      panicTimeout: parseInt(panicVal)||0, hugePages: hugePgs,
      mceEvents: mceLines, hungTasks: hungLines, blockedProcs: blockedLines };
    logMsg('[KERNEL] Version: ' + kernelVer);
    logMsg('[KERNEL] Ring buffer errors: ' + errLines.length + '  OOM kills: ' + oomLines.length + '  Panics/oops: ' + oopsCount + '  MCE/HW: ' + mceLines.length + '  Hung tasks: ' + hungLines.length);
    if (mceLines.length) { logMsg('[KERNEL] CRITICAL: ' + mceLines.length + ' hardware/machine-check event(s)'); mceLines.slice(0,3).forEach(l => logMsg('[KERNEL] MCE: ' + l.trim().slice(0,100))); }
    if (hungLines.length) { logMsg('[KERNEL] WARNING: ' + hungLines.length + ' hung-task event(s)'); }
    if (blockedLines.length > 2) logMsg('[KERNEL] WARNING: ' + blockedLines.length + ' process(es) in uninterruptible sleep (D state)');
    if (parseInt(overcommit) === 1) logMsg('[KERNEL] WARNING: Memory overcommit mode=1 (aggressive allocation)');
    if (parseInt(panicVal) === 0) logMsg('[KERNEL] INFO: Kernel panic on oops disabled (may hide crashes)');
    oomLines.slice(0,4).forEach(l => logMsg('[KERNEL] OOM: ' + l.trim().slice(0,110)));
    errLines.slice(0,5).forEach(l => logMsg('[KERNEL] ERR: ' + l.trim().slice(0,110)));
    thrmLines.slice(0,3).forEach(l => logMsg('[KERNEL] THERMAL: ' + l.trim().slice(0,90)));
    kernLines.slice(0,3).forEach(l => logMsg('[KERNEL] KERN.LOG: ' + l.trim().slice(0,90)));
    stepDone('kernel');
  } catch(e) { logMsg('[KERNEL] ERROR: ' + e.message); stepError('kernel'); }
  } // end shouldRun(kernel)

  // ═══════════════════════════════════════════════════════════════
  // STEP: Filesystem Intelligence
  if (shouldRun('filesystem')) {
  // ═══════════════════════════════════════════════════════════════
  stepStart('filesystem');
  logMsg('[FILESYSTEM] Inspecting disk usage, inodes, I/O and storage health...');
  try {
    const [dfOut, dfInodes, lsblk, mdStat, lvmInfo, ioWait, zfsStat, fsErrors, deletedOpen] = await runAll([
      'df -h 2>/dev/null || df',
      'df -ih 2>/dev/null | head -20 || echo ""',
      'lsblk -o NAME,SIZE,TYPE,FSTYPE,MOUNTPOINT,ROTA 2>/dev/null | head -25',
      'cat /proc/mdstat 2>/dev/null || echo "No RAID"',
      'vgs 2>/dev/null | head -10 || echo "No LVM"',
      "iostat -x 1 1 2>/dev/null | grep -v '^$\\|Device\\|Linux\\|avg-cpu' | head -15 || cat /proc/diskstats 2>/dev/null | awk '{print $3,$6,$10}' | head -10 || echo ''",
      "zpool status -x 2>/dev/null || echo 'no zfs'",
      "dmesg 2>/dev/null | grep -iE 'ext4-fs error|xfs.*error|i/o error|remount.*read-only|read-only file system|btrfs.*error' | tail -8 || echo ''",
      "lsof -nP 2>/dev/null | grep -i '(deleted)' | awk '{print $1,$2,$9}' | head -10 || echo ''"
    ]);
    // SMART health (run in parallel for all block devices)
    const devs = lsblk.split('\n').filter(l => l.includes('disk')).map(l => l.trim().split(/\s+/)[0]).slice(0,4);
    const smartResults = await Promise.all(devs.map(d =>
      runCmd("sudo -n smartctl -H /dev/" + d + " 2>&1 | grep -i 'overall\\|health\\|PASSED\\|FAILED' | head -3 || echo ''", 5000)
    ));
    const smartSummary = devs.map((d,i) => {
      let out = (smartResults[i]||'').trim();
      // Strip permission/access errors — those are not real disk failures
      if (/permission denied|open device.*failed|requires.*root|operation not permitted/i.test(out)) out = 'unreadable (insufficient privileges)';
      return d + ': ' + (out || 'N/A').slice(0,60);
    }).filter(s => s.includes(':'));

    const critDisks = [], warnDisks = [], inodeCrit = [];
    dfOut.split('\n').slice(1).forEach(line => {
      const parts = line.trim().split(/\s+/);
      if (parts.length >= 5) {
        const pctStr = parts.find(p => p.endsWith('%'));
        const pct = pctStr ? parseInt(pctStr) : 0;
        const mp = parts[parts.length-1] || '';
        if (mp && mp.startsWith('/')) {
          if (pct >= 90) critDisks.push({ mount: mp, pct });
          else if (pct >= 75) warnDisks.push({ mount: mp, pct });
        }
      }
    });
    dfInodes.split('\n').slice(1).forEach(line => {
      const parts = line.trim().split(/\s+/);
      const pctIdx = parts.findIndex(p => p.endsWith('%'));
      if (pctIdx >= 0) {
        const pct = parseInt(parts[pctIdx]);
        const mp = parts[parts.length-1]||'';
        if (pct >= 80 && mp.startsWith('/')) inodeCrit.push(mp + ' ' + pct + '%');
      }
    });

    const fsErrLines = fsErrors.split('\n').filter(l => l.trim());
    const deletedOpenLines = deletedOpen.split('\n').filter(l => l.trim());
    const zfsHealthy = /no zfs|all pools are healthy/i.test(zfsStat) || !zfsStat.trim();
    results.filesystem = { dfOut, lsblk, critDisks, warnDisks, inodeCrit, ioWait, mdStat, lvmInfo, smartSummary,
      zfsStatus: zfsStat.trim(), zfsHealthy, fsErrors: fsErrLines, deletedOpen: deletedOpenLines };
    logMsg('[FILESYSTEM] Mounts critical (≥90%): ' + critDisks.length + '  Warning (≥75%): ' + warnDisks.length);
    if (fsErrLines.length) { logMsg('[FILESYSTEM] CRITICAL: ' + fsErrLines.length + ' filesystem error(s) in kernel log'); fsErrLines.slice(0,3).forEach(l => logMsg('[FILESYSTEM] FS-ERROR: ' + l.trim().slice(0,100))); }
    if (!zfsHealthy) logMsg('[FILESYSTEM] CRITICAL: ZFS pool not healthy — ' + zfsStat.split('\n')[0].slice(0,80));
    if (deletedOpenLines.length > 3) logMsg('[FILESYSTEM] INFO: ' + deletedOpenLines.length + ' deleted-but-open file handle(s) (possible space not reclaimed)');
    if (inodeCrit.length) logMsg('[FILESYSTEM] INODE EXHAUSTION WARNING: ' + inodeCrit.join(', '));
    critDisks.forEach(d => logMsg('[FILESYSTEM] CRITICAL: ' + d.mount + ' at ' + d.pct + '% — immediate action required'));
    warnDisks.forEach(d => logMsg('[FILESYSTEM] WARNING: ' + d.mount + ' at ' + d.pct + '%'));
    smartSummary.forEach(s => { if (/FAIL|fail/i.test(s)) logMsg('[FILESYSTEM] SMART FAIL: ' + s); else if (s.trim()) logMsg('[FILESYSTEM] SMART: ' + s); });
    if (mdStat && !mdStat.includes('No RAID')) {
      const degraded = mdStat.split('\n').find(l => /\[.*_.*\]/.test(l));
      const activeArr = mdStat.split('\n').find(l => /^md\d+\s*:/.test(l.trim()));
      if (degraded) logMsg('[FILESYSTEM] CRITICAL: RAID array degraded — ' + degraded.trim().slice(0,80));
      else if (activeArr) logMsg('[FILESYSTEM] RAID: ' + activeArr.trim().slice(0,70) + ' — healthy');
      else logMsg('[FILESYSTEM] RAID: no active arrays configured');
    }
    if (ioWait && isDeep) {
      ioWait.split('\n').filter(l=>l.trim()).slice(0,5).forEach(l => {
        const p = l.trim().split(/\s+/);
        if (p[13] && parseFloat(p[13]) > 20) logMsg('[FILESYSTEM] HIGH I/O WAIT: ' + p[0] + ' await=' + p[7] + 'ms util=' + p[13] + '%');
      });
    }
    stepDone('filesystem');
  } catch(e) { logMsg('[FILESYSTEM] ERROR: ' + e.message); stepError('filesystem'); }
  } // end shouldRun(filesystem)

  // ═══════════════════════════════════════════════════════════════
  // STEP: Log Intelligence
  if (shouldRun('logs')) {
  // ═══════════════════════════════════════════════════════════════
  stepStart('logs');
  logMsg('[LOGS] Aggregating system, auth, service and application logs...');
  try {
    const [journalErr, authFails, sshFails, authRecent, nginxErr, svcRestarts] = await runAll([
      "journalctl -p err -n 60 --no-pager 2>/dev/null || tail -n 60 /var/log/syslog 2>/dev/null || grep -i 'error\\|crit\\|emerg' /var/log/messages 2>/dev/null | tail -40 || echo 'No journal'",
      "grep -c 'authentication failure\\|Failed password\\|Invalid user' /var/log/auth.log 2>/dev/null || journalctl _SYSTEMD_UNIT=sshd.service -n 200 --no-pager 2>/dev/null | grep -c 'Failed\\|Invalid' || echo 0",
      "grep -c 'Failed password' /var/log/auth.log 2>/dev/null || echo 0",
      "grep 'Failed password\\|Invalid user\\|Accepted password\\|Accepted publickey' /var/log/auth.log 2>/dev/null | tail -15 || echo ''",
      "tail -n 30 /var/log/nginx/error.log 2>/dev/null || tail -n 30 /var/log/apache2/error.log 2>/dev/null || echo ''",
      "journalctl --since -2h --no-pager 2>/dev/null | grep -i 'start limit\\|restarting\\|segfault\\|core dump\\|killed\\|oom' | head -15 || echo ''"
    ]);
    const dockerLogs = isDeep
      ? await runCmd("docker ps -q 2>/dev/null | head -4 | xargs -I{} sh -c 'docker inspect --format={{.Name}} {} 2>/dev/null; docker logs --tail=8 {} 2>&1' | grep -i 'error\\|fatal\\|panic\\|exception' | head -15 || echo ''")
      : '';
    // Frequency analysis: most-recurring error signatures + crash counters
    const [freqRaw, segfaults, coreDumps, timeouts] = await runAll([
      "journalctl -p err --since -24h --no-pager 2>/dev/null | sed -E 's/^[A-Za-z]{3}\\s+[0-9]+\\s+[0-9:]+\\s+\\S+\\s+//; s/[0-9]+//g' | sort | uniq -c | sort -rn | head -6 || echo ''",
      "journalctl --since -24h --no-pager 2>/dev/null | grep -c -i 'segfault' || echo 0",
      "journalctl --since -24h --no-pager 2>/dev/null | grep -c -i 'core dump\\|dumped core' || echo 0",
      "journalctl --since -24h --no-pager 2>/dev/null | grep -c -i 'timed out\\|timeout' || echo 0"
    ]);
    const dbLogs = isFull
      ? await runCmd("tail -n 20 /var/log/postgresql/*.log 2>/dev/null | grep -i 'error\\|fatal\\|panic' | head -10 || journalctl -u postgresql -n 20 --no-pager 2>/dev/null | grep -i 'error\\|fatal' | head -10 || echo ''")
      : '';
    const errLines = journalErr.split('\n').filter(l => l.trim() && !l.startsWith('--'));
    const authFail = parseInt(authFails)||0, sshFail = parseInt(sshFails)||0;
    const authLines = authRecent.split('\n').filter(l => l.trim());
    const nginxLines = nginxErr.split('\n').filter(l => l.trim());
    const restartLines = svcRestarts.split('\n').filter(l => l.trim());
    const freqLines = freqRaw.split('\n').filter(l => l.trim()).map(l => {
      const m = l.trim().match(/^(\d+)\s+(.*)$/);
      return m ? { count: parseInt(m[1]), pattern: m[2].trim().slice(0,90) } : null;
    }).filter(Boolean);
    const segCount = parseInt(segfaults)||0, coreCount = parseInt(coreDumps)||0, timeoutCount = parseInt(timeouts)||0;
    results.logs = { recentErrors: errLines.slice(0,20), authFailures: authFail, sshFailures: sshFail,
      errCount: errLines.length, authLines, nginxErrors: nginxLines, dockerErrors: dockerLogs, dbErrors: dbLogs,
      topErrors: freqLines, segfaults: segCount, coreDumps: coreCount, timeouts: timeoutCount };
    logMsg('[LOGS] Journal errors: ' + errLines.length + '  Auth failures: ' + authFail + '  SSH brute attempts: ' + sshFail);
    logMsg('[LOGS] 24h crash signals — segfaults:' + segCount + ' core-dumps:' + coreCount + ' timeouts:' + timeoutCount);
    if (freqLines.length) { logMsg('[LOGS] Top recurring errors (24h):'); freqLines.slice(0,3).forEach(f => logMsg('[LOGS]   ' + f.count + '× ' + f.pattern)); }
    if (segCount > 0) logMsg('[LOGS] WARNING: ' + segCount + ' segfault(s) in last 24h');
    if (sshFail > 50) logMsg('[LOGS] CRITICAL: Massive SSH brute force — ' + sshFail + ' failed attempts');
    else if (sshFail > 10) logMsg('[LOGS] WARNING: SSH brute force activity — ' + sshFail + ' failures');
    errLines.slice(0,4).forEach(l => logMsg('[LOGS] ERR: ' + l.trim().slice(0,110)));
    authLines.filter(l => /Failed|Invalid/i.test(l)).slice(0,4).forEach(l => logMsg('[LOGS] AUTH: ' + l.trim().slice(0,100)));
    nginxLines.slice(0,3).forEach(l => logMsg('[LOGS] WEBSERVER: ' + l.trim().slice(0,100)));
    restartLines.slice(0,3).forEach(l => logMsg('[LOGS] RESTART: ' + l.trim().slice(0,90)));
    if (dockerLogs) dockerLogs.split('\n').filter(l=>l.trim()).slice(0,4).forEach(l => logMsg('[LOGS] DOCKER: ' + l.trim().slice(0,100)));
    if (dbLogs) dbLogs.split('\n').filter(l=>l.trim()).slice(0,3).forEach(l => logMsg('[LOGS] DATABASE: ' + l.trim().slice(0,100)));
    stepDone('logs');
  } catch(e) { logMsg('[LOGS] ERROR: ' + e.message); stepError('logs'); }
  } // end shouldRun(logs)

  // ═══════════════════════════════════════════════════════════════
  // STEP: Service Analysis
  if (shouldRun('services')) {
  // ═══════════════════════════════════════════════════════════════
  stepStart('services');
  logMsg('[SERVICES] Verifying systemd units, PM2 processes and service health...');
  try {
    const [failedSvc, activating, pm2List, critSvcs, runningCount] = await runAll([
      "systemctl --failed --no-legend --no-pager 2>/dev/null | head -20",
      "systemctl list-units --state=activating --no-legend --no-pager 2>/dev/null | head -10 || echo ''",
      "pm2 list --no-color 2>/dev/null || echo 'pm2 not available'",
      "systemctl is-active nginx apache2 mysql postgresql redis-server mongodb docker 2>/dev/null | paste - - - - - - - - <(echo nginx apache2 mysql postgresql redis mongodb docker) 2>/dev/null | grep -v active || echo ''",
      "systemctl list-units --state=running --no-legend --no-pager 2>/dev/null | wc -l || echo 0"
    ]);
    const highRestart = isDeep
      ? await runCmd("journalctl --since -2h --no-pager 2>/dev/null | grep -c 'start limit\\|restarting' || echo 0")
      : '0';
    const failedLines = failedSvc.split('\n').filter(l => l.trim());
    const actLines    = activating.split('\n').filter(l => l.trim());
    const pm2Errors   = pm2List.split('\n').filter(l => /error|stopped|errored/i.test(l)).length;
    const pm2Running  = pm2List.split('\n').filter(l => l.includes('online')).length;
    results.services = { failedServices: failedLines, activating: actLines, pm2Status: pm2List,
      failedCount: failedLines.length, pm2Errors, pm2Running, runningUnits: parseInt(runningCount)||0,
      restartCount: parseInt(highRestart)||0 };
    logMsg('[SERVICES] Running units: ' + (parseInt(runningCount)||0) + '  Failed: ' + failedLines.length + '  Stuck: ' + actLines.length + '  PM2: ' + pm2Running + ' online / ' + pm2Errors + ' error');
    failedLines.forEach(l => logMsg('[SERVICES] FAILED UNIT: ' + l.trim()));
    actLines.slice(0,4).forEach(l => logMsg('[SERVICES] STUCK ACTIVATING: ' + l.trim()));
    if (pm2Errors > 0) logMsg('[SERVICES] WARNING: ' + pm2Errors + ' PM2 process(es) in error state');
    if (parseInt(highRestart) > 5) logMsg('[SERVICES] WARNING: ' + highRestart + ' service restarts in last 2 hours');
    stepDone('services');
  } catch(e) { logMsg('[SERVICES] ERROR: ' + e.message); stepError('services'); }
  } // end shouldRun(services)

  // ═══════════════════════════════════════════════════════════════
  // STEP: Network Diagnostics
  if (shouldRun('network')) {
  // ═══════════════════════════════════════════════════════════════
  stepStart('network');
  logMsg('[NETWORK] Analyzing network connectivity, ports and traffic...');
  try {
    const [ssListen, ssSummary, connCount, ifStats, routeInfo, arpTable] = await runAll([
      "ss -tlnp 2>/dev/null | head -25",
      "ss -s 2>/dev/null | head -8 || netstat -s 2>/dev/null | head -10 || echo ''",
      "ss -s 2>/dev/null | grep 'TCP:' | grep -o '[0-9]* estab' | grep -o '[0-9]*' || echo 0",
      "ip -s link 2>/dev/null | head -30 || cat /proc/net/dev 2>/dev/null | awk 'NR>2{print $1,$2,$10}' | head -10 || echo ''",
      "ip route 2>/dev/null | head -10 || route -n 2>/dev/null | head -10 || echo ''",
      "arp -n 2>/dev/null | head -10 || ip neigh 2>/dev/null | head -10 || echo ''"
    ]);
    const pingTest = await runCmd("ping -c 4 -W 2 8.8.8.8 2>/dev/null || echo 'ping failed'", 12000);
    // DNS resolution, default gateway reachability, interface errors, local TLS cert
    const [dnsTest, gwInfo, ifErrors, tlsCert] = await runAll([
      "getent hosts google.com >/dev/null 2>&1 && echo ok || (nslookup google.com >/dev/null 2>&1 && echo ok || echo fail)",
      "ip route 2>/dev/null | awk '/^default/{print $3; exit}' || echo ''",
      "for i in /sys/class/net/*; do n=$(basename $i); re=$(cat $i/statistics/rx_errors 2>/dev/null||echo 0); dr=$(cat $i/statistics/rx_dropped 2>/dev/null||echo 0); te=$(cat $i/statistics/tx_errors 2>/dev/null||echo 0); [ \"$n\" != lo ] && [ $((re+dr+te)) -gt 0 ] && echo \"$n rx_err=$re rx_drop=$dr tx_err=$te\"; done 2>/dev/null | head -6 || echo ''",
      "echo | timeout 5 openssl s_client -connect 127.0.0.1:443 2>/dev/null | openssl x509 -noout -enddate 2>/dev/null || echo ''"
    ]);
    const gw = gwInfo.trim();
    const gwPing = gw ? await runCmd("ping -c 2 -W 2 " + gw + " 2>/dev/null | grep -o '[0-9]*% packet loss' || echo '100% packet loss'", 8000) : '';
    const connStorm = isDeep
      ? await runCmd("ss -tn 2>/dev/null | awk 'NR>1{split($5,a,\":\"); print a[1]}' | sort | uniq -c | sort -rn | head -8 || echo ''")
      : '';
    const pingMatch = pingTest.match(/(\d+)% packet loss/);
    const pktLoss = pingMatch ? parseInt(pingMatch[1]) : (pingTest.includes('failed') ? 100 : 0);
    const estab = parseInt(connCount)||0;
    const dnsOk = /ok/.test(dnsTest);
    const gwReachable = gw ? !/100% packet loss/.test(gwPing) : null;
    const ifErrLines = ifErrors.split('\n').filter(l => l.trim());
    // TLS cert days-to-expiry (port 443)
    let tlsDays = null, tlsExpiry = '';
    const tlsM = tlsCert.match(/notAfter=(.+)/);
    if (tlsM) { tlsExpiry = tlsM[1].trim(); const d = Math.round((new Date(tlsExpiry) - Date.now())/86400000); if (!isNaN(d)) tlsDays = d; }
    // Scan ALL exposed TLS-capable ports that are actually listening
    const tlsCerts = [];
    if (tlsDays !== null) tlsCerts.push({ port: 443, expiry: tlsExpiry, days: tlsDays });
    try {
      const listenSet = {};
      ssListen.split('\n').forEach(l => l.trim().split(/\s+/).forEach(p => { const m = p.match(/:(\d{1,5})$/); if (m) listenSet[m[1]] = true; }));
      const tlsCandidates = [8443,9443,4443,5443,10443,993,995,465,636,990,1443];
      const tlsPorts = tlsCandidates.filter(p => listenSet[String(p)]).slice(0,6);
      for (const p of tlsPorts) {
        const out = await runCmd("echo | timeout 5 openssl s_client -connect 127.0.0.1:" + p + " 2>/dev/null | openssl x509 -noout -enddate 2>/dev/null || echo ''", 6000);
        const m = out.match(/notAfter=(.+)/);
        if (m) { const exp = m[1].trim(); const d = Math.round((new Date(exp) - Date.now())/86400000); tlsCerts.push({ port: p, expiry: exp, days: isNaN(d)?null:d }); }
      }
    } catch(e) {}
    results.network = { listenPorts: ssListen, pingLoss: pktLoss, isOnline: pktLoss < 100,
      connCount: estab, ssSummary, ifStats, routeInfo, connStorm,
      dnsOk, gateway: gw, gatewayReachable: gwReachable, ifErrors: ifErrLines, tlsExpiry, tlsDays, tlsCerts };
    logMsg('[NETWORK] Connectivity: ' + (pktLoss === 0 ? 'ONLINE (0% loss)' : pktLoss < 100 ? 'DEGRADED (' + pktLoss + '% loss)' : 'OFFLINE'));
    logMsg('[NETWORK] DNS: ' + (dnsOk?'resolving':'FAILED') + ' · Gateway: ' + (gw||'?') + (gwReachable===null?'':(gwReachable?' (reachable)':' (UNREACHABLE)')));
    tlsCerts.forEach(function(tc){ logMsg('[NETWORK] TLS cert (:' + tc.port + ') expires in ' + tc.days + ' day(s) — ' + tc.expiry); });
    if (!dnsOk) logMsg('[NETWORK] WARNING: DNS resolution failing');
    if (gwReachable === false) logMsg('[NETWORK] WARNING: Default gateway ' + gw + ' unreachable');
    tlsCerts.forEach(function(tc){ if (tc.days !== null && tc.days < 21) logMsg('[NETWORK] WARNING: TLS cert on :' + tc.port + ' expires in ' + tc.days + ' days'); });
    ifErrLines.slice(0,3).forEach(l => logMsg('[NETWORK] IF-ERR: ' + l.trim().slice(0,90)));
    logMsg('[NETWORK] Established TCP: ' + estab);
    ssListen.split('\n').slice(1,8).filter(l=>l.trim()).forEach(l => logMsg('[NETWORK] LISTEN: ' + l.trim().slice(0,90)));
    if (pktLoss > 0 && pktLoss < 100) logMsg('[NETWORK] WARNING: ' + pktLoss + '% packet loss to 8.8.8.8');
    if (estab > 500) logMsg('[NETWORK] WARNING: High TCP connection count: ' + estab);
    if (connStorm) {
      connStorm.split('\n').filter(l=>l.trim()).slice(0,4).forEach(l => {
        const p = l.trim().split(/\s+/);
        if (parseInt(p[0]) > 50) logMsg('[NETWORK] CONNECTION STORM: ' + p[1] + ' has ' + p[0] + ' connections');
      });
    }
    stepDone('network');
  } catch(e) { logMsg('[NETWORK] ERROR: ' + e.message); stepError('network'); }
  } // end shouldRun(network)

  // ═══════════════════════════════════════════════════════════════
  // STEP: Security Audit
  if (shouldRun('security')) {
  // ═══════════════════════════════════════════════════════════════
  stepStart('security');
  logMsg('[SECURITY] Running security audit — ports, logins, permissions, anomalies...');
  try {
    const [openPorts, rootLogins, extraRoot, suspExec, crontabs, suidFiles] = await runAll([
      "ss -tlnp 2>/dev/null | grep LISTEN | awk '{print $4}' | sort -u | head -25",
      "last -n 20 2>/dev/null | grep -v 'reboot\\|wtmp\\|^$' | head -10 || echo 'No logins'",
      "awk -F: '($3==0){print $1}' /etc/passwd 2>/dev/null || echo 'root'",
      "find /tmp /var/tmp /dev/shm -maxdepth 3 -type f -executable 2>/dev/null | grep -Ev '/(systemd-private-|snap\\.|\\.X11-unix|\\.ICE-unix|\\.font-unix|\\.Test-unix|pulse-|vmware-|com\\.ubuntu|gvfs-|dbus-)' | head -10 || echo ''",
      "crontab -l 2>/dev/null | grep -v '^#\\|^$' | head -10; ls /etc/cron.*/ 2>/dev/null | head -20 || echo ''",
      isDeep ? "find / -perm -4000 -type f 2>/dev/null | head -20 || echo ''" : "echo ''"
    ]);
    const failedLogins = await runCmd("lastb -n 15 2>/dev/null | head -15 || echo ''", 5000);
    // ── Deep security posture: SSH hardening, firewall, fail2ban, world-writable, sudo abuse ──
    logMsg('[SECURITY] Checking SSH hardening, firewall and privilege configuration...');
    const [sshdCfg, ufwStat, iptCount, nftCount, f2bActive, f2bJails, worldWr, sudoNopw] = await runAll([
      "sudo -n sshd -T 2>/dev/null | grep -iE '^(permitrootlogin|passwordauthentication|permitemptypasswords|maxauthtries) ' || grep -ihE '^\\s*(PermitRootLogin|PasswordAuthentication|PermitEmptyPasswords)' /etc/ssh/sshd_config /etc/ssh/sshd_config.d/*.conf 2>/dev/null | grep -vE '^\\s*#' || echo ''",
      "ufw status 2>/dev/null | head -1 || echo 'ufw: n/a'",
      "sudo -n iptables -L -n 2>/dev/null | grep -cE '^(ACCEPT|DROP|REJECT)' || echo 0",
      "nft list ruleset 2>/dev/null | grep -c 'chain\\|rule' || echo 0",
      "systemctl is-active fail2ban 2>/dev/null || echo 'inactive'",
      "fail2ban-client status 2>/dev/null | grep -i 'jail list' | cut -d: -f2 || echo ''",
      "find /etc /usr/local /opt /var/www /srv -xdev -type f -perm -0002 2>/dev/null | head -10 || echo ''",
      "grep -rhE 'NOPASSWD' /etc/sudoers /etc/sudoers.d/ 2>/dev/null | grep -vE '^\\s*#' | head -10 || echo ''"
    ]);
    const portLines = openPorts.split('\n').filter(l => l.trim());
    const authFail  = (results.logs||{}).authFailures || 0;
    const sshFail   = (results.logs||{}).sshFailures  || 0;
    const suspFiles = suspExec.split('\n').filter(l => l.trim());
    const rootUsers = extraRoot.split('\n').filter(l => l.trim());
    const suidList  = suidFiles.split('\n').filter(l => l.trim() && !l.includes('No such'));
    const suspSuid  = suidList.filter(f => !/bin\/(su|sudo|ping|mount|passwd|chsh|chfn|newgrp|crontab|at)\b/.test(f));
    // Parse SSH hardening
    const sshLower = sshdCfg.toLowerCase();
    const sshRootLogin = (sshLower.match(/permitrootlogin\s+(\S+)/)||[])[1] || 'unknown';
    const sshPassAuth  = (sshLower.match(/passwordauthentication\s+(\S+)/)||[])[1] || 'unknown';
    const sshEmptyPw   = (sshLower.match(/permitemptypasswords\s+(\S+)/)||[])[1] || 'no';
    const sshWeak = [];
    if (/^(yes|prohibit-password|without-password)$/.test(sshRootLogin)) sshWeak.push('PermitRootLogin=' + sshRootLogin);
    if (sshPassAuth === 'yes') sshWeak.push('PasswordAuthentication=yes');
    if (sshEmptyPw === 'yes')  sshWeak.push('PermitEmptyPasswords=yes');
    // Firewall posture
    const ufwOn   = /status:\s*active/i.test(ufwStat);
    const iptRules = parseInt(iptCount)||0, nftRules = parseInt(nftCount)||0;
    const fwActive = ufwOn || iptRules > 2 || nftRules > 0;
    const f2bOn = /^active/.test(f2bActive.trim());
    const worldWrFiles = worldWr.split('\n').filter(l => l.trim());
    const sudoNopwd = sudoNopw.split('\n').filter(l => l.trim());
    // ── Hardening tooling: rkhunter / aide / auditd / chkrootkit (read last results only — never run heavy scans) ──
    const [rkhWarn, auditState, auditRules, aidePresent, chkrkLog] = await runAll([
      "command -v rkhunter >/dev/null 2>&1 && (sudo -n grep -ci 'Warning' /var/log/rkhunter.log 2>/dev/null || grep -ci 'Warning' /var/log/rkhunter.log 2>/dev/null || echo present0) || echo 'na'",
      "command -v auditctl >/dev/null 2>&1 && (systemctl is-active auditd 2>/dev/null || echo 'installed') || echo 'na'",
      "command -v auditctl >/dev/null 2>&1 && (sudo -n auditctl -l 2>/dev/null | grep -vc '^No rules' || echo 0) || echo 'na'",
      "command -v aide >/dev/null 2>&1 && (test -f /var/lib/aide/aide.db* 2>/dev/null && echo 'db-present' || echo 'no-db') || echo 'na'",
      "command -v chkrootkit >/dev/null 2>&1 && echo 'installed' || echo 'na'"
    ]);
    const harden = {
      rkhunter: rkhWarn.trim()==='na' ? 'not installed' : (/^\d+$/.test(rkhWarn.trim()) ? (parseInt(rkhWarn)+' warnings in last log') : 'installed (no log yet)'),
      rkhunterWarnings: /^\d+$/.test(rkhWarn.trim()) ? parseInt(rkhWarn) : 0,
      auditd: auditState.trim()==='na' ? 'not installed' : auditState.trim(),
      auditRules: /^\d+$/.test(auditRules.trim()) ? parseInt(auditRules) : 0,
      aide: aidePresent.trim()==='na' ? 'not installed' : aidePresent.trim(),
      chkrootkit: chkrkLog.trim()==='na' ? 'not installed' : 'installed'
    };
    const hardenTools = ['rkhunter','auditd','aide','chkrootkit'].filter(function(k){return harden[k]!=='not installed';});
    logMsg('[SECURITY] Hardening tools: ' + (hardenTools.length ? hardenTools.join(', ') : 'none installed') + (harden.auditd&&harden.auditd!=='not installed' ? ' · auditd:'+harden.auditd+' ('+harden.auditRules+' rules)' : ''));
    if (harden.rkhunterWarnings > 0) logMsg('[SECURITY] WARNING: rkhunter reported ' + harden.rkhunterWarnings + ' warning(s) in last scan');
    results.security = { openPorts: portLines, rootLogins, authFailures: authFail, sshFailures: sshFail,
      portCount: portLines.length, suspiciousFiles: suspFiles, rootUsers, suidFiles: suidList, suspiciousSuid: suspSuid,
      sshRootLogin, sshPassAuth, sshEmptyPw, sshWeak, firewallActive: fwActive, firewallType: ufwOn?'ufw':(iptRules>2?'iptables':(nftRules>0?'nftables':'none')),
      fail2ban: f2bOn, fail2banJails: (f2bJails.trim()||'none'), worldWritable: worldWrFiles, sudoNopasswd: sudoNopwd, harden: harden };
    logMsg('[SECURITY] Listening ports: ' + portLines.length + '  Auth failures: ' + authFail + '  SSH brute: ' + sshFail);
    logMsg('[SECURITY] SSH: root-login=' + sshRootLogin + ' password-auth=' + sshPassAuth + (sshEmptyPw==='yes'?' empty-passwords=YES':''));
    logMsg('[SECURITY] Firewall: ' + (fwActive ? (ufwOn?'UFW active':(iptRules>2?iptRules+' iptables rules':nftRules+' nft rules')) : 'INACTIVE') + ' · Fail2Ban: ' + (f2bOn?'active ('+f2bJails.trim()+')':'inactive'));
    if (sshWeak.length) logMsg('[SECURITY] WARNING: Weak SSH config — ' + sshWeak.join(', '));
    if (!fwActive)            logMsg('[SECURITY] WARNING: No active host firewall detected');
    if (worldWrFiles.length)  logMsg('[SECURITY] WARNING: ' + worldWrFiles.length + ' world-writable file(s): ' + worldWrFiles.slice(0,3).join(', '));
    if (sudoNopwd.length)     logMsg('[SECURITY] INFO: ' + sudoNopwd.length + ' passwordless sudo rule(s) configured');
    if (rootUsers.length > 1) logMsg('[SECURITY] CRITICAL: Multiple root-level accounts: ' + rootUsers.join(', '));
    if (suspFiles.length > 0) logMsg('[SECURITY] CRITICAL: ' + suspFiles.length + ' executable(s) in /tmp or /dev/shm');
    if (suspSuid.length > 0) logMsg('[SECURITY] WARNING: Unusual SUID binaries: ' + suspSuid.slice(0,3).join(', '));
    if (authFail > 50) logMsg('[SECURITY] CRITICAL: Brute force attack in progress — ' + authFail + ' auth failures');
    else if (authFail > 10) logMsg('[SECURITY] WARNING: Elevated auth failure count — ' + authFail);
    portLines.slice(0,6).forEach(p => logMsg('[SECURITY] OPEN PORT: ' + p.trim()));
    stepDone('security');
  } catch(e) { logMsg('[SECURITY] ERROR: ' + e.message); stepError('security'); }
  } // end shouldRun(security)

  // ═══════════════════════════════════════════════════════════════
  // STEP: Containers & Docker
  // ═══════════════════════════════════════════════════════════════
  if (shouldRun('docker')) {
  stepStart('docker');
  logMsg('[DOCKER] Inspecting container runtime, images, volumes and health...');
  try {
    const hasDocker = (await runCmd("command -v docker >/dev/null 2>&1 && echo yes || echo no")).includes('yes');
    if (!hasDocker) {
      logMsg('[DOCKER] Docker is not installed on this host — skipping container analysis');
      results.docker = { installed: false, containers: [], images: 0, volumes: 0, networks: 0, unhealthy: [], restartLoops: [] };
    } else {
      const [psAll, statsAll, imgCount, volCount, netCount, dockerInfo, restartIssues] = await runAll([
        "docker ps -a --format '{{.Names}}|{{.Status}}|{{.Image}}|{{.Ports}}' 2>/dev/null | head -40 || echo ''",
        "docker stats --no-stream --format '{{.Name}}|{{.CPUPerc}}|{{.MemUsage}}|{{.MemPerc}}' 2>/dev/null | head -40 || echo ''",
        "docker images -q 2>/dev/null | wc -l || echo 0",
        "docker volume ls -q 2>/dev/null | wc -l || echo 0",
        "docker network ls -q 2>/dev/null | wc -l || echo 0",
        "docker info --format '{{.ServerVersion}}|{{.ContainersRunning}}|{{.ContainersStopped}}|{{.Driver}}' 2>/dev/null || echo ''",
        "docker ps -a --filter 'status=restarting' --format '{{.Names}}' 2>/dev/null | head -10 || echo ''"
      ]);
      const containers = psAll.split('\n').filter(l => l.trim()).map(line => {
        const [name, status, image, ports] = line.split('|');
        return { name: name||'', status: status||'', image: image||'', ports: ports||'',
                 unhealthy: /unhealthy/i.test(status||''),
                 restarting: /restarting/i.test(status||''),
                 exited: /exited/i.test(status||'') };
      });
      const stats = {};
      statsAll.split('\n').filter(l => l.trim()).forEach(line => {
        const [n, cpu, mem, pct] = line.split('|');
        if (n) stats[n.trim()] = { cpu: cpu||'', mem: mem||'', memPct: pct||'' };
      });
      containers.forEach(c => { if (stats[c.name]) Object.assign(c, stats[c.name]); });
      const unhealthy = containers.filter(c => c.unhealthy);
      const restartLoops = restartIssues.split('\n').filter(l => l.trim());
      const exitedRecent = containers.filter(c => c.exited).slice(0,5);
      const [ver, running, stopped, driver] = (dockerInfo||'').split('|');
      results.docker = { installed: true, version: ver||'unknown', driver: driver||'',
        containers, images: parseInt(imgCount)||0, volumes: parseInt(volCount)||0, networks: parseInt(netCount)||0,
        running: parseInt(running)||0, stopped: parseInt(stopped)||0,
        unhealthy, restartLoops, exitedRecent };
      logMsg('[DOCKER] Engine ' + (ver||'?') + ' · running:' + (parseInt(running)||0) + ' stopped:' + (parseInt(stopped)||0) + ' images:' + (parseInt(imgCount)||0) + ' volumes:' + (parseInt(volCount)||0));
      if (unhealthy.length > 0)    logMsg('[DOCKER] WARNING: ' + unhealthy.length + ' unhealthy container(s): ' + unhealthy.map(c=>c.name).join(', '));
      if (restartLoops.length > 0) logMsg('[DOCKER] CRITICAL: ' + restartLoops.length + ' container(s) in restart loop: ' + restartLoops.join(', '));
      containers.slice(0,6).forEach(c => logMsg('[DOCKER] ' + c.name + ' [' + (c.status||'?') + ']' + (c.cpu ? ' cpu=' + c.cpu : '') + (c.memPct ? ' mem=' + c.memPct : '')));
    }
    stepDone('docker');
  } catch(e) { logMsg('[DOCKER] ERROR: ' + e.message); stepError('docker'); }
  } // end shouldRun(docker)

  // ═══════════════════════════════════════════════════════════════
  // STEP: Database Analysis  (PostgreSQL / MySQL / Redis / MongoDB)
  // ═══════════════════════════════════════════════════════════════
  if (shouldRun('database')) {
  stepStart('database');
  logMsg('[DB] Detecting installed database engines and probing health...');
  try {
    const dbResults = { postgres: null, mysql: null, redis: null, mongodb: null };

    // Detect installed engines — require the SERVER to be active (or listening port present),
    // not just the client binary (Ubuntu often ships mysql/redis-cli/mongosh as standalone packages).
    const [hasPg, hasMy, hasRedis, hasMongo] = await runAll([
      "(systemctl is-active postgresql 2>/dev/null | grep -q '^active$' || ss -tln 2>/dev/null | grep -q ':5432 ') && echo yes || echo no",
      "(systemctl is-active mysql 2>/dev/null | grep -q '^active$' || systemctl is-active mariadb 2>/dev/null | grep -q '^active$' || ss -tln 2>/dev/null | grep -qE ':3306 ') && echo yes || echo no",
      "(systemctl is-active redis 2>/dev/null | grep -q '^active$' || systemctl is-active redis-server 2>/dev/null | grep -q '^active$' || ss -tln 2>/dev/null | grep -q ':6379 ') && echo yes || echo no",
      "(systemctl is-active mongod 2>/dev/null | grep -q '^active$' || ss -tln 2>/dev/null | grep -q ':27017 ') && echo yes || echo no"
    ]);

    // PostgreSQL
    if (hasPg.includes('yes')) {
      const [pgVer, pgUp, pgConn, pgSlow, pgLocks, pgRepl, pgSize, pgCache, pgMaxConn] = await runAll([
        "sudo -u postgres psql -tAc 'SHOW server_version;' 2>/dev/null || psql -tAc 'SHOW server_version;' 2>/dev/null || echo ''",
        "systemctl is-active postgresql 2>/dev/null || echo 'unknown'",
        "sudo -u postgres psql -tAc 'SELECT count(*) FROM pg_stat_activity;' 2>/dev/null || echo 0",
        "sudo -u postgres psql -tAc \"SELECT count(*) FROM pg_stat_activity WHERE state='active' AND now()-query_start > interval '5 seconds';\" 2>/dev/null || echo 0",
        "sudo -u postgres psql -tAc 'SELECT count(*) FROM pg_locks WHERE granted=false;' 2>/dev/null || echo 0",
        "sudo -u postgres psql -tAc \"SELECT count(*) FROM pg_stat_replication;\" 2>/dev/null || echo 0",
        "sudo -u postgres psql -tAc \"SELECT pg_size_pretty(sum(pg_database_size(datname))) FROM pg_database;\" 2>/dev/null || echo 'n/a'",
        "sudo -u postgres psql -tAc \"SELECT round(100*sum(blks_hit)/NULLIF(sum(blks_hit)+sum(blks_read),0),1) FROM pg_stat_database;\" 2>/dev/null || echo ''",
        "sudo -u postgres psql -tAc 'SHOW max_connections;' 2>/dev/null || echo 0"
      ]);
      const pgCacheHit = parseFloat(pgCache)||0, pgMax = parseInt(pgMaxConn)||0, pgConnN = parseInt(pgConn)||0;
      const pgConnPct = pgMax > 0 ? Math.round(pgConnN/pgMax*100) : 0;
      dbResults.postgres = { installed:true, version: pgVer.trim()||'unknown', status: pgUp.trim(),
        connections: pgConnN, slowQueries: parseInt(pgSlow)||0, waitingLocks: parseInt(pgLocks)||0,
        replicas: parseInt(pgRepl)||0, totalSize: pgSize.trim(),
        cacheHitRatio: pgCacheHit, maxConnections: pgMax, connPct: pgConnPct };
      logMsg('[DB:PG] v' + (pgVer.trim()||'?') + ' [' + pgUp.trim() + '] connections=' + pgConnN + '/' + pgMax + ' (' + pgConnPct + '%) slow=' + (parseInt(pgSlow)||0) + ' lock-wait=' + (parseInt(pgLocks)||0) + ' cache-hit=' + pgCacheHit + '%');
      if (pgCacheHit > 0 && pgCacheHit < 90) logMsg('[DB:PG] WARNING: Low cache hit ratio ' + pgCacheHit + '% (<90% — consider tuning shared_buffers)');
      if (pgConnPct >= 80) logMsg('[DB:PG] WARNING: Connection pool ' + pgConnPct + '% of max (' + pgConnN + '/' + pgMax + ')');
      if ((parseInt(pgSlow)||0) > 5)  logMsg('[DB:PG] WARNING: ' + (parseInt(pgSlow)||0) + ' slow queries (>5s) in progress');
      if ((parseInt(pgLocks)||0) > 0) logMsg('[DB:PG] CRITICAL: ' + (parseInt(pgLocks)||0) + ' queries waiting on locks');
    }

    // MySQL / MariaDB
    if (hasMy.includes('yes')) {
      const [myVer, myUp, myConn, mySlow, myMaxConn, myUptime, myAborted, myBpReads, myBpReq, myMaxUsed] = await runAll([
        "mysql -e 'SELECT VERSION();' -sN 2>/dev/null || echo ''",
        "systemctl is-active mysql 2>/dev/null | head -1 | grep -E '^(active|inactive|failed|activating|unknown)$' || systemctl is-active mariadb 2>/dev/null | head -1 | grep -E '^(active|inactive|failed|activating|unknown)$' || echo 'unknown'",
        "mysql -e \"SHOW GLOBAL STATUS LIKE 'Threads_connected';\" -sN 2>/dev/null | awk '{print $2}' || echo 0",
        "mysql -e \"SHOW GLOBAL STATUS LIKE 'Slow_queries';\" -sN 2>/dev/null | awk '{print $2}' || echo 0",
        "mysql -e \"SHOW VARIABLES LIKE 'max_connections';\" -sN 2>/dev/null | awk '{print $2}' || echo 0",
        "mysql -e \"SHOW GLOBAL STATUS LIKE 'Uptime';\" -sN 2>/dev/null | awk '{print $2}' || echo 0",
        "mysql -e \"SHOW GLOBAL STATUS LIKE 'Aborted_connects';\" -sN 2>/dev/null | awk '{print $2}' || echo 0",
        "mysql -e \"SHOW GLOBAL STATUS LIKE 'Innodb_buffer_pool_reads';\" -sN 2>/dev/null | awk '{print $2}' || echo 0",
        "mysql -e \"SHOW GLOBAL STATUS LIKE 'Innodb_buffer_pool_read_requests';\" -sN 2>/dev/null | awk '{print $2}' || echo 1",
        "mysql -e \"SHOW GLOBAL STATUS LIKE 'Max_used_connections';\" -sN 2>/dev/null | awk '{print $2}' || echo 0"
      ]);
      const myConnN=parseInt(myConn)||0, myMax=parseInt(myMaxConn)||0;
      const myConnPct = myMax>0 ? Math.round(myConnN/myMax*100) : 0;
      const reads=parseInt(myBpReads)||0, reqs=parseInt(myBpReq)||1;
      const bpHit = reqs>0 ? Math.round((1-reads/reqs)*1000)/10 : 100; // InnoDB buffer-pool hit %
      const upH = Math.round((parseInt(myUptime)||0)/3600);
      dbResults.mysql = { installed:true, version: myVer.trim()||'unknown', status: myUp.trim(),
        connections: myConnN, slowQueries: parseInt(mySlow)||0, maxConnections: myMax, connPct: myConnPct,
        uptimeHours: upH, abortedConnects: parseInt(myAborted)||0, bufferPoolHit: bpHit, maxUsedConnections: parseInt(myMaxUsed)||0 };
      logMsg('[DB:MY] v' + (myVer.trim()||'?') + ' [' + myUp.trim() + '] conn=' + myConnN + '/' + myMax + ' (' + myConnPct + '%) slow=' + (parseInt(mySlow)||0) + ' bufpool-hit=' + bpHit + '% uptime=' + upH + 'h');
      if (bpHit > 0 && bpHit < 95) logMsg('[DB:MY] WARNING: Low InnoDB buffer-pool hit ratio ' + bpHit + '% (<95%)');
      if (myConnPct >= 80) logMsg('[DB:MY] WARNING: Connections ' + myConnPct + '% of max');
      if ((parseInt(myAborted)||0) > 100) logMsg('[DB:MY] WARNING: ' + myAborted + ' aborted connections (auth/timeout issues)');
    }

    // Redis
    if (hasRedis.includes('yes')) {
      const [rdVer, rdUp, rdMem, rdClients, rdKeys, rdRdb, rdHits, rdMiss, rdEvict, rdFrag, rdUptime] = await runAll([
        "redis-cli INFO server 2>/dev/null | grep redis_version | cut -d: -f2 | tr -d '\\r' || echo ''",
        "(systemctl is-active redis-server 2>/dev/null; systemctl is-active redis 2>/dev/null) | grep -E '^(active|inactive|failed|activating)$' | head -1 || echo 'unknown'",
        "redis-cli INFO memory 2>/dev/null | grep -w used_memory_human | cut -d: -f2 | tr -d '\\r' || echo ''",
        "redis-cli INFO clients 2>/dev/null | grep connected_clients | cut -d: -f2 | tr -d '\\r' || echo 0",
        "redis-cli DBSIZE 2>/dev/null || echo 0",
        "redis-cli INFO persistence 2>/dev/null | grep rdb_last_bgsave_status | cut -d: -f2 | tr -d '\\r' || echo ''",
        "redis-cli INFO stats 2>/dev/null | grep -w keyspace_hits | cut -d: -f2 | tr -d '\\r' || echo 0",
        "redis-cli INFO stats 2>/dev/null | grep -w keyspace_misses | cut -d: -f2 | tr -d '\\r' || echo 0",
        "redis-cli INFO stats 2>/dev/null | grep -w evicted_keys | cut -d: -f2 | tr -d '\\r' || echo 0",
        "redis-cli INFO memory 2>/dev/null | grep mem_fragmentation_ratio | cut -d: -f2 | tr -d '\\r' || echo 0",
        "redis-cli INFO server 2>/dev/null | grep uptime_in_seconds | cut -d: -f2 | tr -d '\\r' || echo 0"
      ]);
      const hits=parseInt(rdHits)||0, miss=parseInt(rdMiss)||0;
      const hitRate = (hits+miss)>0 ? Math.round(hits/(hits+miss)*1000)/10 : 100;
      const frag = parseFloat(rdFrag)||0, evicted=parseInt(rdEvict)||0;
      dbResults.redis = { installed:true, version: rdVer.trim()||'unknown', status: rdUp.trim(),
        memory: rdMem.trim(), clients: parseInt(rdClients)||0, keys: parseInt(rdKeys)||0, lastBgSave: rdRdb.trim(),
        hitRate: hitRate, evictedKeys: evicted, fragmentation: frag, uptimeHours: Math.round((parseInt(rdUptime)||0)/3600) };
      logMsg('[DB:RD] v' + (rdVer.trim()||'?') + ' [' + rdUp.trim() + '] mem=' + rdMem.trim() + ' clients=' + (parseInt(rdClients)||0) + ' keys=' + (parseInt(rdKeys)||0) + ' hit-rate=' + hitRate + '% evicted=' + evicted + ' frag=' + frag);
      if (rdRdb.trim() && rdRdb.trim() !== 'ok') logMsg('[DB:RD] WARNING: Last BGSAVE status: ' + rdRdb.trim());
      if (hitRate > 0 && hitRate < 80 && (hits+miss) > 1000) logMsg('[DB:RD] WARNING: Low cache hit rate ' + hitRate + '%');
      if (evicted > 0) logMsg('[DB:RD] WARNING: ' + evicted + ' keys evicted (memory pressure — check maxmemory policy)');
      if (frag > 1.5) logMsg('[DB:RD] WARNING: High memory fragmentation ratio ' + frag);
    }

    // MongoDB
    if (hasMongo.includes('yes')) {
      const msh = (js) => "mongosh --quiet --eval '" + js + "' 2>/dev/null || mongo --quiet --eval '" + js + "' 2>/dev/null || echo ''";
      const [mgVer, mgUp, mgConn, mgConnAvail, mgUptime, mgInserts, mgQueries, mgRepl] = await runAll([
        msh("db.version()"),
        "systemctl is-active mongod 2>/dev/null || echo 'unknown'",
        msh("db.serverStatus().connections.current"),
        msh("db.serverStatus().connections.available"),
        msh("db.serverStatus().uptime"),
        msh("db.serverStatus().opcounters.insert"),
        msh("db.serverStatus().opcounters.query"),
        msh("try{rs.status().myState}catch(e){-1}")
      ]);
      const connN=parseInt(mgConn)||0, avail=parseInt(mgConnAvail)||0;
      const total = connN+avail; const connPct = total>0 ? Math.round(connN/total*100) : 0;
      const rsState = parseInt(mgRepl); // 1=PRIMARY 2=SECONDARY -1=standalone
      dbResults.mongodb = { installed:true, version: mgVer.trim()||'unknown', status: mgUp.trim(),
        connections: connN, connAvailable: avail, connPct: connPct, uptimeHours: Math.round((parseInt(mgUptime)||0)/3600),
        inserts: parseInt(mgInserts)||0, queries: parseInt(mgQueries)||0,
        replState: isNaN(rsState)?null:rsState };
      const rsTxt = rsState===1?'PRIMARY':rsState===2?'SECONDARY':rsState>=0?'rs:'+rsState:'standalone';
      logMsg('[DB:MG] v' + (mgVer.trim()||'?') + ' [' + mgUp.trim() + '] conn=' + connN + '/' + total + ' (' + connPct + '%) ' + rsTxt + ' inserts=' + (parseInt(mgInserts)||0) + ' queries=' + (parseInt(mgQueries)||0));
      if (connPct >= 80) logMsg('[DB:MG] WARNING: Connections ' + connPct + '% of available');
    }

    const installed = Object.entries(dbResults).filter(([_,v]) => v && v.installed).map(([k]) => k);
    if (installed.length === 0) logMsg('[DB] No database engines detected on this host');
    else logMsg('[DB] Detected engines: ' + installed.join(', '));
    results.database = dbResults;
    stepDone('database');
  } catch(e) { logMsg('[DB] ERROR: ' + e.message); stepError('database'); }
  } // end shouldRun(database)

  // ═══════════════════════════════════════════════════════════════
  // STEP: AI Correlation Engine
  // ═══════════════════════════════════════════════════════════════
  stepStart('correlation');
  logMsg('[AI] Running multi-signal correlation analysis...');
  try {
    const sys7 = results.system||{}, ker7 = results.kernel||{}, fs7 = results.filesystem||{};
    const svc7 = results.services||{}, net7 = results.network||{}, sec7 = results.security||{}, lg7 = results.logs||{};
    const correlations = [];

    // Memory pressure cascade
    if ((ker7.oomEvents||[]).length > 0 && sys7.memPct > 70)
      correlations.push('Memory pressure cascade: ' + sys7.memPct + '% memory usage triggering OOM kills (' + ker7.oomEvents.length + ' events)');
    if (sys7.swapUsed > 0 && sys7.swapTotal > 0 && sys7.swapUsed / sys7.swapTotal > 0.5 && sys7.memPct > 80)
      correlations.push('Swap thrashing: ' + Math.round(sys7.swapUsed/sys7.swapTotal*100) + '% swap used with high memory — expect severe performance degradation');

    // Brute force + load spike
    if ((lg7.authFailures||0) > 20 && sys7.load1 > (sys7.cpuCores||1))
      correlations.push('Security under load: ' + lg7.authFailures + ' auth failures coinciding with load avg ' + sys7.load1 + ' — possible DDoS or targeted attack');

    // Disk full causing service failures
    if ((svc7.failedCount||0) > 0 && (fs7.critDisks||[]).length > 0)
      correlations.push('Disk exhaustion → service failure: ' + (fs7.critDisks||[]).map(d=>d.mount+'('+d.pct+'%)').join(', ') + ' causing ' + svc7.failedCount + ' unit failure(s)');

    // Kernel instability + app errors
    if (ker7.errCount > 3 && (svc7.pm2Errors||0) > 0)
      correlations.push('Kernel instability (' + ker7.errCount + ' errors) correlates with ' + svc7.pm2Errors + ' PM2 process failure(s)');

    // Network degradation + service health
    if (!net7.isOnline && (svc7.failedCount||0) > 0)
      correlations.push('Network offline causing cascading service failures — ' + svc7.failedCount + ' unit(s) failed');

    // Zombie processes
    if ((sys7.zombieCount||0) > 5)
      correlations.push('Zombie process accumulation (' + sys7.zombieCount + ') indicates parent process not reaping children — possible application crash loop');

    // RAID degradation
    if ((fs7.mdStat||'').includes('_'))
      correlations.push('RAID array degraded — reduced redundancy, risk of data loss on disk failure');

    // Restart loop + logs
    if ((svc7.restartCount||0) > 10)
      correlations.push('Service restart storm: ' + svc7.restartCount + ' restarts in 2h — check for crash loop with: journalctl -xe');

    // SSH brute force
    if ((lg7.sshFailures||0) > 100)
      correlations.push('Active SSH brute force attack: ' + lg7.sshFailures + ' failed password attempts — consider fail2ban or firewall rule');

    // FD exhaustion
    if (sys7.maxFd > 0 && sys7.openFd / sys7.maxFd > 0.8)
      correlations.push('File descriptor exhaustion: ' + sys7.openFd + '/' + sys7.maxFd + ' (' + Math.round(sys7.openFd/sys7.maxFd*100) + '%) — services will fail to open new files');

    // Docker correlations
    const dk7 = results.docker || {};
    if ((dk7.unhealthy||[]).length > 0 && (svc7.failedCount||0) > 0)
      correlations.push('Container health failure correlating with systemd unit failures — possible shared dependency outage');
    if ((dk7.restartLoops||[]).length > 0 && (ker7.oomEvents||[]).length > 0)
      correlations.push('Container restart loops coinciding with OOM kills — containers being terminated by kernel under memory pressure');

    // Database correlations
    const db7 = results.database || {};
    if (db7.postgres && (db7.postgres.waitingLocks||0) > 0 && sys7.load1 > (sys7.cpuCores||1))
      correlations.push('PostgreSQL lock contention (' + db7.postgres.waitingLocks + ' waiting) coinciding with high CPU load — query plan or long transactions likely');
    if (db7.postgres && (db7.postgres.slowQueries||0) > 10 && sys7.memPct > 80)
      correlations.push('PostgreSQL slow queries (' + db7.postgres.slowQueries + ') under memory pressure — buffer/cache thrashing likely');
    if (db7.redis && db7.redis.lastBgSave && db7.redis.lastBgSave !== 'ok' && (fs7.critDisks||[]).length > 0)
      correlations.push('Redis BGSAVE failing while filesystem critical — likely no disk space for snapshot');

    // Security posture correlations (new deep signals)
    if ((sec7.sshWeak||[]).length > 0 && !sec7.firewallActive && (sec7.sshFailures||0) > 0)
      correlations.push('Exposed attack surface: weak SSH config (' + sec7.sshWeak.join(', ') + ') + no firewall + ' + sec7.sshFailures + ' failed logins — host is a soft target for credential attacks');
    if (/^(yes|prohibit-password|without-password)$/.test(sec7.sshRootLogin||'') && (lg7.sshFailures||0) > 20)
      correlations.push('Direct root SSH permitted while under brute-force (' + lg7.sshFailures + ' attempts) — disable PermitRootLogin immediately');
    if (!sec7.firewallActive && (sec7.openPorts||[]).filter(p=>/0\.0\.0\.0|\[::\]|\*:/.test(p)).length > 2)
      correlations.push('No host firewall with multiple public-facing ports — every listening service is internet-reachable');
    // Filesystem corruption cascade
    if ((fs7.fsErrors||[]).length > 0)
      correlations.push('Filesystem errors in kernel log (' + fs7.fsErrors.length + ') — risk of data corruption; verify with fsck and check disk SMART status');
    // Hardware fault cascade
    if ((ker7.mceEvents||[]).length > 0)
      correlations.push('Hardware machine-check errors detected (' + ker7.mceEvents.length + ') — failing RAM/CPU; correlate with any OOM/oops events and schedule hardware diagnostics');
    // Network resolution cascade
    if (net7.dnsOk === false && (svc7.failedCount||0) > 0)
      correlations.push('DNS resolution failing alongside ' + svc7.failedCount + ' service failure(s) — name-resolution outage likely cascading to dependent services');
    if (net7.gatewayReachable === false)
      correlations.push('Default gateway unreachable — host is network-isolated; external connectivity and updates will fail');

    if (correlations.length === 0)
      correlations.push('No cascading failure patterns detected — subsystems are operating independently');

    results.correlations = correlations;
    logMsg('[AI] Correlation analysis complete — ' + correlations.length + ' pattern(s) identified');
    correlations.forEach(c => logMsg('[AI] PATTERN: ' + c));
  } catch(e) { logMsg('[AI] Correlation error: ' + e.message); results.correlations = []; }
  stepDone('correlation');

  // STEP: Root Cause Inference
  let overallScore = 0, health = 'UNKNOWN', critIssues = [], warnIssues = [], infoIssues = [], recommendations = [], corrs = [];
  let cpuScore = 0, memScore = 0, diskScore = 0, netScore = 0, svcScore = 0, secScore = 0, logScore = 0, kernScore = 0;
  let rootCauseSummary8 = 'No analysis available', rootCauseConf8 = 50;
  try {
  stepStart('rootcause');
  logMsg('[STEP] Inferring root causes from collected data...');
  const sys = results.system || {}, ker = results.kernel || {}, fs = results.filesystem || {};
  const svc = results.services || {}, net = results.network || {}, sec = results.security || {}, lg = results.logs || {};
  cpuScore  = Math.max(0, Math.round(100 - Math.min(100, (sys.load1||0) / Math.max(1, sys.cpuCores||1) * 100)));
  memScore  = Math.max(0, 100 - (sys.memPct||0));
  diskScore = Math.max(0, 100 - (fs.critDisks||[]).length * 30 - (fs.warnDisks||[]).length * 10);
  netScore  = Math.max(0, 100 - (net.pingLoss||0) * 3);
  svcScore  = Math.max(0, 100 - (svc.failedCount||0) * 15 - (svc.pm2Errors||0) * 8);
  secScore  = Math.max(0, 100 - Math.min(60, (sec.authFailures||0) * 1.5 + (sec.sshFailures||0) * 2)
    - (sec.sshWeak||[]).length * 8 - (sec.firewallActive===false ? 12 : 0)
    - Math.min(15, (sec.worldWritable||[]).length * 3) - (/^(yes|prohibit-password|without-password)$/.test(sec.sshRootLogin||'') ? 8 : 0));
  secScore = Math.max(0, secScore);
  logScore  = Math.max(0, 100 - Math.min(50, (lg.errCount||0) * 1.5));
  kernScore = Math.max(0, 100 - (ker.errCount||0) * 5 - (ker.oopsCount||0) * 20);
  overallScore = Math.round((cpuScore + memScore + diskScore + netScore + svcScore + secScore + logScore + kernScore) / 8);
  health = overallScore >= 80 ? 'HEALTHY' : overallScore >= 60 ? 'DEGRADED' : 'CRITICAL';
  const issues = [];
  if (ker.errCount > 5)        issues.push({ severity:'critical', area:'Kernel',     msg: ker.errCount + ' kernel errors in ring buffer' });
  if (ker.oopsCount > 0)       issues.push({ severity:'critical', area:'Kernel',     msg: 'Kernel oops/panic events: ' + ker.oopsCount });
  if ((fs.critDisks||[]).length>0) issues.push({ severity:'critical', area:'Filesystem', msg: 'Disks above 90%: ' + fs.critDisks.map(d=>d.mount+'('+d.pct+'%)').join(', ') });
  if (svc.failedCount > 0)     issues.push({ severity:'critical', area:'Services',   msg: svc.failedCount + ' systemd services failed' });
  if (sys.memPct > 90)         issues.push({ severity:'critical', area:'Memory',     msg: 'Memory critical: ' + sys.memPct + '%' });
  if (net.pingLoss > 20)       issues.push({ severity:'critical', area:'Network',    msg: 'High packet loss: ' + net.pingLoss + '%' });
  if (sec.authFailures > 50)   issues.push({ severity:'critical', area:'Security',   msg: 'Brute force: ' + sec.authFailures + ' auth failures' });
  if ((fs.warnDisks||[]).length>0) issues.push({ severity:'warning',  area:'Filesystem', msg: 'Disks above 75%: ' + fs.warnDisks.map(d=>d.mount+'('+d.pct+'%)').join(', ') });
  if (sys.load1 > (sys.cpuCores||1) * 2) issues.push({ severity:'warning', area:'CPU', msg: 'High load: ' + sys.load1 + ' (cores:' + (sys.cpuCores||1) + ')' });
  if (sys.memPct > 80)         issues.push({ severity:'warning',  area:'Memory',     msg: 'High memory: ' + sys.memPct + '%' });
  if (sec.authFailures > 10)   issues.push({ severity:'warning',  area:'Security',   msg: 'Elevated auth failures: ' + sec.authFailures });
  if (lg.errCount > 20)        issues.push({ severity:'warning',  area:'Logs',       msg: 'High error count: ' + lg.errCount });
  if ((fs.inodeCrit||[]).length>0) issues.push({ severity:'critical', area:'Filesystem', msg: 'Inode exhaustion: ' + fs.inodeCrit.join(', ') });
  if (sys.zombieCount > 10)    issues.push({ severity:'warning',  area:'Processes',  msg: 'Zombie processes: ' + sys.zombieCount });
  if (sys.swapUsed > 0 && sys.swapTotal > 0 && (sys.swapUsed/sys.swapTotal) > 0.8)
    issues.push({ severity:'warning', area:'Memory', msg: 'Swap nearly full: ' + Math.round(sys.swapUsed/sys.swapTotal*100) + '%' });
  {
    const smartStr = Array.isArray(fs.smartSummary) ? fs.smartSummary.join(' ') : (fs.smartSummary||'');
    // Only flag if smartctl reports actual disk health failure (not access errors)
    if (/\b(FAILED|FAILING_NOW|PRE-FAIL)\b/.test(smartStr) && !/unreadable|permission|denied/i.test(smartStr))
      issues.push({ severity:'critical', area:'Storage', msg: 'SMART disk health failure detected' });
  }
  if (svc.pm2Errors > 5)       issues.push({ severity:'warning',  area:'Services',   msg: 'PM2 process errors: ' + svc.pm2Errors });
  if ((sec.suspiciousFiles||[]).length>0) issues.push({ severity:'critical', area:'Security', msg: 'Suspicious executables in /tmp or /dev/shm: ' + sec.suspiciousFiles.length });
  if ((sec.rootUsers||[]).length > 1)
    issues.push({ severity:'critical', area:'Security', msg: 'Extra UID-0 accounts detected: ' + sec.rootUsers.join(', ') });
  // New deep security findings
  if (/^(yes|prohibit-password|without-password)$/.test(sec.sshRootLogin||''))
    issues.push({ severity:'warning', area:'Security', msg: 'SSH permits root login (PermitRootLogin=' + sec.sshRootLogin + ')', evidence:'sshd -T | grep permitrootlogin' });
  if (sec.sshPassAuth === 'yes')
    issues.push({ severity:'warning', area:'Security', msg: 'SSH password authentication enabled (brute-forceable)', evidence:'sshd -T | grep passwordauthentication' });
  if (sec.sshEmptyPw === 'yes')
    issues.push({ severity:'critical', area:'Security', msg: 'SSH permits empty passwords', evidence:'sshd -T | grep permitemptypasswords' });
  if (sec.firewallActive === false)
    issues.push({ severity:'warning', area:'Security', msg: 'No active host firewall (UFW/iptables/nftables)', evidence:'ufw status; iptables -L' });
  if ((sec.worldWritable||[]).length > 0)
    issues.push({ severity:'warning', area:'Security', msg: (sec.worldWritable.length) + ' world-writable file(s) in system paths', evidence:'find / -perm -0002 -type f' });
  if (sec.harden && (sec.harden.rkhunterWarnings||0) > 0)
    issues.push({ severity:'warning', area:'Security', msg: 'rkhunter reported ' + sec.harden.rkhunterWarnings + ' warning(s) in last scan', evidence:'/var/log/rkhunter.log' });
  // Kernel hardware faults
  if ((ker.mceEvents||[]).length > 0)
    issues.push({ severity:'critical', area:'Kernel', msg: (ker.mceEvents.length) + ' hardware/machine-check error(s) — failing RAM/CPU', evidence:"dmesg | grep -i 'mce\\|machine check'" });
  if ((ker.hungTasks||[]).length > 0)
    issues.push({ severity:'warning', area:'Kernel', msg: (ker.hungTasks.length) + ' hung-task event(s) (blocked > 120s)', evidence:'dmesg | grep hung_task' });
  // Filesystem corruption
  if ((fs.fsErrors||[]).length > 0)
    issues.push({ severity:'critical', area:'Filesystem', msg: (fs.fsErrors.length) + ' filesystem error(s) in kernel log — possible corruption', evidence:"dmesg | grep -i 'ext4-fs error\\|i/o error\\|read-only'" });
  if (fs.zfsHealthy === false)
    issues.push({ severity:'critical', area:'Filesystem', msg: 'ZFS pool not healthy', evidence:'zpool status -x' });
  // Network health
  if (net.dnsOk === false)
    issues.push({ severity:'critical', area:'Network', msg: 'DNS resolution failing', evidence:'getent hosts google.com' });
  if (net.gatewayReachable === false)
    issues.push({ severity:'critical', area:'Network', msg: 'Default gateway ' + (net.gateway||'') + ' unreachable', evidence:'ping <gateway>' });
  (net.tlsCerts||[]).forEach(function(tc){
    if (tc.days !== null && tc.days < 21)
      issues.push({ severity: tc.days < 7 ? 'critical' : 'warning', area:'Network', msg: 'TLS certificate (:' + tc.port + ') expires in ' + tc.days + ' day(s)', evidence:'openssl s_client -connect 127.0.0.1:' + tc.port });
  });
  if ((net.ifErrors||[]).some(l => /rx_err=[1-9]|tx_err=[1-9]/.test(l)))
    issues.push({ severity:'warning', area:'Network', msg: 'Interface hardware errors: ' + (net.ifErrors||[]).filter(l=>/rx_err=[1-9]|tx_err=[1-9]/.test(l)).join('; '), evidence:'/sys/class/net/*/statistics' });
  // Log crash signals
  if ((lg.segfaults||0) > 0)
    issues.push({ severity:'warning', area:'Logs', msg: (lg.segfaults) + ' segfault(s) in last 24h', evidence:'journalctl | grep segfault' });
  // Docker findings
  const dk = results.docker || {};
  if (dk.installed) {
    if ((dk.unhealthy||[]).length > 0)    issues.push({ severity:'critical', area:'Docker', msg: 'Unhealthy containers: ' + dk.unhealthy.map(c=>c.name).join(', '), evidence:'docker ps --filter health=unhealthy' });
    if ((dk.restartLoops||[]).length > 0) issues.push({ severity:'critical', area:'Docker', msg: 'Container restart loops: ' + dk.restartLoops.join(', '), evidence:'docker ps --filter status=restarting' });
    if ((dk.exitedRecent||[]).length > 3) issues.push({ severity:'warning',  area:'Docker', msg: 'Multiple exited containers (' + dk.exitedRecent.length + ')', evidence:'docker ps -a' });
  }
  // Database findings
  const db = results.database || {};
  if (db.postgres) {
    if ((db.postgres.waitingLocks||0) > 0) issues.push({ severity:'critical', area:'Database', msg: 'PostgreSQL: ' + db.postgres.waitingLocks + ' query/queries waiting on locks', evidence:'pg_locks WHERE granted=false' });
    if ((db.postgres.slowQueries||0) > 5)  issues.push({ severity:'warning',  area:'Database', msg: 'PostgreSQL: ' + db.postgres.slowQueries + ' slow queries (>5s)', evidence:'pg_stat_activity' });
    if (db.postgres.status && !/active|running/i.test(db.postgres.status)) issues.push({ severity:'critical', area:'Database', msg: 'PostgreSQL service status: ' + db.postgres.status, evidence:'systemctl is-active postgresql' });
    if (db.postgres.cacheHitRatio > 0 && db.postgres.cacheHitRatio < 90) issues.push({ severity:'warning', area:'Database', msg: 'PostgreSQL cache hit ratio low: ' + db.postgres.cacheHitRatio + '%', evidence:'pg_stat_database blks_hit/blks_read' });
    if ((db.postgres.connPct||0) >= 80) issues.push({ severity:'warning', area:'Database', msg: 'PostgreSQL connections at ' + db.postgres.connPct + '% of max', evidence:'pg_stat_activity vs max_connections' });
  }
  if (db.mysql) {
    if (db.mysql.status && !/active|running/i.test(db.mysql.status)) issues.push({ severity:'critical', area:'Database', msg: 'MySQL/MariaDB service status: ' + db.mysql.status, evidence:'systemctl is-active mysql' });
  }
  if (db.redis) {
    if (db.redis.lastBgSave && db.redis.lastBgSave !== 'ok' && db.redis.lastBgSave !== '') issues.push({ severity:'warning', area:'Database', msg: 'Redis BGSAVE status: ' + db.redis.lastBgSave, evidence:'redis-cli INFO persistence' });
    if (db.redis.status && !/active|running/i.test(db.redis.status)) issues.push({ severity:'critical', area:'Database', msg: 'Redis service status: ' + db.redis.status, evidence:'systemctl is-active redis' });
  }
  if (db.mongodb) {
    if (db.mongodb.status && !/active|running/i.test(db.mongodb.status)) issues.push({ severity:'critical', area:'Database', msg: 'MongoDB service status: ' + db.mongodb.status, evidence:'systemctl is-active mongod' });
  }
  // Attach evidence sources for non-Docker/DB findings
  issues.forEach(i => {
    if (i.evidence) return;
    const map = { Kernel:'dmesg / /var/log/kern.log', Filesystem:'df -h, smartctl', Services:'systemctl list-units, pm2 list',
      Memory:'/proc/meminfo, free -h', CPU:'/proc/loadavg, top', Network:'ping, ss -tlnp',
      Security:'/var/log/auth.log, journalctl _SYSTEMD_UNIT=ssh', Logs:'journalctl -p err, /var/log/syslog',
      Storage:'smartctl -H', Processes:'ps aux STAT' };
    i.evidence = map[i.area] || 'system inspection';
  });
  critIssues = issues.filter(i => i.severity === 'critical');
  warnIssues = issues.filter(i => i.severity === 'warning');
  infoIssues = issues.length === 0 ? [{ area:'System', msg:'No significant issues — system operating normally' }] : [];
  corrs = results.correlations || [];
  rootCauseSummary8 = critIssues.length > 0
    ? 'Primary: ' + critIssues[0].msg + (critIssues.length > 1 ? '. Plus ' + (critIssues.length-1) + ' more critical.' : '') + (corrs.length ? ' Pattern: ' + corrs[0] : '')
    : warnIssues.length > 0 ? 'No critical failures. ' + warnIssues[0].msg + (corrs.length ? '. Correlation: ' + corrs[0] : '')
    : 'System appears healthy. No significant issues detected across all subsystems.';
  rootCauseConf8 = critIssues.length > 0 ? 85 : warnIssues.length > 0 ? 78 : 92;
  if (critIssues.some(i => i.area==='Filesystem')) recommendations.push({ priority:'CRITICAL', action:'Free disk space', cmd:'du -sh /* 2>/dev/null | sort -rh | head -20' });
  if (critIssues.some(i => i.area==='Services'))   recommendations.push({ priority:'CRITICAL', action:'Restart failed services', cmd:'systemctl reset-failed' });
  if (critIssues.some(i => i.area==='Memory'))     recommendations.push({ priority:'CRITICAL', action:'Investigate memory consumers', cmd:'ps aux --sort=-%mem | head -20' });
  if (critIssues.some(i => i.area==='Security' && /brute force|auth failures/i.test(i.msg))) recommendations.push({ priority:'HIGH', action:'Block brute force IPs', cmd:"grep 'Failed' /var/log/auth.log | awk '{print $11}' | sort | uniq -c | sort -rn | head" });
  if (warnIssues.some(i => i.area==='Filesystem')) recommendations.push({ priority:'MEDIUM',   action:'Monitor disk usage', cmd:'find / -type f -size +100M 2>/dev/null | head -20' });
  if (warnIssues.some(i => i.area==='CPU'))        recommendations.push({ priority:'MEDIUM',   action:'Identify CPU consumers', cmd:'ps aux --sort=-%cpu | head -20' });
  if (critIssues.some(i => i.area==='Storage'))    recommendations.push({ priority:'CRITICAL', action:'Check SMART disk health', cmd:'smartctl -a /dev/sda 2>/dev/null || smartctl -a /dev/nvme0 2>/dev/null' });
  if (critIssues.some(i => i.area==='Security' && i.msg.includes('Suspicious'))) recommendations.push({ priority:'CRITICAL', action:'Investigate suspicious files', cmd:'ls -la /tmp /dev/shm && file /tmp/* /dev/shm/* 2>/dev/null' });
  if (issues.some(i => i.area==='Filesystem' && i.msg.includes('Inode'))) recommendations.push({ priority:'HIGH', action:'Find inode consumers', cmd:'find / -xdev -printf "%h\n" 2>/dev/null | sort | uniq -c | sort -rn | head -20' });
  if (critIssues.some(i => i.area==='Docker' && /restart loops/i.test(i.msg))) recommendations.push({ priority:'CRITICAL', action:'Inspect crashing containers', cmd:'docker ps --filter status=restarting && docker logs --tail 50 <container>' });
  if (critIssues.some(i => i.area==='Docker' && /Unhealthy/i.test(i.msg)))     recommendations.push({ priority:'HIGH',     action:'Check container healthchecks', cmd:'docker inspect --format "{{.State.Health.Log}}" <container>' });
  if (critIssues.some(i => i.area==='Database' && /lock/i.test(i.msg)))        recommendations.push({ priority:'CRITICAL', action:'Identify blocking transactions', cmd:"sudo -u postgres psql -c \"SELECT pid,now()-query_start AS age,state,query FROM pg_stat_activity WHERE state='active' ORDER BY age DESC LIMIT 10;\"" });
  if (warnIssues.some(i => i.area==='Database' && /slow/i.test(i.msg)))        recommendations.push({ priority:'HIGH',     action:'Review slow queries', cmd:"sudo -u postgres psql -c \"SELECT query,calls,mean_exec_time FROM pg_stat_statements ORDER BY mean_exec_time DESC LIMIT 10;\"" });
  if (critIssues.some(i => i.area==='Database' && /service status/i.test(i.msg))) recommendations.push({ priority:'CRITICAL', action:'Restart database service', cmd:'systemctl restart postgresql || systemctl restart mysql || systemctl restart redis-server' });
  if (warnIssues.some(i => i.area==='Security' && /root login/i.test(i.msg)))   recommendations.push({ priority:'HIGH', action:'Disable SSH root login', cmd:"sed -i 's/^#\\?PermitRootLogin.*/PermitRootLogin no/' /etc/ssh/sshd_config && systemctl reload ssh" });
  if (warnIssues.some(i => i.area==='Security' && /password authentication/i.test(i.msg))) recommendations.push({ priority:'MEDIUM', action:'Enforce key-based SSH auth', cmd:"sed -i 's/^#\\?PasswordAuthentication.*/PasswordAuthentication no/' /etc/ssh/sshd_config && systemctl reload ssh" });
  if (warnIssues.some(i => i.area==='Security' && /firewall/i.test(i.msg)))     recommendations.push({ priority:'HIGH', action:'Enable host firewall', cmd:'ufw allow 22,80,443/tcp && ufw enable' });
  if (warnIssues.some(i => i.area==='Security' && /world-writable/i.test(i.msg))) recommendations.push({ priority:'MEDIUM', action:'Remove world-writable bit', cmd:"find /etc /usr/local /opt -xdev -type f -perm -0002 -exec chmod o-w {} +" });
  if (critIssues.some(i => i.area==='Kernel' && /machine-check|hardware/i.test(i.msg))) recommendations.push({ priority:'CRITICAL', action:'Run hardware diagnostics (RAM/CPU)', cmd:'memtester / mcelog --client; dmesg | grep -i mce' });
  if (critIssues.some(i => i.area==='Filesystem' && /corruption|error/i.test(i.msg))) recommendations.push({ priority:'CRITICAL', action:'Check & repair filesystem', cmd:'umount <fs> && fsck -y <device>  # or schedule fsck on next boot' });
  if (critIssues.some(i => i.area==='Network' && /DNS/i.test(i.msg)))           recommendations.push({ priority:'CRITICAL', action:'Fix DNS resolution', cmd:'systemctl restart systemd-resolved; cat /etc/resolv.conf' });
  if (issues.some(i => i.area==='Network' && /TLS certificate/i.test(i.msg)))   recommendations.push({ priority:'HIGH', action:'Renew TLS certificate', cmd:'certbot renew --force-renewal || openssl ... ; systemctl reload nginx' });
  if (warnIssues.some(i => i.area==='Database' && /cache hit/i.test(i.msg)))    recommendations.push({ priority:'MEDIUM', action:'Tune PostgreSQL shared_buffers', cmd:"sudo -u postgres psql -c \"ALTER SYSTEM SET shared_buffers='256MB';\" && systemctl restart postgresql" });
  if (recommendations.length === 0)                recommendations.push({ priority:'LOW',     action:'Continue monitoring', cmd:'journalctl -f' });
  results.analysis = { overallScore, health, cpuScore, memScore, diskScore, netScore, svcScore, secScore, logScore, kernScore,
    rootCause: { summary: rootCauseSummary8, confidence: rootCauseConf8 }, issues, critIssues, warnIssues, infoIssues, recommendations };
  logMsg('[STEP 8] Score: ' + overallScore + '/100 (' + health + ')  Critical: ' + critIssues.length + '  Warnings: ' + warnIssues.length);
  if (corrs.length > 0) logMsg('[STEP 8] Correlation patterns identified: ' + corrs.length);
  stepDone('rootcause');
  } catch(e8) {
    logMsg('[STEP 8] ERROR: ' + e8.message);
    overallScore = 50; health = 'UNKNOWN';
    recommendations = [{ priority:'LOW', action:'Continue monitoring', cmd:'journalctl -f' }];
    infoIssues = [{ area:'System', msg:'Analysis incomplete due to error: ' + e8.message }];
    stepError('rootcause');
  }

  // STEP 9: Report Generation
  stepStart('report');
  logMsg('[STEP 9] Assembling investigation report...');
  const r9sys = results.system || {}, r9ker = results.kernel || {}, r9fs = results.filesystem || {};
  const r9svc = results.services || {}, r9net = results.network || {}, r9sec = results.security || {}, r9lg = results.logs || {};
  const r9dk = results.docker || {}, r9db = results.database || {};
  const dockerScore = r9dk.installed ? Math.max(0, 100 - (r9dk.unhealthy||[]).length * 25 - (r9dk.restartLoops||[]).length * 30) : 100;
  let dbScore = 100;
  if (r9db.postgres) dbScore -= (r9db.postgres.waitingLocks||0) * 20 + Math.min(30, (r9db.postgres.slowQueries||0) * 3);
  if (r9db.mysql && r9db.mysql.status && !/active|running/i.test(r9db.mysql.status)) dbScore -= 50;
  if (r9db.redis && r9db.redis.lastBgSave && r9db.redis.lastBgSave !== 'ok' && r9db.redis.lastBgSave !== '') dbScore -= 15;
  dbScore = Math.max(0, dbScore);
  const dockerVal  = r9dk.installed ? ((r9dk.running||0) + ' running · ' + (r9dk.unhealthy||[]).length + ' unhealthy') : 'not installed';
  const dbInstalledList = ['postgres','mysql','redis','mongodb'].filter(k => r9db[k] && r9db[k].installed);
  const dbVal      = dbInstalledList.length ? dbInstalledList.join(', ') : 'none detected';
  const report = {
    ts: Date.now(), jobId, hostId, mode, overallScore, health,
    subsystems: {
      cpu:      { score: cpuScore,    label:'CPU',      value: (r9sys.load1||0) + ' load' },
      memory:   { score: memScore,    label:'Memory',   value: (r9sys.memPct||0) + '% used' },
      disk:     { score: diskScore,   label:'Disk',     value: (r9fs.critDisks||[]).length + ' critical' },
      network:  { score: netScore,    label:'Network',  value: (r9net.pingLoss||0) + '% loss · DNS ' + (r9net.dnsOk===false?'DOWN':'ok') },
      services: { score: svcScore,    label:'Services', value: (r9svc.failedCount||0) + ' failed' },
      security: { score: secScore,    label:'Security', value: (r9sec.firewallActive===false?'no firewall':(r9sec.firewallType||'fw')) + ' · ' + ((r9sec.sshWeak||[]).length) + ' SSH risk' },
      logs:     { score: logScore,    label:'Logs',     value: (r9lg.errCount||0) + ' errors' },
      kernel:   { score: kernScore,   label:'Kernel',   value: (r9ker.errCount||0) + ' errors' },
      docker:   { score: dockerScore, label:'Docker',   value: dockerVal },
      database: { score: dbScore,     label:'Database', value: dbVal }
    },
    rootCause: { summary: rootCauseSummary8, confidence: rootCauseConf8 },
    correlations: corrs,
    findings: { critical: critIssues, warnings: warnIssues, info: infoIssues },
    recommendations,
    raw: {
      kernelErrors:   (r9ker.errors||[]).slice(0,5),
      recentLogs:     (r9lg.recentErrors||[]).slice(0,5),
      failedServices: (r9svc.failedServices||[]).slice(0,5),
      openPorts:      (r9sec.openPorts||[]).slice(0,10),
      diskStatus:     r9fs.dfOut || '',
      containers:     (r9dk.containers||[]).slice(0,10),
      databases:      Object.fromEntries(Object.entries(r9db).filter(([_,v]) => v && v.installed)),
      // Deep inspection evidence
      security: {
        sshRootLogin: r9sec.sshRootLogin, sshPassAuth: r9sec.sshPassAuth, sshWeak: r9sec.sshWeak||[],
        firewallActive: r9sec.firewallActive, firewallType: r9sec.firewallType, fail2ban: r9sec.fail2ban,
        fail2banJails: r9sec.fail2banJails, worldWritable: (r9sec.worldWritable||[]).slice(0,6),
        sudoNopasswd: (r9sec.sudoNopasswd||[]).slice(0,6), suspiciousSuid: (r9sec.suspiciousSuid||[]).slice(0,6),
        harden: r9sec.harden || null
      },
      topErrors:      (r9lg.topErrors||[]).slice(0,6),
      crashSignals:   { segfaults: r9lg.segfaults||0, coreDumps: r9lg.coreDumps||0, timeouts: r9lg.timeouts||0 },
      kernelHardware: { mce: (r9ker.mceEvents||[]).slice(0,4), hungTasks: (r9ker.hungTasks||[]).slice(0,4) },
      fsErrors:       (r9fs.fsErrors||[]).slice(0,5),
      network:        { dnsOk: r9net.dnsOk, gateway: r9net.gateway, gatewayReachable: r9net.gatewayReachable,
                        tlsDays: r9net.tlsDays, tlsExpiry: r9net.tlsExpiry, tlsCerts: (r9net.tlsCerts||[]).slice(0,6), ifErrors: (r9net.ifErrors||[]).slice(0,4) }
    }
  };
  logMsg('[STEP 9] Report assembled — ' + (critIssues.length + warnIssues.length) + ' total findings');
  stepDone('report');
  logMsg('[SCAN COMPLETE] Full system investigation finished · Score: ' + overallScore + '/100 · Health: ' + health);
  if (sshConn) { try { sshConn.end(); } catch(e) {} }
  // Persist report to disk so scheduled/cron scans can run via plain HTTP (no socket client needed)
  try {
    const repDir = path.join(__dirname, 'reports');
    fs.mkdirSync(repDir, { recursive: true });
    const ts = new Date().toISOString().slice(0,19).replace(/[:T]/g,'-');

    // --- Degradation alerting: compare this scan against the previous latest.json ---
    try {
      const latestPath = path.join(repDir, 'latest.json');
      if (fs.existsSync(latestPath)) {
        const prev = JSON.parse(fs.readFileSync(latestPath, 'utf8'));
        const prevScore = Number(prev.overallScore) || 0;
        const newScore  = Number(report.overallScore) || 0;
        const prevCrit  = ((prev.findings || {}).critical || []).length;
        const newCrit   = ((report.findings || {}).critical || []).length;
        const alerts = [];
        if (newScore <= prevScore - 5)
          alerts.push('score dropped ' + prevScore + ' -> ' + newScore + ' (-' + (prevScore - newScore) + ')');
        if (newCrit > prevCrit)
          alerts.push('new critical findings: ' + prevCrit + ' -> ' + newCrit);
        if (report.health === 'CRITICAL' && prev.health !== 'CRITICAL')
          alerts.push('health became CRITICAL (was ' + (prev.health || '?') + ')');
        if (alerts.length) {
          const line = '[' + new Date().toISOString() + '] ALERT host=' + hostId +
            ' mode=' + (report.mode || '?') + ' :: ' + alerts.join(' | ');
          const critMsgs = ((report.findings || {}).critical || []).map(c => '    - [' + (c.area||'') + '] ' + (c.msg||'')).join('\n');
          fs.appendFileSync(path.join(repDir, 'alerts.log'), line + (critMsgs ? '\n' + critMsgs : '') + '\n');
          fs.writeFileSync(path.join(repDir, 'alert.flag'), JSON.stringify({
            ts: new Date().toISOString(), hostId, score: newScore, prevScore, health: report.health,
            critical: newCrit, reasons: alerts
          }, null, 2));
          console.warn('[FullScan] ' + line);
          emitEvt('fullscan:alert', { hostId, score: newScore, prevScore, health: report.health, reasons: alerts });
        } else {
          // recovered/stable -> clear any stale alert flag
          try { fs.unlinkSync(path.join(repDir, 'alert.flag')); } catch(e) {}
        }
      }
    } catch(e) { console.error('[FullScan] alert check failed:', e.message); }

    fs.writeFileSync(path.join(repDir, 'scan-' + ts + '.json'), JSON.stringify(report, null, 2));
    fs.writeFileSync(path.join(repDir, 'latest.json'), JSON.stringify(report, null, 2));
    const files = fs.readdirSync(repDir).filter(f => /^scan-.*\.json$/.test(f)).sort();
    while (files.length > 30) { try { fs.unlinkSync(path.join(repDir, files.shift())); } catch(e){} }
  } catch(e) { console.error('[FullScan] report persist failed:', e.message); }
  emitEvt('fullscan:complete', { report });
  return report;
}

app.post('/api/scan/full-system', authMiddleware, async (req, res) => {
  try {
    const { hostId, mode } = req.body;
    const resolvedHostId = hostId && hostId.trim() ? hostId.trim() : 'localhost';
    const resolvedMode = mode && ['quick','deep','full','security','kernel','filesystem','storage','logs','services','network','docker','database'].includes(mode) ? mode : 'deep';
    const jobId = Date.now().toString(36) + Math.random().toString(36).slice(2,6);
    console.log('[FullScan] Scan requested: hostId=' + resolvedHostId + ' mode=' + resolvedMode + ' jobId=' + jobId);
    res.json({ ok: true, jobId, hostId: resolvedHostId, mode: resolvedMode });
    setImmediate(() => runFullSystemScan(jobId, resolvedHostId, io, resolvedMode).catch(err => {
      console.error('[FullScan] Error:', err.message);
      io.emit('fullscan:complete', { jobId, report: { error: err.message, overallScore: 0, health: 'ERROR' } });
    }));
  } catch(e) {
    res.status(500).json({ error: e.message });
  }
});

// Return the most recent persisted full-system scan report
app.get('/api/scan/latest', authMiddleware, (req, res) => {
  try {
    const f = path.join(__dirname, 'reports', 'latest.json');
    if (!fs.existsSync(f)) return res.status(404).json({ error: 'no scan report yet' });
    res.json(JSON.parse(fs.readFileSync(f, 'utf8')));
  } catch(e) {
    res.status(500).json({ error: e.message });
  }
});

// List persisted scan reports (newest first) — lightweight summary for the History tab
app.get('/api/scan/history-list', authMiddleware, (req, res) => {
  try {
    const repDir = path.join(__dirname, 'reports');
    if (!fs.existsSync(repDir)) return res.json({ reports: [], alert: null });
    const files = fs.readdirSync(repDir).filter(f => /^scan-.*\.json$/.test(f)).sort().reverse();
    const reports = files.map(f => {
      try {
        const d = JSON.parse(fs.readFileSync(path.join(repDir, f), 'utf8'));
        return {
          file: f,
          ts: f.replace(/^scan-/, '').replace(/\.json$/, ''),
          score: d.overallScore, health: d.health, mode: d.mode, hostId: d.hostId,
          critical: ((d.findings||{}).critical||[]).length,
          warnings: ((d.findings||{}).warnings||[]).length
        };
      } catch(e) { return null; }
    }).filter(Boolean);
    let alert = null;
    const flag = path.join(repDir, 'alert.flag');
    if (fs.existsSync(flag)) { try { alert = JSON.parse(fs.readFileSync(flag, 'utf8')); } catch(e){} }
    res.json({ reports, alert });
  } catch(e) {
    res.status(500).json({ error: e.message });
  }
});

// Fetch a single persisted report by file name (validated to avoid path traversal)
app.get('/api/scan/report/:file', authMiddleware, (req, res) => {
  try {
    const name = req.params.file;
    if (!/^scan-[\d-]+\.json$/.test(name)) return res.status(400).json({ error: 'invalid report name' });
    const f = path.join(__dirname, 'reports', name);
    if (!fs.existsSync(f)) return res.status(404).json({ error: 'report not found' });
    res.json(JSON.parse(fs.readFileSync(f, 'utf8')));
  } catch(e) {
    res.status(500).json({ error: e.message });
  }
});

// Read the daily auto-scan schedule (parsed from the ubuntu crontab)
app.get('/api/scan/schedule', authMiddleware, (req, res) => {
  require('child_process').exec('crontab -l 2>/dev/null', (e, out) => {
    const line = (out || '').split('\n').find(l => l.indexOf('daily_scan') >= 0 && !/^\s*#/.test(l));
    if (!line) return res.json({ enabled: false, hour: 3, minute: 30 });
    const p = line.trim().split(/\s+/);
    res.json({ enabled: true, minute: parseInt(p[0]) || 0, hour: parseInt(p[1]) || 0 });
  });
});

// Update the daily auto-scan schedule (rewrites the crontab daily_scan line)
app.post('/api/scan/schedule', authMiddleware, (req, res) => {
  const cp = require('child_process');
  let { enabled, hour, minute } = req.body || {};
  hour = parseInt(hour); minute = parseInt(minute);
  if (isNaN(hour)) hour = 3; if (isNaN(minute)) minute = 30;
  hour = Math.max(0, Math.min(23, hour)); minute = Math.max(0, Math.min(59, minute));
  cp.exec('crontab -l 2>/dev/null', (e, out) => {
    const lines = (out || '').split('\n').filter(l => l.trim() && l.indexOf('daily_scan') < 0);
    if (enabled) lines.push(minute + ' ' + hour + ' * * * /opt/nova/daily_scan.sh >> /opt/nova/backend/reports/cron.log 2>&1');
    const data = lines.join('\n') + '\n';
    const child = cp.exec('crontab -', (e2) => {
      if (e2) return res.status(500).json({ error: 'crontab update failed: ' + e2.message });
      res.json({ ok: true, enabled: !!enabled, hour, minute });
    });
    try { child.stdin.write(data); child.stdin.end(); } catch(ex) { res.status(500).json({ error: ex.message }); }
  });
});


// =====================================================================
// PORT INTELLIGENCE SCANNER
// =====================================================================
(function() {
const _net = require('net');
const _dns = require('dns').promises;
const _tls = require('tls');

const PORT_QUICK = [21,22,23,25,53,80,110,111,143,389,443,445,465,587,
  636,993,995,1080,1433,1521,2049,2181,2375,2376,3000,3306,3389,4000,
  5000,5432,5900,5984,6379,6443,7000,8000,8080,8081,8443,8888,9000,
  9090,9200,9300,9600,10000,11211,27017,27018,28017,50000];

const PORT_DEEP = (function(){
  const base = [];
  for(let i=1;i<=1024;i++) base.push(i);
  [1433,1521,2049,2181,2375,2376,2377,3000,3306,3389,4000,4369,5000,
   5432,5900,5984,6379,6443,7000,7070,8000,8080,8081,8443,8888,9000,
   9090,9092,9200,9300,9600,10000,11211,27017,27018,28017,50000,50070].forEach(p=>{
     if(!base.includes(p)) base.push(p);
   });
  return base;
})();

const PORT_SSL  = [443,4443,8443,9443,8444,5443,10443];
const PORT_HTTP = [80,8080,8000,3000,4000,5000,8888,9000,3001,4001];

const SERVICE_DB = {
  21:{n:'FTP',risk:'HIGH'},22:{n:'SSH',risk:'MED'},23:{n:'Telnet',risk:'CRITICAL'},
  25:{n:'SMTP',risk:'MED'},53:{n:'DNS',risk:'LOW'},80:{n:'HTTP',risk:'MED'},
  110:{n:'POP3',risk:'MED'},111:{n:'RPC',risk:'HIGH'},143:{n:'IMAP',risk:'MED'},
  389:{n:'LDAP',risk:'HIGH'},443:{n:'HTTPS',risk:'LOW'},445:{n:'SMB',risk:'CRITICAL'},
  465:{n:'SMTPS',risk:'LOW'},587:{n:'SMTP',risk:'LOW'},636:{n:'LDAPS',risk:'LOW'},
  993:{n:'IMAPS',risk:'LOW'},995:{n:'POP3S',risk:'LOW'},1080:{n:'SOCKS5',risk:'HIGH'},
  1433:{n:'MSSQL',risk:'HIGH'},1521:{n:'Oracle',risk:'HIGH'},2049:{n:'NFS',risk:'HIGH'},
  2181:{n:'ZooKeeper',risk:'HIGH'},2375:{n:'Docker-API',risk:'CRITICAL'},
  2376:{n:'Docker-TLS',risk:'HIGH'},3000:{n:'Dev/Node',risk:'MED'},
  3306:{n:'MySQL',risk:'HIGH'},3389:{n:'RDP',risk:'HIGH'},4000:{n:'Dev',risk:'MED'},
  5000:{n:'Flask/Dev',risk:'MED'},5432:{n:'PostgreSQL',risk:'HIGH'},
  5900:{n:'VNC',risk:'HIGH'},5984:{n:'CouchDB',risk:'HIGH'},
  6379:{n:'Redis',risk:'CRITICAL'},6443:{n:'K8s-API',risk:'HIGH'},
  7000:{n:'Cassandra',risk:'HIGH'},8000:{n:'HTTP-Alt',risk:'MED'},
  8080:{n:'HTTP-Alt',risk:'MED'},8081:{n:'HTTP-Alt',risk:'MED'},
  8443:{n:'HTTPS-Alt',risk:'LOW'},8888:{n:'Jupyter',risk:'HIGH'},
  9000:{n:'PHP-FPM',risk:'MED'},9090:{n:'Prometheus',risk:'HIGH'},
  9200:{n:'Elasticsearch',risk:'CRITICAL'},9300:{n:'Elasticsearch',risk:'HIGH'},
  9600:{n:'Logstash',risk:'MED'},10000:{n:'Webmin',risk:'HIGH'},
  11211:{n:'Memcached',risk:'HIGH'},27017:{n:'MongoDB',risk:'CRITICAL'},
  27018:{n:'MongoDB',risk:'HIGH'},28017:{n:'MongoDB-Web',risk:'HIGH'},
  50000:{n:'SAP',risk:'HIGH'}
};

const RISK_COLORS = {CRITICAL:'#ef4444',HIGH:'#f97316',MED:'#eab308',LOW:'#22c55e'};

function _detectService(port, banner) {
  const svc = SERVICE_DB[port] || {n:'Unknown',risk:'LOW'};
  let version = '';
  if (banner) {
    const b = banner.replace(/[\x00-\x08\x0e-\x1f\x7f]/g,' ').trim();
    if (b.includes('SSH-')) {
      const m = b.match(/SSH-[\d.]+-(\S+)/);
      version = m ? m[1].replace(/\r/g,'').trim() : 'SSH';
    } else if (/HTTP\//i.test(b)) {
      const sv = b.match(/Server:\s*([^\r\n]+)/i);
      version = sv ? sv[1].trim().slice(0,50) : 'HTTP';
    } else if (b.toLowerCase().includes('mysql')) {
      const m = b.match(/(\d+\.\d+\.\d+)/);
      version = m ? 'MySQL ' + m[1] : 'MySQL';
    } else if (b.toLowerCase().includes('postgresql')) {
      version = 'PostgreSQL';
    } else if (b.toLowerCase().includes('redis')) {
      const m = b.match(/redis_version:([^\r\n]+)/i);
      version = m ? 'Redis ' + m[1].trim() : 'Redis';
    } else if (b.startsWith('220')) {
      const m = b.match(/^220[- ](.{1,50})/m);
      version = m ? m[1].trim() : (svc.n === 'FTP' ? 'FTP' : 'SMTP');
    } else if (b.length > 0 && b.length < 80) {
      version = b.slice(0,50).replace(/\n.*/,'');
    }
  }
  return {
    name: svc.n,
    version: version || svc.n,
    risk: svc.risk,
    color: RISK_COLORS[svc.risk] || '#6b7280'
  };
}

async function _scanPortTCP(host, port, timeout) {
  return new Promise((resolve) => {
    const sock = new _net.Socket();
    let banner = '';
    const t0 = Date.now();
    sock.setTimeout(timeout);
    sock.connect(port, host, () => {
      const lat = Date.now() - t0;
      // wait briefly for banner
      const bail = setTimeout(() => {
        sock.destroy();
        resolve({ open: true, latency: lat, banner });
      }, Math.min(400, timeout / 3));
      sock.on('data', (d) => {
        if (banner.length < 512) banner += d.toString('ascii');
        if (banner.length >= 256) {
          clearTimeout(bail);
          sock.destroy();
          resolve({ open: true, latency: lat, banner });
        }
      });
    });
    sock.on('timeout', () => { sock.destroy(); resolve({ open: false }); });
    sock.on('error', (e) => resolve({ open: false, filtered: e.code !== 'ECONNREFUSED' }));
  });
}

async function _inspectSSLCert(host, port) {
  return new Promise((resolve) => {
    try {
      const opts = { host, port, rejectUnauthorized: false, timeout: 5000,
                     servername: /^\d/.test(host) ? undefined : host };
      const sock = _tls.connect(opts, () => {
        try {
          const cert = sock.getPeerCertificate(false);
          const proto = sock.getProtocol();
          const cipher = sock.getCipher();
          sock.destroy();
          const validTo = cert.valid_to || '';
          const days = validTo ? Math.round((new Date(validTo) - Date.now()) / 86400000) : 0;
          resolve({
            subject: (cert.subject && (cert.subject.CN || cert.subject.O)) || 'Unknown',
            issuer:  (cert.issuer  && (cert.issuer.O  || cert.issuer.CN))  || 'Unknown',
            validTo, validFrom: cert.valid_from || '',
            protocol: proto || 'TLS',
            cipher: cipher ? cipher.name : 'Unknown',
            valid: !!sock.authorized,
            days,
            expired: days < 0,
            expiringSoon: days >= 0 && days < 30
          });
        } catch(e) { sock.destroy(); resolve(null); }
      });
      sock.on('error', () => resolve(null));
      sock.setTimeout(5000, () => { sock.destroy(); resolve(null); });
    } catch(e) { resolve(null); }
  });
}

async function runPortScan(scanId, targetRaw, mode, options, _io) {
  const emit = (ev, data) => _io.emit(ev, { scanId, ...data });
  const log  = (msg, type='INFO') => emit('portscan:log', { msg, type, ts: Date.now() });

  let target = (targetRaw || '127.0.0.1').trim()
    .replace(/^https?:\/\//,'').split('/')[0].split(':')[0];
  if (target === 'localhost') target = '127.0.0.1';

  const timeout  = Math.min(5000, Math.max(500, parseInt(options && options.timeout) || 2000));
  const threads  = Math.min(200, Math.max(10, parseInt(options && options.threads) || 100));

  let ports;
  if (mode === 'quick')  ports = PORT_QUICK;
  else if (mode === 'deep') ports = PORT_DEEP;
  else if (mode === 'ssl')  ports = PORT_SSL;
  else if (mode === 'http') ports = PORT_HTTP;
  else ports = PORT_QUICK;

  log('[INIT] Port Intelligence Scan → target=' + target + ' mode=' + mode + ' ports=' + ports.length + ' threads=' + threads);
  emit('portscan:start', { target, mode, totalPorts: ports.length });

  // DNS resolution
  let hostname = target;
  if (/^\d+\.\d+\.\d+\.\d+$/.test(target)) {
    try {
      const rev = await _dns.reverse(target);
      if (rev && rev.length > 0) { hostname = rev[0]; log('[DNS] Reverse: ' + hostname); }
    } catch(e) {}
  } else {
    try {
      const fwd = await _dns.lookup(target);
      log('[DNS] ' + target + ' → ' + fwd.address);
      target = fwd.address;
    } catch(e) { log('[DNS] Resolution failed for ' + target, 'WARN'); }
  }

  // Quick reachability check
  log('[PROBE] Testing host reachability...');
  const probes = await Promise.all(
    [22,80,443,8080].map(p => _scanPortTCP(target, p, 1500).catch(() => ({ open:false })))
  );
  const alive = probes.some(p => p.open);
  log(alive ? '[PROBE] Host reachable' : '[PROBE] Host may be offline or fully firewalled — scanning anyway');

  // SSL-only mode
  if (mode === 'ssl') {
    log('[SSL] Inspecting TLS/SSL on ' + ports.length + ' ports...');
    const sslResults = [];
    for (const p of ports) {
      const tcp = await _scanPortTCP(target, p, 3000);
      if (tcp.open) {
        log('[SSL] Port ' + p + ' open — inspecting certificate...');
        const ssl = await _inspectSSLCert(target, p);
        const portInfo = {
          port: p, service: 'HTTPS', version: ssl ? ssl.protocol : 'TLS',
          risk: ssl ? (ssl.expired ? 'HIGH' : ssl.expiringSoon ? 'MED' : 'LOW') : 'MED',
          color: '#22d3ee', latency: tcp.latency, ssl: ssl || null, banner: ''
        };
        sslResults.push(portInfo);
        emit('portscan:port', portInfo);
        if (ssl) {
          log('[SSL] Port ' + p + ': ' + ssl.protocol + ' | ' + ssl.subject +
              ' | expires ' + ssl.validTo + ' (' + ssl.days + ' days)' +
              (ssl.expired ? ' EXPIRED!' : ssl.expiringSoon ? ' EXPIRING SOON!' : ''),
              ssl.expired ? 'CRIT' : ssl.expiringSoon ? 'WARN' : 'INFO');
        }
      }
    }
    const findings = [];
    sslResults.filter(p=>p.ssl&&p.ssl.expired).forEach(p=>
      findings.push({severity:'CRITICAL',type:'Expired Certificate',desc:'SSL cert on port '+p.port+' is expired',port:p.port}));
    sslResults.filter(p=>p.ssl&&p.ssl.expiringSoon).forEach(p=>
      findings.push({severity:'HIGH',type:'Expiring Certificate',desc:'SSL cert on port '+p.port+' expires in '+p.ssl.days+' days',port:p.port}));
    emit('portscan:complete', {target,hostname,mode,openPorts:sslResults,
      totalScanned:ports.length,findings,recommendations:[],riskScore:
      Math.min(100,findings.filter(f=>f.severity==='CRITICAL').length*30+
               findings.filter(f=>f.severity==='HIGH').length*15),duration:0});
    return;
  }

  // TCP port sweep
  const openPorts = [];
  let scanned = 0;
  const t0 = Date.now();

  async function worker(chunk) {
    for (const port of chunk) {
      const res = await _scanPortTCP(target, port, timeout);
      scanned++;
      if (res.open) {
        const svc = _detectService(port, res.banner);
        const portInfo = {
          port, service: svc.name, version: svc.version,
          risk: svc.risk, color: svc.color,
          latency: res.latency,
          banner: res.banner ? res.banner.replace(/[\x00-\x1f\x7f]/g,' ').trim().slice(0,120) : ''
        };
        // TLS inspection for known HTTPS ports
        if ([443,8443,4443,9443].includes(port)) {
          const ssl = await _inspectSSLCert(target, port).catch(()=>null);
          if (ssl) { portInfo.ssl = ssl; portInfo.version = ssl.protocol + '/' + svc.version; }
        }
        openPorts.push(portInfo);
        emit('portscan:port', portInfo);
        log('[OPEN] ' + port + '/TCP → ' + svc.name + ' (' + svc.version + ') ' +
            res.latency + 'ms [' + svc.risk + ']',
            svc.risk==='CRITICAL'?'CRIT':svc.risk==='HIGH'?'WARN':'INFO');
        if (svc.risk==='CRITICAL') log('[!] CRITICAL exposure: ' + svc.name + ' port ' + port + ' requires immediate attention','CRIT');
        else if (svc.risk==='HIGH') log('[!] HIGH RISK: ' + svc.name + ' port ' + port + ' should be firewalled','WARN');
      }
      if (scanned % 25 === 0) {
        const pct = Math.round(scanned / ports.length * 100);
        emit('portscan:progress', { scanned, total: ports.length, pct, openCount: openPorts.length });
      }
    }
  }

  // Distribute ports across workers
  const chunkSize = Math.ceil(ports.length / Math.min(threads, ports.length));
  const chunks = [];
  for (let i = 0; i < ports.length; i += chunkSize) chunks.push(ports.slice(i, i+chunkSize));
  log('[SCAN] ' + chunks.length + ' concurrent workers | ' + ports.length + ' ports | timeout=' + timeout + 'ms');
  await Promise.all(chunks.map(ch => worker(ch)));
  emit('portscan:progress', { scanned: ports.length, total: ports.length, pct: 100, openCount: openPorts.length });

  const duration = Math.round((Date.now() - t0) / 1000);
  log('[DONE] Scan complete: ' + duration + 's | Open: ' + openPorts.length + '/' + ports.length + ' ports');

  // AI findings analysis
  const findings = [];
  const recommendations = [];
  let riskScore = 0;

  const critPorts = openPorts.filter(p=>p.risk==='CRITICAL');
  const highPorts = openPorts.filter(p=>p.risk==='HIGH');
  const medPorts  = openPorts.filter(p=>p.risk==='MED');
  riskScore = Math.min(100, critPorts.length*20 + highPorts.length*8 + medPorts.length*2);

  // Specific service findings
  if (openPorts.find(p=>p.port===23))
    findings.push({severity:'CRITICAL',type:'Insecure Protocol',desc:'Telnet (port 23) transmits data in plaintext — replace with SSH immediately',port:23});
  if (openPorts.find(p=>p.port===6379))
    findings.push({severity:'CRITICAL',type:'Redis Exposed',desc:'Redis has no authentication by default — data at risk',port:6379});
  if (openPorts.find(p=>p.port===9200))
    findings.push({severity:'CRITICAL',type:'Elasticsearch Exposed',desc:'Elasticsearch REST API accessible — potential data breach',port:9200});
  if (openPorts.find(p=>p.port===2375))
    findings.push({severity:'CRITICAL',type:'Docker API Exposed',desc:'Docker daemon API open without TLS — full system compromise possible',port:2375});
  if (openPorts.find(p=>p.port===27017))
    findings.push({severity:'CRITICAL',type:'MongoDB Exposed',desc:'MongoDB may be running without authentication',port:27017});
  if (openPorts.find(p=>p.port===11211))
    findings.push({severity:'HIGH',type:'Memcached Exposed',desc:'Memcached can be used for DDoS amplification',port:11211});
  if (openPorts.find(p=>p.port===8888))
    findings.push({severity:'HIGH',type:'Jupyter Notebook',desc:'Jupyter provides browser-based shell access',port:8888});
  if (openPorts.find(p=>p.port===9090))
    findings.push({severity:'HIGH',type:'Prometheus Exposed',desc:'Prometheus metrics endpoint may leak system info',port:9090});
  if (openPorts.find(p=>p.port===10000))
    findings.push({severity:'HIGH',type:'Webmin Exposed',desc:'Web-based admin panel accessible',port:10000});

  const dbPorts = openPorts.filter(p=>[3306,5432,1433,1521,3307].includes(p.port));
  if (dbPorts.length > 0)
    findings.push({severity:'HIGH',type:'Database Ports Accessible',
      desc:'Database services exposed: ' + dbPorts.map(p=>p.service+'('+p.port+')').join(', '),port:null});

  if (openPorts.find(p=>p.port===80) && !openPorts.find(p=>p.port===443))
    findings.push({severity:'MED',type:'HTTP Without HTTPS',desc:'Web service running on HTTP only — no encryption',port:80});

  if (openPorts.find(p=>p.port===21))
    findings.push({severity:'MED',type:'FTP Service',desc:'FTP transfers credentials in plaintext — use SFTP instead',port:21});

  if (critPorts.length===0 && highPorts.length===0)
    findings.push({severity:'INFO',type:'Clean Port Profile',desc:'No critical or high-risk exposed ports detected',port:null});

  // Recommendations
  if (findings.find(f=>f.port===6379))
    recommendations.push({priority:'CRITICAL',action:'Secure Redis',cmd:'redis-cli CONFIG SET requirepass "strong-password-here"'});
  if (findings.find(f=>f.port===23))
    recommendations.push({priority:'CRITICAL',action:'Disable Telnet',cmd:'systemctl disable telnetd && systemctl stop telnetd'});
  if (findings.find(f=>f.port===2375))
    recommendations.push({priority:'CRITICAL',action:'Disable Docker TCP',cmd:'Edit /etc/docker/daemon.json — remove tcp:// from hosts'});
  if (findings.find(f=>f.port===27017))
    recommendations.push({priority:'CRITICAL',action:'Enable MongoDB auth',cmd:'mongosh admin --eval "db.createUser({user:\'admin\',pwd:\'<PASS>\',roles:[\'root\']})"'});
  if (dbPorts.length > 0)
    recommendations.push({priority:'HIGH',action:'Firewall database ports',cmd:'ufw deny ' + dbPorts[0].port + ' && ufw allow from 127.0.0.1 to any port ' + dbPorts[0].port});
  if (findings.find(f=>f.port===80))
    recommendations.push({priority:'MED',action:'Enable HTTPS redirect',cmd:'certbot --nginx -d <domain> && certbot renew --dry-run'});
  if (recommendations.length===0)
    recommendations.push({priority:'LOW',action:'Continue monitoring',cmd:'journalctl -f | grep -i "error\\|warn\\|fail"'});

  emit('portscan:complete', {
    target, hostname, mode,
    openPorts, totalScanned: ports.length, findings, recommendations, riskScore, duration
  });
}

app.post('/api/scan/ports', authMiddleware, async (req, res) => {
  try {
    const { target, mode, options } = req.body;
    if (!target) return res.status(400).json({ error: 'target required' });
    const scanId = 'ps_' + Date.now().toString(36) + Math.random().toString(36).slice(2,5);
    res.json({ ok: true, scanId });
    setImmediate(() =>
      runPortScan(scanId, target, mode || 'quick', options || {}, io)
        .catch(err => console.error('[PortScan]', err.message))
    );
  } catch(e) {
    res.status(500).json({ error: e.message });
  }
});

app.post('/api/scan/ports/cancel', authMiddleware, (req, res) => {
  // Future: cancel logic via scanId
  res.json({ ok: true });
});

})(); // end port intelligence module

app.use('/', require('./routes/services'));

// ─── Global API Error Handler ─────────────────────────────────────────────────
app.use('/api', (err, req, res, next) => {
  console.error('[API Error]', req.method, req.path, err.message || err);
  res.status(err.status || 500).json({
    error: process.env.NODE_ENV === 'production'
      ? 'Internal server error'
      : err.message || 'Unknown error'
  });
});

// Serve live disk monitor script (no auth — loaded by index.html)
app.get('/live-disk-monitor.js', (req, res) => {
  const monPath = path.join(__dirname, 'live-disk-monitor.js');
  if (fs.existsSync(monPath)) {
    res.setHeader('Content-Type', 'application/javascript');
    res.setHeader('Cache-Control', 'no-store');
    res.sendFile(monPath);
  } else {
    res.status(404).send('// live-disk-monitor.js not found');
  }
});

// ─── Serve Frontend Static Files ──────────────────────────────────────────────
const FRONTEND_DIST = path.join(__dirname, '..', 'frontend', 'dist');
if (fs.existsSync(FRONTEND_DIST)) {
  // Serve hashed assets (JS/CSS) with long cache — filenames change on each build
  app.use('/assets', express.static(path.join(FRONTEND_DIST, 'assets'), {
    maxAge: '1y',
    immutable: true,
  }));
  // Serve everything else with no-cache (especially index.html)
  app.use(express.static(FRONTEND_DIST, {
    etag: true,
    lastModified: true,
    setHeaders: (res, filePath) => {
      if (filePath.endsWith('index.html')) {
        res.setHeader('Cache-Control', 'no-store, no-cache, must-revalidate');
        res.setHeader('Pragma', 'no-cache');
        res.setHeader('Expires', '0');
      }
    }
  }));
  // SPA fallback — Express v5 requires '/{*path}' instead of '*'
  app.get('/{*path}', (req, res) => {
    if (!req.path.startsWith('/api/') && !req.path.startsWith('/socket.io')) {
      res.setHeader('Cache-Control', 'no-store, no-cache, must-revalidate');
      res.sendFile(path.join(FRONTEND_DIST, 'index.html'));
    }
  });
  console.log(`[TelemetryHub] Serving frontend from: ${FRONTEND_DIST}`);
} else {
  console.warn('[TelemetryHub] Frontend dist not found — run "npm run build" in /frontend');
}


// ─── Boot ─────────────────────────────────────────────────────────────────────

const PORT = process.env.PORT || 5010;

// ══════════════════════════════════════════════════════════════════════════
// ══════════════════════════════════════════════════════════════════════════


// ══════════════════════════════════════════════════════════════════════════
// ═══ NOVA SCAN SERVER ENGINE — NOVA-SCAN-SERVER-V2                     ═══
// ══════════════════════════════════════════════════════════════════════════
(function() {
  const { exec } = require('child_process');
  const util = require('util');
  const execAsync = util.promisify(exec);

  // ── Global scan history (last 10, shared across connections) ──
  const SS_HISTORY = [];

  const SS_COMMANDS = {
    system: [
      { id:'uptime',   cmd:'uptime',                                                                                    tag:'SYSTEM'     },
      { id:'memory',   cmd:'free -m',                                                                                   tag:'SYSTEM'     },
      { id:'cpu',      cmd:'top -bn1 | head -15',                                                                       tag:'CPU'        },
      { id:'load',     cmd:'cat /proc/loadavg',                                                                         tag:'SYSTEM'     },
      { id:'temp',     cmd:'cat /sys/class/thermal/thermal_zone*/temp 2>/dev/null | head -5 || echo "N/A"',            tag:'THERMAL'    },
      { id:'oom',      cmd:'dmesg --level=err,warn 2>/dev/null | grep -i "oom\\|out of memory" | tail -15 || echo ""', tag:'KERNEL'     },
      { id:'kpanic',   cmd:'dmesg --level=crit,alert,emerg 2>/dev/null | tail -20 || echo ""',                        tag:'KERNEL'     },
      { id:'meminfo',  cmd:'cat /proc/meminfo | head -20',                                                              tag:'MEMORY'     },
      { id:'swap',     cmd:'swapon --show 2>/dev/null || echo "no swap"',                                              tag:'MEMORY'     },
      { id:'threads',  cmd:'echo "max:$(cat /proc/sys/kernel/threads-max 2>/dev/null)" && echo "cur:$(ps -eo nlwp 2>/dev/null | awk \'{sum+=$1}END{print sum}\')"', tag:'SYSTEM' },
    ],
    storage: [
      { id:'df',       cmd:'df -h 2>/dev/null',                                                                         tag:'FILESYSTEM' },
      { id:'inodes',   cmd:'df -i 2>/dev/null',                                                                         tag:'FILESYSTEM' },
      { id:'mounts',   cmd:'mount | grep -v "^proc\\|^sys\\|^dev\\|^cgroup\\|^tmpfs\\|^run" | head -20',              tag:'FILESYSTEM' },
      { id:'smart',    cmd:'smartctl --scan 2>/dev/null | head -10 || echo "smartctl not available"',                   tag:'SMART'      },
      { id:'blkdev',   cmd:'lsblk -o NAME,SIZE,TYPE,FSTYPE,MOUNTPOINT,MODEL 2>/dev/null',                              tag:'STORAGE'    },
      { id:'iostat',   cmd:'iostat -x 1 2 2>/dev/null | tail -20 || cat /proc/diskstats | head -10',                  tag:'STORAGE'    },
      { id:'fstab',    cmd:'grep -v "^#\\|^$" /etc/fstab 2>/dev/null',                                                tag:'FILESYSTEM' },
    ],
    network: [
      { id:'ports',    cmd:'ss -tlnp 2>/dev/null',                                                                      tag:'NETWORK'    },
      { id:'dropped',  cmd:'ip -s link 2>/dev/null | grep -A4 "state" | head -40',                                    tag:'NETWORK'    },
      { id:'dns',      cmd:'cat /etc/resolv.conf 2>/dev/null',                                                         tag:'NETWORK'    },
      { id:'iface',    cmd:'ip -br addr show 2>/dev/null',                                                             tag:'NETWORK'    },
      { id:'routes',   cmd:'ip route 2>/dev/null',                                                                     tag:'NETWORK'    },
      { id:'nstat',    cmd:'ss -s 2>/dev/null',                                                                        tag:'NETWORK'    },
      { id:'ss_est',   cmd:'ss -tnp state established 2>/dev/null | head -20',                                         tag:'NETWORK'    },
      { id:'ping_gw',  cmd:'ping -c3 -W2 $(ip route 2>/dev/null | awk \'/default/{print $3;exit}\') 2>/dev/null || echo "gateway unreachable"', tag:'NETWORK' },
    ],
    services: [
      { id:'sysfailed',cmd:'systemctl list-units --failed --no-pager 2>/dev/null',                                     tag:'SERVICE'    },
      { id:'pm2',      cmd:'pm2 list --no-color 2>/dev/null || echo "pm2 not available"',                              tag:'PM2'        },
      { id:'docker',   cmd:'docker ps -a --format "table {{.Names}}\t{{.Status}}\t{{.Image}}" 2>/dev/null | head -20 || echo "docker not available"', tag:'DOCKER' },
      { id:'postgres', cmd:'systemctl is-active postgresql 2>/dev/null; echo "pg_status:$?"',                          tag:'POSTGRES'   },
      { id:'redis',    cmd:'systemctl is-active redis 2>/dev/null || systemctl is-active redis-server 2>/dev/null; echo "redis_status:$?"', tag:'REDIS' },
      { id:'nginx',    cmd:'systemctl is-active nginx 2>/dev/null; echo "nginx_status:$?"',                            tag:'NGINX'      },
      { id:'procs',    cmd:'ps aux --sort=-%cpu 2>/dev/null | head -20',                                               tag:'PROCESS'    },
      { id:'crontab',  cmd:'crontab -l 2>/dev/null; ls /etc/cron.d/ 2>/dev/null | head -10',                          tag:'SERVICE'    },
    ],
    logs: [
      { id:'journalerr',cmd:'journalctl --no-pager -p err -n 80 --output=short-iso 2>/dev/null | tail -60',            tag:'KERNEL'     },
      { id:'authlog',  cmd:'journalctl -u ssh --no-pager -n 50 --output=short-iso 2>/dev/null | tail -40',             tag:'SECURITY'   },
      { id:'dmesg',    cmd:'dmesg --level=err,crit --time-format=iso 2>/dev/null | tail -40 || dmesg | grep -i error | tail -30', tag:'KERNEL' },
      { id:'syslog',   cmd:'journalctl --no-pager -n 60 -p warning --output=short-iso 2>/dev/null | tail -50',         tag:'SYSLOG'     },
      { id:'nginxerr', cmd:'journalctl -u nginx --no-pager -n 40 --output=short-iso 2>/dev/null | tail -30 || echo "nginx logs unavailable"', tag:'NGINX' },
      { id:'pm2logs',  cmd:'pm2 logs --nostream --lines 40 2>/dev/null | tail -50 || echo "pm2 logs unavailable"',     tag:'PM2'        },
    ],
    security: [
      { id:'sshfail',  cmd:'journalctl -u ssh --no-pager -n 150 2>/dev/null | grep -i "failed\\|invalid\\|refused" | tail -30 || last -F 2>/dev/null | head -20', tag:'SECURITY' },
      { id:'openports',cmd:'ss -tlnp 2>/dev/null',                                                                     tag:'SECURITY'   },
      { id:'sudolog',  cmd:'journalctl _COMM=sudo --no-pager -n 40 --output=short-iso 2>/dev/null | tail -30 || echo "sudo logs unavailable"', tag:'SECURITY' },
      { id:'rootprocs',cmd:'ps aux 2>/dev/null | awk \'$1=="root"{print $0}\' | head -15',                             tag:'SECURITY'   },
      { id:'sshcfg',   cmd:'grep -E "PermitRootLogin|PasswordAuthentication|PubkeyAuth" /etc/ssh/sshd_config 2>/dev/null || echo "sshd_config unavailable"', tag:'SECURITY' },
      { id:'lastlog',  cmd:'lastlog 2>/dev/null | grep -v "Never" | head -20 || echo "lastlog unavailable"',           tag:'SECURITY'   },
      { id:'world_w',  cmd:'find /etc /usr/bin /usr/sbin -perm -o+w -type f 2>/dev/null | head -10 || echo "none"',   tag:'SECURITY'   },
    ],
    hardware: [
      { id:'cpu_info', cmd:'lscpu 2>/dev/null | head -30',                                                             tag:'HARDWARE'   },
      { id:'mem_hw',   cmd:'dmidecode -t memory 2>/dev/null | grep -E "Size:|Type:|Speed:|Manufacturer:" | head -30 || echo "dmidecode requires root"', tag:'HARDWARE' },
      { id:'pci',      cmd:'lspci 2>/dev/null | head -30 || echo "lspci not available"',                               tag:'HARDWARE'   },
      { id:'usb',      cmd:'lsusb 2>/dev/null || echo "lsusb not available"',                                          tag:'HARDWARE'   },
      { id:'dmi',      cmd:'dmidecode -t system 2>/dev/null | grep -E "Product|Manufacturer|Version|UUID" | head -10 || echo "dmidecode not available"', tag:'HARDWARE' },
      { id:'nvme',     cmd:'nvme list 2>/dev/null || echo "nvme-cli not installed"',                                   tag:'STORAGE'    },
      { id:'mdstat',   cmd:'cat /proc/mdstat 2>/dev/null || echo "no RAID configured"',                               tag:'STORAGE'    },
    ],
    performance: [
      { id:'vmstat',   cmd:'vmstat 1 3 2>/dev/null',                                                                   tag:'PERF'       },
      { id:'iostat2',  cmd:'iostat -x 1 2 2>/dev/null | tail -30 || cat /proc/diskstats | head -15',                  tag:'PERF'       },
      { id:'pidstat',  cmd:'pidstat 1 2 2>/dev/null | tail -30 || ps aux --sort=-%cpu | head -15',                    tag:'PERF'       },
      { id:'swapin',   cmd:'vmstat -s 2>/dev/null | grep -i "swap\\|page\\|io" | head -15',                           tag:'PERF'       },
      { id:'irq',      cmd:'cat /proc/interrupts 2>/dev/null | head -25',                                              tag:'KERNEL'     },
      { id:'softirq',  cmd:'cat /proc/softirqs 2>/dev/null | head -15',                                               tag:'KERNEL'     },
    ],
    kernel: [
      { id:'modules',  cmd:'lsmod 2>/dev/null | head -30',                                                             tag:'KERNEL'     },
      { id:'kparams',  cmd:'sysctl -a 2>/dev/null | grep -E "vm\\.|net\\.core|kernel\\.panic|fs\\.file-max|net\\.ipv4" | head -40', tag:'KERNEL' },
      { id:'limits',   cmd:'ulimit -a 2>/dev/null',                                                                    tag:'KERNEL'     },
      { id:'fdcount',  cmd:'cat /proc/sys/fs/file-nr 2>/dev/null || echo "N/A"',                                      tag:'KERNEL'     },
      { id:'zombies',  cmd:'ps aux 2>/dev/null | awk \'$8=="Z"{print $0}\' | head -20 || echo "no zombies"',          tag:'PROCESS'    },
      { id:'coredumps',cmd:'coredumpctl list 2>/dev/null | tail -10 || find /var/crash /tmp -name "core.*" 2>/dev/null | head -5 || echo "no coredumps found"', tag:'KERNEL' },
    ],
  };

  const SS_MODES = {
    quick:       ['system', 'services'],
    deep:        ['system', 'storage', 'network', 'services', 'logs'],
    ai:          ['system', 'storage', 'services', 'logs', 'security'],
    security:    ['security', 'network', 'logs'],
    storage:     ['storage', 'logs'],
    performance: ['performance', 'system', 'kernel'],
    forensics:   ['kernel', 'security', 'logs', 'hardware'],
    full:        ['system', 'storage', 'network', 'services', 'logs', 'security', 'hardware', 'performance', 'kernel'],
  };

  function ssAnalyzeFindings(results) {
    const findings = [];
    const now = Date.now();

    // ── OOM events ──
    if (/out of memory|oom.killer/i.test(results.oom||'')) {
      findings.push({ sev:'critical', category:'MEMORY', source:'kernel/dmesg',
        msg:'OOM Killer activated — process(es) killed due to memory pressure',
        confidence:95, fix:'Increase RAM, reduce workload, or add swap. Check: dmesg | grep -i oom', ts:now });
    }

    // ── Kernel panic ──
    if (/kernel panic/i.test(results.kpanic||'')) {
      findings.push({ sev:'critical', category:'KERNEL', source:'dmesg',
        msg:'Kernel panic detected in dmesg ring buffer',
        confidence:99, fix:'Review: journalctl -p crit -b -1 --no-pager | head -50', ts:now });
    }

    // ── Failed systemd services ──
    const failLines = (results.sysfailed||'').split('\n').filter(l => /failed/i.test(l) && l.trim() && !l.includes('UNIT') && !l.includes('LOAD'));
    if (failLines.length > 0) {
      findings.push({ sev:'critical', category:'SERVICE', source:'systemd',
        msg:`${failLines.length} systemd unit(s) in FAILED state: ${failLines.slice(0,2).map(l=>l.trim().split(/\s+/)[0]).join(', ')}`,
        confidence:99, fix:'systemctl --failed && journalctl -u <service> -n 50', ts:now });
    }

    // ── High CPU load ──
    const loadMatch = (results.load||'').match(/([\d.]+)\s+([\d.]+)\s+([\d.]+)/);
    if (loadMatch) {
      const load1 = parseFloat(loadMatch[1]);
      if (load1 > 4) {
        findings.push({ sev: load1 > 8 ? 'critical' : 'warning', category:'CPU', source:'proc/loadavg',
          msg:`High system load average: ${load1.toFixed(2)} (1m)`,
          confidence:90, fix:'ps aux --sort=-%cpu | head -15 || top -bn1', ts:now });
      }
    }

    // ── Disk space critical ──
    (results.df||'').split('\n').forEach(line => {
      const m = line.match(/(\d+)%\s+(\/\S*)/);
      if (m && parseInt(m[1]) > 85) {
        findings.push({ sev: parseInt(m[1]) > 95 ? 'critical' : 'warning', category:'FILESYSTEM', source:'df',
          msg:`Filesystem ${m[2]} at ${m[1]}% capacity`,
          confidence:99, fix:`journalctl --vacuum-size=500M && du -sh /* 2>/dev/null | sort -rh | head -10`, ts:now });
      }
    });

    // ── Inode exhaustion ──
    (results.inodes||'').split('\n').forEach(line => {
      const m = line.match(/(\d+)%\s+(\/\S*)/);
      if (m && parseInt(m[1]) > 90) {
        findings.push({ sev:'critical', category:'FILESYSTEM', source:'df -i',
          msg:`Inode exhaustion on ${m[2]} at ${m[1]}% — no new files can be created`,
          confidence:99, fix:`find ${m[2]} -type f | wc -l && find /tmp /var -name "*.tmp" -delete`, ts:now });
      }
    });

    // ── Memory pressure ──
    const memMatch = (results.memory||'').match(/Mem:\s+(\d+)\s+(\d+)/);
    if (memMatch) {
      const total = parseInt(memMatch[1]), used = parseInt(memMatch[2]);
      const pct = Math.round(used / total * 100);
      if (pct > 88) {
        findings.push({ sev: pct > 95 ? 'critical' : 'warning', category:'MEMORY', source:'free',
          msg:`Memory utilization at ${pct}% — ${used}MB / ${total}MB used`,
          confidence:99, fix:'ps aux --sort=-%mem | head -10', ts:now });
      }
    }

    // ── Swap pressure ──
    const swapFreeM = (results.meminfo||'').match(/SwapFree:\s+(\d+)/);
    const swapTotalM = (results.meminfo||'').match(/SwapTotal:\s+(\d+)/);
    if (swapFreeM && swapTotalM) {
      const sf = parseInt(swapFreeM[1]), st = parseInt(swapTotalM[1]);
      if (st > 0) {
        const spct = Math.round((1 - sf / st) * 100);
        if (spct > 70) {
          findings.push({ sev: spct > 90 ? 'critical' : 'warning', category:'MEMORY', source:'proc/meminfo',
            msg:`Swap usage at ${spct}% — system swapping heavily`,
            confidence:85, fix:'Identify memory hogs; consider disabling swap if RAM is sufficient', ts:now });
        }
      }
    }

    // ── SSH brute force ──
    const auth = results.sshfail || results.authlog || '';
    const failedLogins = (auth.match(/Failed password|Invalid user|authentication failure/gi) || []).length;
    if (failedLogins > 5) {
      findings.push({ sev: failedLogins > 30 ? 'critical' : 'warning', category:'SECURITY', source:'auth.log',
        msg:`${failedLogins} SSH authentication failures detected`,
        confidence:92, fix:'apt install fail2ban && systemctl enable --now fail2ban', ts:now });
    }

    // ── Kernel errors ──
    const kLines = (results.dmesg||results.kpanic||'').split('\n').filter(l => l.trim());
    if (kLines.length > 3) {
      findings.push({ sev:'warning', category:'KERNEL', source:'dmesg',
        msg:`${kLines.length} kernel error/warning events in dmesg ring`,
        confidence:85, fix:'journalctl -p err -n 80 --no-pager | tail -30', ts:now });
    }

    // ── Docker unhealthy/exited ──
    const docker = results.docker || '';
    if (/unhealthy|Exited|dead/i.test(docker) && docker !== 'docker not available') {
      const bad = docker.split('\n').filter(l => /unhealthy|Exited|dead/i.test(l));
      findings.push({ sev:'warning', category:'DOCKER', source:'docker ps',
        msg:`${bad.length} unhealthy/exited Docker container(s)`,
        confidence:90, fix:'docker ps -a && docker restart <container>', ts:now });
    }

    // ── PM2 errored/stopped ──
    const pm2 = results.pm2 || '';
    if (/errored|stopped/i.test(pm2) && pm2 !== 'pm2 not available') {
      findings.push({ sev:'warning', category:'PM2', source:'pm2 list',
        msg:'One or more PM2 processes in errored/stopped state',
        confidence:88, fix:'pm2 list && pm2 restart <app>', ts:now });
    }

    // ── Dangerous open ports ──
    const ports = results.openports || results.ports || '';
    [21, 23, 3389, 5900, 6379, 27017].forEach(p => {
      if (ports.includes(`:${p} `)) {
        findings.push({ sev:'warning', category:'SECURITY', source:'ss',
          msg:`Potentially exposed port ${p} is open and listening`,
          confidence:75, fix:`ufw deny ${p}/tcp && ufw status`, ts:now });
      }
    });

    // ── RAID degraded ──
    const mdstat = results.mdstat || '';
    if (/degraded|FAILED/i.test(mdstat) && !/no RAID/i.test(mdstat)) {
      findings.push({ sev:'critical', category:'STORAGE', source:'/proc/mdstat',
        msg:'RAID array in degraded or FAILED state — data redundancy lost',
        confidence:99, fix:'cat /proc/mdstat && mdadm --detail /dev/md0 to inspect', ts:now });
    }

    // ── Zombie processes ──
    const zombies = results.zombies || '';
    if (zombies && !/no zombies/i.test(zombies) && zombies.trim() !== '') {
      const zCount = zombies.split('\n').filter(l => l.trim()).length;
      findings.push({ sev:'warning', category:'PROCESS', source:'ps aux',
        msg:`${zCount} zombie process(es) detected — parent not reaping children`,
        confidence:85, fix:'kill -CHLD $(ps -A -ostat,ppid | awk \'/Z/{print $2}\' | sort -u)', ts:now });
    }

    // ── Coredumps ──
    const cores = results.coredumps || '';
    if (!/no coredumps|none/i.test(cores) && cores.trim() !== '') {
      const cLines = cores.split('\n').filter(l => l.trim()).length;
      if (cLines > 1) {
        findings.push({ sev:'warning', category:'KERNEL', source:'coredumpctl',
          msg:`${cLines} core dump(s) found — application crash(es) recorded`,
          confidence:88, fix:'coredumpctl list && coredumpctl info to inspect crash details', ts:now });
      }
    }

    // ── File descriptor exhaustion ──
    const fdStr = results.fdcount || '';
    const fdMatch = fdStr.match(/(\d+)\s+\d+\s+(\d+)/);
    if (fdMatch) {
      const used = parseInt(fdMatch[1]), max = parseInt(fdMatch[2]);
      if (max > 0 && used / max > 0.85) {
        findings.push({ sev:'warning', category:'KERNEL', source:'proc/sys/fs/file-nr',
          msg:`File descriptor table at ${Math.round(used/max*100)}% — ${used}/${max} FDs used`,
          confidence:90, fix:'sysctl fs.file-max=2097152 && echo "fs.file-max=2097152" >> /etc/sysctl.conf', ts:now });
      }
    }

    // ── World-writable system files ──
    const worldW = results.world_w || '';
    if (worldW && !/^none$/i.test(worldW.trim()) && worldW.trim() !== '') {
      const wLines = worldW.split('\n').filter(l => l.trim()).length;
      findings.push({ sev:'critical', category:'SECURITY', source:'find',
        msg:`${wLines} world-writable file(s) found in /etc or /usr/bin — security risk`,
        confidence:95, fix:`chmod o-w <file> for each listed path`, ts:now });
    }

    // ── SSH root login enabled ──
    const sshcfg = results.sshcfg || '';
    if (/PermitRootLogin\s+yes/i.test(sshcfg)) {
      findings.push({ sev:'warning', category:'SECURITY', source:'sshd_config',
        msg:'SSH root login is permitted — reduces security posture',
        confidence:95, fix:'sed -i "s/PermitRootLogin yes/PermitRootLogin no/" /etc/ssh/sshd_config && systemctl reload ssh', ts:now });
    }

    // ── Password auth over SSH ──
    if (/PasswordAuthentication\s+yes/i.test(sshcfg)) {
      findings.push({ sev:'info', category:'SECURITY', source:'sshd_config',
        msg:'SSH password authentication is enabled — consider key-only auth',
        confidence:90, fix:'sed -i "s/PasswordAuthentication yes/PasswordAuthentication no/" /etc/ssh/sshd_config && systemctl reload ssh', ts:now });
    }

    // ── Network packet drops ──
    const dropped = results.dropped || '';
    const dropMatch = dropped.match(/RX.*dropped[:=]\s*(\d+)/i) || dropped.match(/dropped\s+(\d+)/i);
    if (dropMatch && parseInt(dropMatch[1]) > 100) {
      findings.push({ sev:'warning', category:'NETWORK', source:'ip -s link',
        msg:`High network packet drop count: ${dropMatch[1]} RX drops`,
        confidence:82, fix:'ip -s link && ethtool -g <iface> to check ring buffer sizes', ts:now });
    }

    // ── Gateway unreachable ──
    const pingGw = results.ping_gw || '';
    if (/100% packet loss|gateway unreachable/i.test(pingGw)) {
      findings.push({ sev:'critical', category:'NETWORK', source:'ping',
        msg:'Default gateway is unreachable — network connectivity lost',
        confidence:95, fix:'ip route && ip link show && ping -c1 8.8.8.8', ts:now });
    }

    // ── NVMe wear ──
    const nvme = results.nvme || '';
    if (/Percentage Used\s*[:=]\s*([7-9]\d|100)%/i.test(nvme)) {
      const wearMatch = nvme.match(/Percentage Used\s*[:=]\s*(\d+)%/i);
      const wear = wearMatch ? wearMatch[1] : '70+';
      findings.push({ sev:'warning', category:'STORAGE', source:'nvme list',
        msg:`NVMe SSD wear level at ${wear}% — reduced write endurance remaining`,
        confidence:88, fix:'Monitor with: nvme smart-log /dev/nvme0 | grep -i wear', ts:now });
    }

    // ── SMART reallocated sectors (disk TTF estimate) ──
    const smart = results.smart || '';
    const smartLines = smart.split('\n');
    const reallocLine = smartLines.find(l => /Reallocated_Sector|reallocated/i.test(l));
    if (reallocLine) {
      const val = parseInt((reallocLine.match(/\s(\d+)\s*$/) || [0, 0])[1]);
      if (val > 0) {
        const ttfDays = Math.max(1, Math.round(180 / val));
        findings.push({ sev: val > 10 ? 'critical' : 'warning', category:'SMART', source:'smartctl',
          msg:`${val} reallocated sector(s) — estimated failure risk within ~${ttfDays} day(s)`,
          confidence:75, fix:`Back up data immediately. Monitor: smartctl -a /dev/sda | grep -i reallocated`, ts:now });
      }
    }

    // ── High vmstat steal time ──
    const vmstat = results.vmstat || '';
    const vmLines = vmstat.split('\n').filter(l => /^\s*\d/.test(l));
    if (vmLines.length > 0) {
      const lastVm = vmLines[vmLines.length - 1].trim().split(/\s+/);
      // vmstat columns: r b swpd free buff cache si so bi bo in cs us sy id wa st
      if (lastVm.length >= 17) {
        const steal = parseFloat(lastVm[16]);
        const cs    = parseFloat(lastVm[11]);
        if (steal > 10) {
          findings.push({ sev:'warning', category:'PERF', source:'vmstat',
            msg:`High CPU steal time: ${steal}% — hypervisor stealing CPU from this VM`,
            confidence:85, fix:'Contact cloud provider if steal consistently >10%', ts:now });
        }
        if (cs > 100000) {
          findings.push({ sev:'warning', category:'PERF', source:'vmstat',
            msg:`Extremely high context switch rate: ${cs}/s — CPU scheduling overhead`,
            confidence:80, fix:'Identify cause: perf top -e context-switches || strace -c -p <pid>', ts:now });
        }
      }
    }

    // ── Slow disk I/O ──
    const iostat2 = results.iostat2 || results.iostat || '';
    const ioLines = iostat2.split('\n').filter(l => /sda|sdb|vda|nvme/i.test(l));
    ioLines.forEach(line => {
      const parts = line.trim().split(/\s+/);
      const await_ = parseFloat(parts[9] || '0'); // iostat -x await column
      if (await_ > 100) {
        findings.push({ sev:'warning', category:'STORAGE', source:'iostat',
          msg:`Disk I/O latency high: ${await_.toFixed(1)}ms average service time on ${parts[0]}`,
          confidence:88, fix:'iotop -o && check for I/O-heavy processes', ts:now });
      }
    });

    // ── Cron job failures ──
    const syslog = results.syslog || '';
    if (/cron.*ERROR|cron.*failed/i.test(syslog)) {
      findings.push({ sev:'warning', category:'SERVICE', source:'journalctl',
        msg:'Cron job failure(s) detected in system logs',
        confidence:80, fix:'journalctl -u cron --no-pager -n 50 to inspect', ts:now });
    }

    if (findings.length === 0) {
      findings.push({ sev:'success', category:'SYSTEM', source:'nova-ai',
        msg:'No critical issues detected — infrastructure appears healthy',
        confidence:82, fix:'Continue scheduled monitoring and periodic log review', ts:now });
    }

    return findings.sort((a, b) => {
      const o = { critical:0, warning:1, info:2, success:3 };
      return (o[a.sev] || 2) - (o[b.sev] || 2);
    });
  }

  io.on('connection', function ssScanHandler(socket) {

    // ── Scan history retrieve ──
    socket.on('server:scan:history:get', function() {
      socket.emit('server:scan:history', SS_HISTORY);
    });

    // ── Auto-scan scheduler ──
    let schedTimer = null;
    socket.on('server:scan:schedule', function(data) {
      if (schedTimer) clearInterval(schedTimer);
      schedTimer = null;
      const ms = parseInt((data && data.intervalMs) || 0);
      const mode = (data && data.mode) || 'quick';
      if (ms > 0) {
        schedTimer = setInterval(function() {
          socket.emit('server:scan:scheduled', { mode, ts: Date.now() });
        }, ms);
      }
    });
    socket.on('disconnect', function() {
      if (schedTimer) clearInterval(schedTimer);
    });

    // ── Main scan request ──
    socket.on('server:scan:request', async function(data) {
      const mode = (data && data.mode) ? String(data.mode) : 'quick';
      const cats = SS_MODES[mode] || SS_MODES.quick;
      const allCmds = cats.reduce((acc, cat) => acc.concat(SS_COMMANDS[cat] || []), []);
      const total = allCmds.length;
      const startTs = Date.now();

      socket.emit('server:scan:start', { mode, total, ts: startTs });

      const results = {};
      for (let i = 0; i < allCmds.length; i++) {
        const { id, cmd, tag } = allCmds[i];
        const pct = Math.round(((i + 1) / total) * 100);
        socket.emit('server:scan:progress', { pct, step: id, tag, stepNum: i + 1, total });
        try {
          const { stdout } = await execAsync(cmd, { timeout: 9000 });
          results[id] = stdout;
          const lines = (stdout || '').split('\n').filter(Boolean);
          lines.slice(0, 25).forEach(function(line) {
            const lvl = /error|crit|fail|panic|killed|denied/i.test(line) ? 'error' :
                        /warn|degraded|notice|alert/i.test(line) ? 'warn' : 'info';
            socket.emit('server:scan:log', { level: lvl, message: '[' + tag + '] ' + line.trim(), ts: Date.now() });
          });
        } catch (err) {
          results[id] = '';
          socket.emit('server:scan:log', {
            level: 'warn',
            message: '[' + tag + '] Skipped: ' + (err.message ? err.message.slice(0, 80) : 'timeout'),
            ts: Date.now()
          });
        }
      }

      const findings = ssAnalyzeFindings(results);
      findings.forEach(function(f) { socket.emit('server:scan:finding', f); });

      const health = findings.some(function(f) { return f.sev === 'critical'; }) ? 'CRITICAL' :
                     findings.some(function(f) { return f.sev === 'warning'; }) ? 'WARNING' : 'HEALTHY';

      const duration = Date.now() - startTs;

      // Store in history ring buffer
      SS_HISTORY.unshift({
        ts: startTs, mode, health, duration,
        findingsCount: findings.length,
        criticalCount: findings.filter(function(f) { return f.sev === 'critical'; }).length,
        warningCount:  findings.filter(function(f) { return f.sev === 'warning'; }).length,
        findings: findings.map(function(f) { return { sev: f.sev, category: f.category, msg: f.msg }; })
      });
      if (SS_HISTORY.length > 10) SS_HISTORY.pop();

      socket.emit('server:scan:complete', {
        mode, health, duration,
        findingsCount: findings.length,
        criticalCount: findings.filter(function(f) { return f.sev === 'critical'; }).length,
        warningCount:  findings.filter(function(f) { return f.sev === 'warning'; }).length,
        ts: Date.now()
      });

      // Broadcast updated history to this client
      socket.emit('server:scan:history', SS_HISTORY);
    });
  });

})();
// ══════════════════════════════════════════════════════════════════════════
// ═══ END NOVA SCAN SERVER ENGINE                                       ═══
// ══════════════════════════════════════════════════════════════════════════

server.listen(PORT, '0.0.0.0', async () => {
  console.log(`[TelemetryHub] Enterprise Backend running on port ${PORT} (0.0.0.0)`);

  db.logEvent('hub', 'system', 'Server started with persistence and automation engines active.');
  pollDisks();
  discoverNetworkDevices();

  // ── Auto-create default admin if no users exist ──────────────────────────
  try {
    const users = await db.getUsers();
    if (users.length === 0) {
      const hash = await bcrypt.hash('root', 12);
      await db.createUser('root', hash, 'admin');
      console.log('  ║  DEFAULT ADMIN CREATED                               ║');
      console.log('  ║  Username: root     Password: root                   ║');
      console.log('  ║  ⚠  CHANGE YOUR PASSWORD IMMEDIATELY AFTER LOGIN     ║');
    }
  } catch (e) { console.error('[Auth] Admin init error:', e.message); }
});
