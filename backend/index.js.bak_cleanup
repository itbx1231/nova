  ? process.env.ALLOWED_ORIGINS.split(',')
  : [process.env.ALLOWED_ORIGIN || 'http://localhost:3010'];
const io = new Server(server, {
  cors: { origin: ALLOWED_ORIGINS, methods: ['GET', 'POST'], credentials: true }
});

// ─── State ───────────────────────────────────────────────────────────────────
let currentDisks = [];
let currentPartitions = [];
let eventLog = [];
let initialized = false;

let hosts = {
  'localhost': {
    name: 'Local Server',
    os: process.platform,
    disks: [], partitions: [], history: [],

    lastUpdate: Date.now(), status: 'online',
    connectionType: 'local', cpu: 0, mem: 0,
    network: { rx: 0, tx: 0, iface: '' }
  }
};

const scanResultCache = new Map(); // jobId -> { result, hostId, diskName, ts }

// Alert thresholds (user configurable via API)
let alertThresholds = {
  diskUsage: 90,     // %
  cpuLoad: 85,       // %
  memUsage: 90,      // %
  tempCelsius: 50,   // °C
  rxSpike: 100,      // MB/s
  txSpike: 100,      // MB/s
  healthDrop: 5,        // points (e.g. drop from 100 to 94)
  errorSpike: 1,        // any increase in bad sectors
  discordWebhook: '',   // Full URL
  telegramWebhook: '',  // Format: BOT_TOKEN/CHAT_ID
  customWebhook: ''     // Generic POST URL
};

// Bandwidth history [{ time, rx, tx }]
let bandwidthHistory = [];

// Network devices
let networkDevices = {};

let sshConfigs = [];
let sshSessions = {}; // Map of hostId -> { conn, shell, socketId }
let prevNetStats = null;

// ─── Disk Health Prediction Engine ───────────────────────────────────────────
// Per-disk historical snapshots: { [serialNum]: { snapshots:[], riskHistory:[] } }
const diskHealthStore = {};
const diskIoStore = {}; // Per-disk IO counters: { [serial]: { rIO, wIO, rBytes, wBytes, time } }

/**
 * Intelligent Analysis Engine
 * Score a single disk based on SMART attributes + temperature trend.
 * Returns: { score: 0-100, risk: 'low'|'medium'|'critical', signs: [], actions: [], prediction }
 */
const analyzeDiskHealth = (disk, smart) => {
  const signs = [];      // early warning signs detected
  const actions = [];    // suggested preventive actions
  const patterns = [];   // detected abnormal patterns
  let demerits = 0;      // accumulated penalty points

  const serial = disk.serialNum || disk.name;
  if (!diskHealthStore[serial]) {
    diskHealthStore[serial] = { snapshots: [], riskHistory: [] };
  }
  const store = diskHealthStore[serial];

  const attrs = (smart && smart.attributes) ? smart.attributes : {};

  // Helper to extract raw values defensively
  const getRaw = (key) => parseInt((attrs[key] || {}).raw_value || (attrs[key] || {}).rawValue || (attrs[key] || {}).raw || 0);

  const rvRaw = getRaw('5') || getRaw('reallocated_sectors_count');
  const pvRaw = getRaw('197') || getRaw('current_pending_sector');
  const uvRaw = getRaw('198') || getRaw('offline_uncorrectable');
  const rwRaw = getRaw('1') || getRaw('raw_read_error_rate');
  const spinRaw = getRaw('10') || getRaw('spin_retry_count');
  const crcRaw = getRaw('199') || getRaw('udma_crc_error_count');
  const hours = getRaw('9') || getRaw('power_on_hours');
  const loadUnload = getRaw('193') || getRaw('load_cycle_count');

  // ── 1. SMART pass/fail ──────────────────────────────────────────────────
  if (smart && smart.status && smart.status !== 'PASSED') {
    demerits += 40;
    signs.push({ severity: 'critical', msg: `S.M.A.R.T. self-test FAILED (${smart.status})` });
    actions.push({ priority: 'immediate', title: 'Replace Disk', detail: 'Drive has definitively failed its manufacturer SMART test.' });
  }

  // ── 2. Reallocated / bad sectors ────────────────────────────────────────
  if (rvRaw > 0) {
    const sev = rvRaw > 10 ? 'critical' : rvRaw > 2 ? 'medium' : 'low';
    demerits += rvRaw > 10 ? 40 : rvRaw > 2 ? 20 : 10;
    signs.push({ severity: sev, msg: `${rvRaw} reallocated (bad) sector${rvRaw > 1 ? 's' : ''} detected` });
  }
  if (pvRaw > 0) {
    const sev = pvRaw > 5 ? 'critical' : 'medium';
    demerits += pvRaw > 5 ? 40 : 20;
    signs.push({ severity: sev, msg: `${pvRaw} sector${pvRaw > 1 ? 's' : ''} pending reallocation (unstable)` });
  }
  if (uvRaw > 0) {
    const sev = uvRaw > 3 ? 'critical' : 'medium';
    demerits += uvRaw > 3 ? 40 : 20;
    signs.push({ severity: sev, msg: `${uvRaw} offline-uncorrectable sector${uvRaw > 1 ? 's' : ''}` });
  }

  // ── 3. Read/Write errors ─────────────────────────────────────────────────
  if (rwRaw > 1000) {
    demerits += rwRaw > 100000 ? 30 : rwRaw > 10000 ? 15 : 5;
    signs.push({ severity: rwRaw > 100000 ? 'medium' : 'low', msg: `Elevated raw read error rate (${rwRaw.toLocaleString()})` });
  }
  if (crcRaw > 10) {
    demerits += 15;
    signs.push({ severity: 'medium', msg: `CRC Errors detected (${crcRaw}). Check SATA/Data cable.` });
    actions.push({ priority: 'soon', title: 'Check Connections', detail: 'UDMA CRC errors indicate a faulty data cable or loose connection.' });
  }

  // ── 4. Temperature ──────────────────────────────────────────────────────
  const temp = smart ? smart.temperature : (disk.temp !== 'N/A' ? parseInt(disk.temp) : null);
  if (temp && !isNaN(temp)) {
    if (temp >= 60) {
      demerits += 20;
      signs.push({ severity: 'critical', msg: `Dangerously high temperature: ${temp}°C (threshold 60°C)` });
      actions.push({ priority: 'immediate', title: 'Reduce Load / Cool Down', detail: `Temperature is critically high (${temp}°C). Improve cooling immediately to prevent hardware damage.` });
    } else if (temp >= 50) {
      demerits += 10;
      signs.push({ severity: 'medium', msg: `Elevated temperature: ${temp}°C (recommended <50°C)` });
      if (!actions.some(a => a.priority === 'immediate')) {
        actions.push({ priority: 'soon', title: 'Improve Airflow', detail: `Continuous high temperature (${temp}°C) drastically shortens drive lifespan.` });
      }
    } else if (temp >= 45) {
      demerits += 5;
      signs.push({ severity: 'low', msg: `Temperature approaching threshold: ${temp}°C` });
    }

    // Temperature trend: rising over last 10 snapshots?
    const temps = store.snapshots.slice(-10).map(s => s.temp).filter(t => t && !isNaN(t));
    if (temps.length >= 5) {
      const rise = temp - temps[0];
      if (rise >= 10) {
        demerits += 15;
        signs.push({ severity: 'medium', msg: `Temperature rising trend: +${rise}°C over last ${temps.length} readings` });
        patterns.push({ name: 'Thermal Runaway', desc: `Rapid heating detected (+${rise}°C). Check fans.` });
      } else if (rise >= 5) {
        demerits += 6;
        signs.push({ severity: 'low', msg: `Gradual temperature increase: +${rise}°C over recent readings` });
      }
    }
  }

  // ── 5. Mechanical / Spin issues ─────────────────────────────────────────
  if (spinRaw > 0) {
    demerits += spinRaw > 5 ? 20 : 10;
    signs.push({ severity: spinRaw > 5 ? 'medium' : 'low', msg: `Spin-up retry count: ${spinRaw}` });
    actions.push({ priority: 'soon', title: 'Check Power Supply', detail: 'Spin-up retries often indicate insufficient power supply or failing drive motor.' });
  }

  if (hours > 0 && loadUnload > 0) {
    const rate = loadUnload / hours;
    if (rate > 50) {
      demerits += 5;
      patterns.push({ name: 'Excessive Head Parking', desc: `Load/Unload cycles are extremely high (${Math.round(rate)}/hr).` });
      actions.push({ priority: 'monitor', title: 'Adjust APM settings', detail: 'Frequent head parking wears out mechanics. Disable aggressive power management.' });
    }
  }

  // ── 6. Health score trend (bad sector accumulation rate) ─────────────────
  const prevSnapshots = store.snapshots.slice(-5);
  if (prevSnapshots.length >= 3) {
    const prevDemerits = prevSnapshots.map(s => s.demerits);
    const avgPrev = prevDemerits.reduce((a, b) => a + b, 0) / prevDemerits.length;
    if (demerits - avgPrev >= 10) {
      signs.push({ severity: 'medium', msg: 'Rapid health score degradation detected over recent polls' });
      patterns.push({ name: 'Rapid Health Degradation', desc: 'Score dropped significantly in a short time frame.' });
    }
  }

  // ── Clamp and map to risk level ──────────────────────────────────────────
  const score = Math.max(0, Math.min(100, 100 - demerits));  // 100 = perfect

  let risk = 'low';
  if (score < 40) risk = 'critical';
  else if (score < 70) risk = 'medium';

  // Base preventative actions based on overall risk
  if (risk === 'critical') {
    actions.push({ priority: 'immediate', title: 'Backup Data Immediately', detail: 'Drive failure may be imminent. Stop usage and transfer all critical data to another medium.' });
    actions.push({ priority: 'immediate', title: 'Replace Disk', detail: 'Plan hardware replacement as soon as possible.' });
  } else if (risk === 'medium') {
    actions.push({ priority: 'soon', title: 'Ensure Backup Readiness', detail: 'Verify your latest backups are intact. Drive is showing signs of moderate wear.' });
  } else {
    actions.push({ priority: 'monitor', title: 'Normal Operation', detail: 'Drive is healthy. Continue standard usage and scheduled backups.' });
  }

  // Deduplicate actions by title
  const uniqueActions = [];
  const titles = new Set();
  for (const a of actions) {
    if (!titles.has(a.title)) {
      titles.add(a.title);
      uniqueActions.push(a);
    }
  }

  // Sort actions by priority (immediate > soon > monitor)
  const pWeight = { immediate: 3, soon: 2, monitor: 1 };
  uniqueActions.sort((a, b) => pWeight[b.priority] - pWeight[a.priority]);

  // ── Failure prediction engine ────────────────────────────────────────────
  // Use 4 risk levels: low / medium / high / critical
  let riskLevel = 'low';
  if (score < 30) riskLevel = 'critical';
  else if (score < 55) riskLevel = 'high';
  else if (score < 75) riskLevel = 'medium';

  let prediction = null;

  // ETA based on historical score degradation rate
  const snapHistory = store.snapshots.slice(-30);
  if (snapHistory.length >= 5) {
    const oldest = snapHistory[0].score;
    const newest = snapHistory[snapHistory.length - 1].score;
    const degradationPerPoll = (oldest - newest) / snapHistory.length;
    const pollIntervalMs = 3000; // 3s poll interval
    const pollsPerDay = (24 * 60 * 60 * 1000) / pollIntervalMs;

    // Estimate polls until score hits 0 (failure threshold)
    const pollsUntilFailure = degradationPerPoll > 0 ? newest / degradationPerPoll : Infinity;
    const daysUntilFailure = pollsUntilFailure / pollsPerDay;

    // Bad sector growth rate acceleration
    const recentDemerits = snapHistory.slice(-10).map(s => s.demerits);
    const avgRecentDemerits = recentDemerits.reduce((a, b) => a + b, 0) / recentDemerits.length;
    const isAccelerating = avgRecentDemerits > demerits * 0.8;

    // Synthesize ETA and confidence
    let etaWindow = null, confidence = 'Low', etaMsg = '';

    const critCount = store.riskHistory.filter(r => r === 'critical' || r === 'high').length;
    const medCount = store.riskHistory.filter(r => r === 'medium').length;

    if (riskLevel === 'critical' || critCount >= 5) {
      etaWindow = daysUntilFailure < 3 ? '< 24 hours' : daysUntilFailure < 14 ? '1–14 days' : '2–4 weeks';
      confidence = 'Very High';
      etaMsg = '🔴 Drive failure is imminent. Backup data immediately and replace drive.';
    } else if (riskLevel === 'high' || (critCount >= 2 && medCount >= 3)) {
      etaWindow = '3–8 weeks';
      confidence = 'High';
      etaMsg = '🟠 Drive showing serious degradation. Plan replacement within weeks.';
    } else if (riskLevel === 'medium' || medCount >= 5 || isAccelerating) {
      etaWindow = '2–6 months';
      confidence = 'Medium';
      etaMsg = '🟡 Moderate signs of wear. Monitor closely, verify backups.';
    } else if (medCount >= 2 || degradationPerPoll > 0.01) {
      etaWindow = '6–18 months';
      confidence = 'Low';
      etaMsg = '🟢 Early indicators detected. Continue monitoring regularly.';
    }

    if (etaWindow) {
      prediction = {
        window: etaWindow,
        confidence,
        msg: etaMsg,
        degradationRate: degradationPerPoll.toFixed(4),
        riskLevel,
        badSectorGrowth: (rvRaw + pvRaw + uvRaw),
        isAccelerating
      };
    }
  }

  // ── Persist snapshot ────────────────────────────────────────────────────
  store.snapshots.push({ time: new Date().toISOString(), demerits, score, temp: temp || null });
  if (store.snapshots.length > 120) store.snapshots.shift();

  store.riskHistory.push(riskLevel);
  if (store.riskHistory.length > 120) store.riskHistory.shift();

  return { score, risk: riskLevel, signs, patterns, actions: uniqueActions, prediction, demerits, analyzedAt: new Date().toISOString() };
};

// ─── Helpers ─────────────────────────────────────────────────────────────────
const logEvent = (type, message, details = {}, host = 'localhost') => {
  const event = { id: Date.now(), timestamp: new Date().toISOString(), type, message, host, details };
  eventLog.unshift(event);
  if (eventLog.length > 200) eventLog.pop();
  io.emit('new_event', event);
};

const hasDisksChanged = (oldDisks, newDisks) => {
  if (oldDisks.length !== newDisks.length) return true;
  for (let i = 0; i < oldDisks.length; i++) {
    if (oldDisks[i].serialNum !== newDisks[i].serialNum) return true;
  }
  return false;
};

const fireAlert = (type, message, host, meta = {}) => {
  io.emit('disk_alert', { type, message, host, ...meta, timestamp: new Date().toISOString() });
  logEvent(type, message, meta, host);

  // ── Dispatch Third-Party Webhooks ──
  // Only forward 'warning' or 'critical' alerts to avoid notification spam
  if (type === 'warning' || type === 'critical' || type === 'removed') {
    const icon = type === 'critical' ? '🚨' : type === 'warning' ? '⚠️' : 'ℹ️';
    const text = `${icon} **[${host}] TelemetryHub Alert:**\n${message}`;

    // Discord Payload
    if (alertThresholds.discordWebhook) {
      fetch(alertThresholds.discordWebhook, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ content: text })
      }).catch(err => console.error('[Webhook] Discord error:', err.message));
    }

    // Telegram Payload (Format expected: BOT_TOKEN/CHAT_ID)
    if (alertThresholds.telegramWebhook && alertThresholds.telegramWebhook.includes('/')) {
      const [token, chatId] = alertThresholds.telegramWebhook.split('/');
      const url = `https://api.telegram.org/bot${token}/sendMessage`;
      fetch(url, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ chat_id: chatId, text: text, parse_mode: 'Markdown' })
      }).catch(err => console.error('[Webhook] Telegram error:', err.message));
    }

    // Custom Generic Webhook
    if (alertThresholds.customWebhook) {
      fetch(alertThresholds.customWebhook, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          event: type,
          message: message,
          host: host,
          timestamp: new Date().toISOString(),
          meta: meta
        })
      }).catch(err => console.error('[Webhook] Custom error:', err.message));
    }
  }
};

// ─── Disk / System Polling ────────────────────────────────────────────────────
const pollDisks = async () => {
  try {
    const [disks, partitions, cpuLoad, mem, nets, disksIo, netIfaces, dockerContainers] = await Promise.all([
      si.diskLayout(),
      si.fsSize(),
      si.currentLoad(),
      si.mem(),
      si.networkStats(),
      si.disksIO(),
      si.networkInterfaces(),
      si.dockerContainers('all').catch(() => [])
    ]);

    const raidMap = {}; // device path -> raid info
    (raidZfsCache.raids || []).forEach(r => {
      (r.members || []).forEach(m => {
        raidMap[m.device] = { level: r.level, array: r.device, state: r.state };
      });
    });

    const zfsMap = {}; // Possibly map zfs members too if we can find them

    // ── Update Performance Metrics ──
    const now = Date.now();
    const disksIoArray = Array.isArray(disksIo) ? disksIo : (disksIo ? [disksIo] : []);
    const perfStats = disksIoArray.map(pio => {
      const id = pio.device;
      const prev = diskIoStore[id];
      const timeDelta = prev ? (now - prev.time) / 1000 : 0;

      let stats = { name: id, rIops: 0, wIops: 0, rSpeed: 0, wSpeed: 0, latency: 0, serialNum: '' };
      const dMatch = disks.find(d => d.device === id || d.name === id);
      if (dMatch) stats.serialNum = dMatch.serialNum;

      if (prev && timeDelta > 0) {
        stats.rIops = Math.max(0, (pio.rIO - prev.rIO) / timeDelta);
        stats.wIops = Math.max(0, (pio.wIO - prev.wIO) / timeDelta);
        stats.rSpeed = Math.max(0, (pio.rBytes - prev.rBytes) / timeDelta);
        stats.wSpeed = Math.max(0, (pio.wBytes - prev.wBytes) / timeDelta);

        // Estimate latency if tIO (time spent) is available
        const ioDelta = (pio.rIO + pio.wIO) - (prev.rIO + prev.wIO);
        const tDelta = (pio.tIO || 0) - (prev.tIO || 0);
        if (ioDelta > 0 && tDelta > 0) {
          stats.latency = tDelta / ioDelta; // ms per request
        } else if (ioDelta > 0) {
          // Fallback latency estimation based on speed if tIO is not supported on this OS
          stats.latency = (stats.rSpeed + stats.wSpeed) > 1e7 ? 2.5 : 0.8;
        }
      }

      diskIoStore[id] = { rIO: pio.rIO, wIO: pio.wIO, rBytes: pio.rBytes, wBytes: pio.wBytes, tIO: pio.tIO, time: now };
      return stats;
    });
    io.emit('performance_update', perfStats);

    console.log(`[POLL] Data: ${disks.length} disks | CPU: ${Math.round(cpuLoad.currentLoad)}% | IO: ${perfStats.length} monitored`);

    console.log(`[POLL] Found ${disks.length} disk(s) | ${partitions.length} partition(s)`);

    // ── SMART ──
    let smartData = [];
    if (typeof si.smartData === 'function') {
      smartData = await si.smartData().catch(() => []);
    }

    // ── Disk change detection ──
    if (initialized) {
      if (hasDisksChanged(currentDisks, disks)) {
        const removed = currentDisks.filter(od => !disks.find(nd => nd.serialNum === od.serialNum));
        const added = disks.filter(nd => !currentDisks.find(od => od.serialNum === nd.serialNum));
        removed.forEach(d => fireAlert('removed', `Drive removed: ${d.name || d.device}`, 'localhost', { disk: d }));
        added.forEach(d => fireAlert('added', `New drive detected: ${d.name || d.device}`, 'localhost', { disk: d }));
      }
    } else {
      initialized = true;
      logEvent('system', 'Local monitoring initialized', {}, 'localhost');
    }

    // ── Enrich disk data + health prediction ──
    currentDisks = disks.map(d => {
      const smart = Array.isArray(smartData) ? smartData.find(s => s.serialNum === d.serialNum) : null;
      const status = smart ? (smart.status === 'PASSED' ? 'OK' : 'ERROR') : 'OK';
      const temp = smart ? smart.temperature : null;

      // ── Run health analysis ──
      const health = analyzeDiskHealth(d, smart);

      // ── Smart Alerting System Logic ──
      const store = diskHealthStore[d.serialNum || d.name];
      if (store && store.snapshots.length > 0) {
        const lastSnap = store.snapshots[store.snapshots.length - 1];

        // 1. Health Score Drop detection
        const drop = lastSnap.score - health.score;
        if (drop >= alertThresholds.healthDrop && drop > 0) {
          fireAlert('critical',
            `⚠️ HEALTH DROP: ${d.name || d.device} score decreased by ${Math.round(drop)} points (now ${health.score}/100)`,
            'localhost', { disk: d.name, drop, current: health.score, prev: lastSnap.score });
        }

        // 2. Error Spike detection (demerits increase means new errors)
        const dSpike = health.demerits - lastSnap.demerits;
        if (dSpike >= alertThresholds.errorSpike && dSpike > 0) {
          fireAlert('warning',
            `🚨 ERROR SPIKE: New I/O errors or bad sectors detected on ${d.name || d.device}`,
            'localhost', { disk: d.name, demeritsIncrease: dSpike, totalDemerits: health.demerits });
        }
      }

      // 3. Overheating detection (legacy check remains but we consolidate)
      if (temp && temp >= alertThresholds.tempCelsius) {
        fireAlert('critical',
          `🔥 OVERHEATING: ${d.name || d.device} is at ${temp}°C (threshold: ${alertThresholds.tempCelsius}°C)`,
          'localhost', { disk: d.name, temp });
      }

      // ── Fire risk-level alerts (Legacy logic refined) ──
      if (health.risk === 'critical') {
        // Only alert critical risk every ~20 polls to avoid spam
        if (store && store.riskHistory.filter(r => r === 'critical').length % 20 === 1) {
          fireAlert('critical', `🚨 CRITICAL RISK: ${d.name || d.device} failure risk is EXTREME`, 'localhost', { disk: d.name, ...health });
        }
      } else if (health.risk === 'medium' && health.signs.length > 0) {
        if (store && store.riskHistory.filter(r => r === 'medium').length % 20 === 1) {
          fireAlert('warning', `⚠️ WEAR WARNING: ${d.name || d.device} showing signs of age (score: ${health.score})`, 'localhost', { disk: d.name, signs: health.signs });
        }
      }

      return {
        ...d,
        status,
        temp: temp || 'N/A',
        smartData: smart ? smart.attributes : null,
        raidInfo: raidMap[d.device] || raidMap[d.name] || null,
        health  // attach full health analysis
      };
    });
    currentPartitions = partitions;

    // ── Partition usage alerts ──
    partitions.forEach(p => {
      if (p.use > alertThresholds.diskUsage) {
        fireAlert('warning', `Critical: ${p.mount} is ${p.use}% full`, 'localhost', { mount: p.mount, use: p.use });
      }
    });

    // ── CPU / Mem alerts ──
    const cpuPct = Math.round(cpuLoad.currentLoad);
    const memPct = Math.round((mem.active / mem.total) * 100);
    if (cpuPct > alertThresholds.cpuLoad) {
      fireAlert('warning', `High CPU load: ${cpuPct}%`, 'localhost', { cpu: cpuPct });
    }
    if (memPct > alertThresholds.memUsage) {
      fireAlert('warning', `High memory usage: ${memPct}%`, 'localhost', { mem: memPct });
    }

    // ── Bandwidth calculation ──
    let rxMB = 0, txMB = 0, ifaceName = '';
    if (nets && nets.length > 0) {
      const iface = nets[0];
      ifaceName = iface.iface;
      if (prevNetStats) {
        const dt = (Date.now() - prevNetStats.time) / 1000;
        rxMB = Math.max(0, Math.round(((iface.rx_bytes - prevNetStats.rx) / 1024 / 1024 / dt) * 10) / 10);
        txMB = Math.max(0, Math.round(((iface.tx_bytes - prevNetStats.tx) / 1024 / 1024 / dt) * 10) / 10);

        if (rxMB > alertThresholds.rxSpike) {
          fireAlert('warning', `RX spike detected: ${rxMB} MB/s on ${ifaceName}`, 'localhost', { rxMB, ifaceName });
        }
        if (txMB > alertThresholds.txSpike) {
          fireAlert('warning', `TX spike detected: ${txMB} MB/s on ${ifaceName}`, 'localhost', { txMB, ifaceName });
        }
      }
      prevNetStats = { rx: iface.rx_bytes, tx: iface.tx_bytes, time: Date.now() };
    }

    // ── Bandwidth history (rolling 60 points) ──
    bandwidthHistory.push({ time: new Date().toLocaleTimeString(), rx: rxMB, tx: txMB });
    if (bandwidthHistory.length > 60) bandwidthHistory.shift();

    // ── Storage history ──
    const currentHost = hosts['localhost'] || {};
    const avgUsage = partitions.reduce((acc, p) => acc + (p.use || 0), 0) / (partitions.length || 1);
    const newHistory = [...(currentHost.history || []), {
      time: new Date().toLocaleTimeString(),
      usage: Math.round(avgUsage),
      cpu: cpuPct,
      mem: memPct
    }].slice(-60);

    hosts['localhost'] = {
      ...currentHost,
      name: 'Local Server',
      os: process.platform,
      disks: currentDisks,
      partitions: currentPartitions,
      smartData: currentDisks.map(d => ({
        name: d.name,
        device: d.device,
        type: d.type,
        protocol: d.interfaceType,
        smartStatus: d.status || 'Ok',
        temperature: d.temp,
        attributes: d.smartData || []
      })),
      perfData: perfStats,
      raidData: raidZfsCache.raids || [],
      zfsData: raidZfsCache.zfs || {},
      networkInterfaces: nets.map(n => {
        const info = (netIfaces || []).find(i => i.iface === n.iface) || {};
        return {
          iface: n.iface,
          ip4: info.ip4 || '',
          ip6: info.ip6 || '',
          mac: info.mac || '',
          speed: info.speed || 0,
          type: info.type || 'unknown',
          operstate: info.operstate || 'unknown',
          internal: info.internal || false,
          virtual: info.virtual || false,
          rx_sec: n.rx_sec || 0,
          tx_sec: n.tx_sec || 0,
          rx_bytes: n.rx_bytes || 0,
          tx_bytes: n.tx_bytes || 0,
        };
      }).filter(n => !n.internal),
      history: newHistory,
      lastUpdate: Date.now(),
      status: 'online',
      cpu: cpuPct,
      mem: memPct,
      memTotal: mem.total,
      memUsed: mem.active,
      network: { rx: rxMB, tx: txMB, iface: ifaceName },
      dockerContainers: dockerContainers || []
    };

    io.emit('hosts_update', hosts);
    io.emit('bandwidth_update', { history: bandwidthHistory, current: { rx: rxMB, tx: txMB, iface: ifaceName } });
    io.emit('disk_status', { disks: currentDisks, partitions, eventLog });
  } catch (err) {
    console.error('Poll error:', err.message);
    logEvent('error', `Polling failure: ${err.message}`, {});
  }
};

// ─── Network Device Discovery ─────────────────────────────────────────────────
const discoverNetworkDevices = async () => {
  try {
    const nets = await si.networkInterfaces();
    const ifaces = await si.networkStats();

    // Build device list from known interfaces
    nets.forEach(n => {
      if (!n.ip4 || n.ip4 === '127.0.0.1') return;
      const id = `net-${n.iface}`;
      networkDevices[id] = {
        id,
        name: n.iface,
        ip: n.ip4,
        mac: n.mac,
        type: n.virtual ? 'Virtual' : n.type || 'Physical',
        status: n.operstate === 'up' ? 'online' : 'offline',
        speed: n.speed || 0,
        mtu: n.mtu,
        lastSeen: Date.now()
      };
    });

    io.emit('network_devices', Object.values(networkDevices));
  } catch (err) {
    console.error('Network discovery error:', err.message);
  }
};

// ─── SSH Manager (Automated Deployer) ─────────────────────────────────────────
const scanSSH = (config) => {
  const conn = new Client();
  const hostId = `ssh-${config.host}`;
  const logStep = (msg, status = 'deploying') => {
    logEvent('system', `SSH [${config.name}]: ${msg}`, {}, hostId);
    if (!hosts[hostId]) hosts[hostId] = { name: config.name, history: [], connectionType: 'ssh' };
    hosts[hostId] = { ...hosts[hostId], status, lastUpdate: Date.now(), deployLog: msg };
    io.emit('hosts_update', hosts);
  };

  const remotePath = config.remotePath || '/opt/hdd-monitor';
  const nodeBin = 'node'; // Can be made configurable too

  logStep('Connecting to remote host...');

  conn.on('ready', () => {
    logStep('Connected. Checking requirements...');

    // Deployment Script: Create dir, write agent, setup systemd
    // TEMPLATE: Insert the HUB_URL (this server's IP)
    // We try to find our own IP or use hostname
    const HUB_IP = config.hubIp || '192.168.2.18';
    
    // Inject sudo password if necessary to prevent conn.exec from hanging
    const spwd = config.pass || config.password || '';
    const sudoPrefix = (spwd && config.user !== 'root') 
        ? `echo '${spwd.replace(/'/g, "'\\''")}' | sudo -S` 
        : (config.user === 'root' ? '' : 'sudo');
    
    const deployScript = `
      # 1. Dynamically locate the node binary (handles nvm, local installs, and system installs)
      NODE_PATH=$(which node 2>/dev/null || find ~/.nvm/versions/node -name "node" -type f -executable 2>/dev/null | sort -V | tail -n 1 || echo /usr/bin/node)
      NPM_PATH=$(which npm 2>/dev/null || find ~/.nvm/versions/node -name "npm" -type f -executable 2>/dev/null | sort -V | tail -n 1 || echo /usr/bin/npm)
      
      ${sudoPrefix} mkdir -p ${remotePath}
      ${sudoPrefix} sh -c "cd ${remotePath} && $NPM_PATH init -y && $NPM_PATH install socket.io-client systeminformation os-utils chokidar dotenv"
      
      ${sudoPrefix} curl -sSL http://${HUB_IP}:5010/api/agent/download -o ${remotePath}/agent.js
      ${sudoPrefix} curl -sSL http://${HUB_IP}:5010/api/agent/download/scanners -o ${remotePath}/scanners.js
      ${sudoPrefix} curl -sSL http://${HUB_IP}:5010/api/agent/download/latency-profiler -o ${remotePath}/latency-profiler.js
      
      # 2. Safely create the systemd unit file with the resolved NODE_PATH
      ${sudoPrefix} sh -c "cat << EOF > /etc/systemd/system/hdd-monitor.service
[Unit]
Description=TelemetryHub Enterprise Agent
After=network.target

[Service]
Type=simple
Environment=HUB_URL=http://${HUB_IP}:5010
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStart=$NODE_PATH ${remotePath}/agent.js
Restart=always
User=root

[Install]
WantedBy=multi-user.target
EOF"

      # 3. Reload and start the service
      ${sudoPrefix} systemctl daemon-reload
      ${sudoPrefix} systemctl enable hdd-monitor.service
      ${sudoPrefix} systemctl restart hdd-monitor.service
    `;

    conn.exec(deployScript, (err, stream) => {
      if (err) return logStep(`Deployment command failed: ${err.message}`, 'error');

      stream.on('close', (code) => {
        if (code === 0) {
          logStep('Agent deployed & service started successfully.', 'online');
          logEvent('success', `Remote agent deployed: ${config.name}`, {}, hostId);
        } else {
          logStep(`Deployment failed with code ${code}. Check sudo permissions.`, 'error');
        }
        conn.end();
      }).on('data', (data) => {
        console.log(`SSH [${config.name}] STDOUT: ${data}`);
      }).stderr.on('data', (data) => {
        console.log(`SSH [${config.name}] STDERR: ${data}`);
      });
    });

  }).on('error', err => {
    logStep(`SSH connection failed: ${err.message}`, 'error');
    if (hosts[hostId]) hosts[hostId].status = 'offline';
    io.emit('hosts_update', hosts);
  }).connect({
    host: config.host,
    port: config.port || 22,
    username: config.user || config.username,
    password: config.pass || config.password,
    readyTimeout: 10000
  });
};

// ─── RAID & ZFS Engine ───────────────────────────────────────────────────────
const { exec, spawn } = require('child_process');
const execAsync = (cmd) => new Promise((resolve) => {
  exec(cmd, { timeout: 8000 }, (err, stdout) => resolve(err ? '' : stdout));
});

let raidZfsCache = { raids: [], zfs: null, updatedAt: null };

const parseMdStat = (raw) => {
  if (!raw) return [];
  const blocks = raw.split('\n\n').filter(b => b.includes('md'));
  return blocks.map(block => {
    const lines = block.split('\n');
    const nameLine = lines.find(l => /^md\d+/.test(l));
    if (!nameLine) return null;
    const device = nameLine.match(/^(md\S+)/)?.[1] || 'md?';
    const level = nameLine.match(/raid(\d+)/i)?.[0]?.toUpperCase() || 'RAID?';
    const members = [];
    const memberRe = /([a-z]+\d+)\[(\d+)\](\(F\)|\(S\))?/g;
    let m;
    while ((m = memberRe.exec(nameLine)) !== null) {
      members.push({
        device: '/dev/' + m[1],
        slot: parseInt(m[2]),
        state: m[3] === '(F)' ? 'faulty' : m[3] === '(S)' ? 'spare' : 'active'
      });
    }
    const statusLine = lines.find(l => l.includes('blocks'));
    const totalDevices = parseInt(statusLine?.match(/(\d+) blocks/)?.[1]) || members.length;
    const activeDevices = parseInt(nameLine.match(/(\d+)\/(\d+)/)?.[1]) || members.filter(m => m.state === 'active').length;
    const failedDevices = members.filter(m => m.state === 'faulty').length;
    const spareDevices = members.filter(m => m.state === 'spare').length;

    // State detection
    let state = 'clean';
    if (failedDevices > 0 && activeDevices < totalDevices) state = 'degraded';
    const rebuildLine = lines.find(l => l.includes('recovery') || l.includes('resync'));
    let rebuildProgress = null, rebuildEta = null;
    if (rebuildLine) {
      state = 'rebuilding';
      const pctMatch = rebuildLine.match(/(\d+\.\d+)%/);
      const etaMatch = rebuildLine.match(/finish=(\S+)/);
      if (pctMatch) rebuildProgress = parseFloat(pctMatch[1]);
      if (etaMatch) rebuildEta = etaMatch[1];
    }

    const sizeMatch = statusLine?.match(/(\d+[\d,]*) blocks/);
    const sizeKb = sizeMatch ? parseInt(sizeMatch[1].replace(/,/g, '')) : 0;
    const size = sizeKb > 1048576 ? `${(sizeKb / 1048576).toFixed(1)} TB` : sizeKb > 1024 ? `${(sizeKb / 1024).toFixed(0)} GB` : `${sizeKb} KB`;

    return { device, level, state, activeDevices, totalDevices, failedDevices, spareDevices, members, rebuildProgress, rebuildEta, size };
  }).filter(Boolean);
};

const parseZfsStatus = async () => {
  const statusOut = await execAsync('zpool status -v');
  const listOut = await execAsync('zpool list -Hp -o name,size,alloc,free,capacity,health');
  if (!listOut) return null;

  // Parse pool list
  const poolMap = {};
  for (const line of listOut.trim().split('\n')) {
    const p = line.split('\t');
    if (p.length < 6) continue;
    const name = p[0], size = p[1], used = p[2], free = p[3], cap = p[4], health = p[5];
    const sizeN = parseFloat(size), usedN = parseFloat(used), freeN = parseFloat(free);
    const fmt = n => n > 1e12 ? `${(n / 1e12).toFixed(1)} TB` : n > 1e9 ? `${(n / 1e9).toFixed(1)} GB` : `${(n / 1e6).toFixed(0)} MB`;
    poolMap[name] = { name, size: fmt(sizeN), used: fmt(usedN), free: fmt(freeN), usedPct: parseInt(cap), health, readErrors: 0, writeErrors: 0, checksumErrors: 0, scrub: null };
  }

  // Parse scrub + error data from status output
  const poolBlocks = statusOut.split(/\n\s*pool:/g).slice(1);
  for (const block of poolBlocks) {
    const name = block.split('\n')[0].trim();
    if (!poolMap[name]) continue;
    // Read errors
    const errMatch = block.match(/(\d+)\s+(\d+)\s+(\d+)\s+\n/);
    if (errMatch) {
      poolMap[name].readErrors = parseInt(errMatch[1]);
      poolMap[name].writeErrors = parseInt(errMatch[2]);
      poolMap[name].checksumErrors = parseInt(errMatch[3]);
    }
    // Scrub
    const scrubLine = block.match(/scan:.*?(?:\n|$)/)?.[0] || '';
    if (scrubLine) {
      const errors = parseInt(scrubLine.match(/(\d+) errors/)?.[1] || '0');
      const repaired = scrubLine.match(/repaired (\S+)/)?.[1] || null;
      const date = scrubLine.match(/on (.+)$/)?.[1]?.trim() || null;
      const isRunning = scrubLine.includes('in progress');
      poolMap[name].scrub = {
        state: isRunning ? 'scrub in progress' : errors === 0 ? 'scrub completed (no errors)' : 'scrub completed (errors found)',
        errors,
        repaired,
        date
      };
    }
  }

  return { pools: Object.values(poolMap) };
};

const parseArcStats = async () => {
  const raw = await execAsync('cat /proc/spl/kstat/zfs/arcstats');
  if (!raw) return null;
  const get = (key) => {
    const m = raw.match(new RegExp(`^${key}\\s+\\d+\\s+(\\d+)`, 'm'));
    return m ? parseInt(m[1]) : 0;
  };
  const size = get('size');
  const max = get('c_max');
  const hits = get('hits');
  const misses = get('misses');
  const l2Size = get('l2_size');
  const total = hits + misses;
  const hitRatio = total > 0 ? ((hits / total) * 100).toFixed(1) : 'N/A';
  const fmt = n => n > 1e9 ? `${(n / 1e9).toFixed(1)} GB` : n > 1e6 ? `${(n / 1e6).toFixed(0)} MB` : `${n} B`;
  return { size: fmt(size), maxSize: fmt(max), hitRatio, l2Size: l2Size > 0 ? fmt(l2Size) : 'N/A' };
};

const pollRaidZfs = async () => {
  try {
    const mdstatRaw = await execAsync('cat /proc/mdstat');
    const raids = parseMdStat(mdstatRaw);
    const zfsPools = await parseZfsStatus();
    const arcStats = await parseArcStats();
    const zfs = zfsPools ? { ...zfsPools, arc: arcStats } : null;
    raidZfsCache = { raids, zfs, updatedAt: new Date().toISOString() };

    // Alert on degraded arrays
    raids.filter(r => r.state === 'degraded').forEach(r => {
      fireAlert('critical', `RAID array ${r.device} is DEGRADED — ${r.failedDevices} disk(s) failed!`, 'localhost', { device: r.device });
    });
    // Alert on ZFS errors
    (zfs?.pools || []).filter(p => (p.readErrors + p.writeErrors + p.checksumErrors) > 0).forEach(p => {
      fireAlert('warning', `ZFS pool "${p.name}" has errors: R:${p.readErrors} W:${p.writeErrors} CK:${p.checksumErrors}`, 'localhost', { pool: p.name });
    });

    io.emit('raid_zfs_update', raidZfsCache);
  } catch (e) { /* silently skip on unsupported OS */ }
};

// ─── Polling Intervals ────────────────────────────────────────────────────────
setInterval(pollDisks, 3000);
setInterval(discoverNetworkDevices, 10000);
setInterval(pollRaidZfs, 15000);
pollRaidZfs(); // run immediately on boot

// Check offline remote hosts
setInterval(() => {
  const now = Date.now();
  Object.keys(hosts).forEach(id => {
    if (id !== 'localhost' && now - hosts[id].lastUpdate > 20000 && hosts[id].status === 'online') {
      hosts[id].status = 'offline';
      logEvent('error', `Host went offline: ${hosts[id].name}`, {}, id);
      io.emit('hosts_update', hosts);
    }
  });
}, 5000);



