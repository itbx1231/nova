// Add SSH target — secured
app.post('/api/ssh/add', (req, res) => {
  const config = req.body;
  const hostId = `ssh-${config.host}`;
  const existingConfigIdx = sshConfigs.findIndex(c => `ssh-${c.host}` === hostId || c.host === config.host);
  
  if (existingConfigIdx >= 0) {
    sshConfigs[existingConfigIdx] = config;
  } else {
    sshConfigs.push(config);
  }
  
  // Save credentials to DB
  db.saveSshHost(config);

  if (!config.terminalOnly) {
    hosts[hostId] = {
      name: config.name,
      os: 'linux',
      disks: [], partitions: [], history: [],
      lastUpdate: Date.now(),
      status: 'deploying',
      connectionType: 'ssh'
    };
    scanSSH(config);
  }
  
  res.json({ success: true, hostId });
});

// Deploy agent to a new server via SSH (8-step with live deploy:log events)
// ─── Deployment State (per-host lock + session tracking) ─────────────────────
const deploymentSessions = new Map(); // hostId -> { conn, cancelled, timeout }

// ─── Production SSH Deployment Engine ────────────────────────────────────────
app.post('/api/ssh/deploy', (req, res) => {
  const config = req.body;
  if (!config || !config.host) return res.status(400).json({ error: 'host is required' });

  const hostId = `ssh-${config.host}`;

  if (deploymentSessions.has(hostId)) {
    return res.status(409).json({ error: 'Deployment already in progress for this host. Use /api/ssh/deploy/cancel/' + hostId + ' to cancel.' });
  }

  res.json({ success: true, hostId });
  _runDeployment(config, hostId).catch(e => console.error('[Deploy] Unhandled rejection:', e));
});

// Cancel a running deployment
app.post('/api/ssh/deploy/cancel/:hostId', (req, res) => {
  const session = deploymentSessions.get(req.params.hostId);
  if (!session) return res.status(404).json({ error: 'No active deployment' });
  session.cancelled = true;
  if (session.timeout) clearTimeout(session.timeout);
  if (session.conn) try { session.conn.end(); } catch(_) {}
  deploymentSessions.delete(req.params.hostId);
  io.emit('deploy:log', { hostId: req.params.hostId, msg: 'Deployment cancelled by user', pct: 100, level: 'warn', ts: new Date().toISOString() });
  res.json({ success: true });
});

async function _runDeployment(config, hostId) {
  const { Client } = require('ssh2');

  // ── Config ──────────────────────────────────────────────────────────────────
  const remotePath  = (config.remotePath || '/opt/nova-agent').replace(/\/+$/, '');
  const HUB_IP      = config.hubIp || '127.0.0.1';
  const hubUrl      = `http://${HUB_IP}:5010`;
  const rawPass     = config.pass || config.password || '';
  const isRoot      = (config.user === 'root');
  // Safely escape single-quotes in password for use inside 'echo ... | sudo -S'
  const escapedPass = rawPass.replace(/\\/g, '\\\\').replace(/'/g, "'\\''");
  const sudoPrefix  = (!isRoot && rawPass) ? `echo '${escapedPass}' | sudo -S` : (isRoot ? '' : 'sudo');
  const S           = (cmd) => sudoPrefix ? `${sudoPrefix} ${cmd}` : cmd;

  // ── Logging helper ───────────────────────────────────────────────────────────
  const log = (msg, pct, level = 'info') => {
    const session = deploymentSessions.get(hostId);
    if (session && session.cancelled) return;
    io.emit('deploy:log', { hostId, msg, pct, level, ts: new Date().toISOString() });
    console.log(`[Deploy:${hostId}] [${level.toUpperCase()}] ${msg}`);
  };

  // ── Session setup ────────────────────────────────────────────────────────────
  const session = { conn: null, cancelled: false, timeout: null };
  deploymentSessions.set(hostId, session);

  // Global 10-minute deployment timeout
  session.timeout = setTimeout(() => {
    if (!deploymentSessions.has(hostId)) return;
    log('Deployment timed out (10 min limit). Cancelling.', 100, 'error');
    session.cancelled = true;
    if (session.conn) try { session.conn.end(); } catch(_) {}
    deploymentSessions.delete(hostId);
  }, 10 * 60 * 1000);

  // ── Command executor with per-step timeout ───────────────────────────────────
  const run = (cmd, timeoutMs = 90_000) => new Promise((resolve, reject) => {
    if (session.cancelled) return reject(new Error('Cancelled'));
    const timer = setTimeout(() => reject(new Error(`Timed out after ${timeoutMs/1000}s: ${cmd.slice(0, 80)}`)), timeoutMs);
    session.conn.exec(cmd, (err, stream) => {
      if (err) { clearTimeout(timer); return reject(err); }
      let out = '', errOut = '';
      stream.on('data', d => { out += d.toString(); });
      stream.stderr.on('data', d => { errOut += d.toString(); });
      stream.on('close', code => {
        clearTimeout(timer);
        if (session.cancelled) return reject(new Error('Cancelled'));
        if (code !== 0) reject(new Error(errOut.trim() || out.trim() || `exit code ${code}`));
        else resolve(out.trim());
      });
    });
  });

  // Write file safely: decode b64 to /tmp (no sudo), then sudo mv to dest.
  // Avoids the stdin conflict when sudo -S is piped after base64 -d.
  const writeFile = async (remoteDest, fileContent) => {
    const b64 = Buffer.from(fileContent).toString('base64');
    const tmp = `/tmp/nova-deploy-${Date.now()}.tmp`;
    await run(`echo '${b64}' | base64 -d > ${tmp}`);
    await run(S(`mv ${tmp} ${remoteDest}`));
    await run(S(`chmod 644 ${remoteDest}`));
  };
  const writeFileDirect = writeFile; // alias for backward compat

  try {
    const conn = new Client();
    session.conn = conn;

    // ── STEP 1: SSH Connect ──────────────────────────────────────────────────
    log('Connecting via SSH...', 3);
    await new Promise((resolve, reject) => {
      conn.once('ready', resolve);
      conn.once('error', reject);
      conn.connect({
        host: config.host,
        port: parseInt(config.port) || 22,
        username: config.user || config.username || 'root',
        password: rawPass || undefined,
        privateKey: config.privateKey || undefined,
        readyTimeout: 20000,
        keepaliveInterval: 15000,
        keepaliveCountMax: 4,
      });
    });
    log('SSH connection established', 8);

    // ── STEP 2: OS/package-manager detection ────────────────────────────────
    log('Detecting OS and environment...', 10);
    const osRaw = await run("cat /etc/os-release 2>/dev/null | grep '^NAME' | cut -d= -f2 | tr -d '\"' || uname -s").catch(() => 'Linux');
    const pkgMgr = await run('which apt-get 2>/dev/null && echo apt || which yum 2>/dev/null && echo yum || which dnf 2>/dev/null && echo dnf || echo unknown').catch(() => 'unknown');
    log(`OS: ${osRaw.split('\n')[0]} | pkg: ${pkgMgr}`, 12);

    // Ensure curl is available
    const hasCurl = await run('which curl 2>/dev/null && echo yes || echo no').catch(() => 'no');
    if (!hasCurl.includes('yes')) {
      log('Installing curl...', 13);
      if (pkgMgr.includes('apt')) await run(S('apt-get install -y curl'), 120_000);
      else if (pkgMgr.includes('yum')) await run(S('yum install -y curl'), 120_000);
    }

    // ── STEP 3: Check / Install Node.js ──────────────────────────────────────
    log('Checking Node.js...', 15);
    let nodeBin = await run('which node 2>/dev/null || which nodejs 2>/dev/null').catch(() => '');
    if (nodeBin) {
      const nodeVer = await run(`${nodeBin} --version`).catch(() => '?');
      log(`Node.js found at ${nodeBin} (${nodeVer})`, 28);
    } else {
      log('Node.js missing — installing v20 LTS...', 18);
      try {
        if (pkgMgr.includes('apt')) {
          await run(S('bash -c "curl -fsSL https://deb.nodesource.com/setup_20.x | bash -"'), 180_000);
          await run(S('apt-get install -y nodejs'), 180_000);
        } else if (pkgMgr.includes('yum') || pkgMgr.includes('dnf')) {
          await run(S('bash -c "curl -fsSL https://rpm.nodesource.com/setup_20.x | bash -"'), 180_000);
          await run(S(`${pkgMgr.includes('dnf') ? 'dnf' : 'yum'} install -y nodejs`), 180_000);
        } else {
          // Fallback: install via volta or nvm
          await run('curl -fsSL https://fnm.vercel.app/install | bash - && export PATH="$HOME/.fnm:$PATH" && fnm install --lts', 300_000);
        }
        nodeBin = await run('which node 2>/dev/null || which nodejs 2>/dev/null');
        const ver = await run(`${nodeBin} --version`).catch(() => '?');
        log(`Node.js installed: ${ver} at ${nodeBin}`, 28);
      } catch (e) {
        throw new Error(`Node.js installation failed: ${e.message}`);
      }
    }

    // ── STEP 4: Create agent directory ───────────────────────────────────────
    log(`Creating directory ${remotePath}...`, 30);
    await run(`${S(`mkdir -p ${remotePath}`)} && ${S(`chmod 755 ${remotePath}`)}`);
    log('Directory ready', 38);

    // ── STEP 5: Download agent bundle from hub ───────────────────────────────
    log('Downloading agent bundle from hub...', 40);
    const agentDest = `${remotePath}/agent.js`;
    const dlOut = await run(
      `${S(`curl -fsSL "http://${HUB_IP}:5010/api/agent/download" -o ${agentDest}`)} && wc -c < ${agentDest}`,
      120_000
    );
    const agentBytes = parseInt((dlOut.match(/\d+/) || ['0'])[0]);
    if (agentBytes < 50_000) {
      throw new Error(`Agent bundle too small (${agentBytes} bytes) — hub download failed. Is port 5010 reachable from ${config.host}?`);
    }
    log(`Agent bundle downloaded — ${Math.round(agentBytes / 1024)} KB`, 55);

    // ── STEP 6: Write .env with hub credentials ──────────────────────────────
    log('Writing agent configuration...', 58);
    const agentSecret = AGENT_SECRET; // Use backend's module-level const (what socket auth middleware checks)
    const agentHostId = hostId; // must match fleet key: "ssh-<ip>"
    const envContent = [
      `HUB_URL=${hubUrl}`,
      `AGENT_SECRET=${agentSecret}`,
      `AGENT_TOKEN=${agentSecret}`,
      `HOST_ID=${agentHostId}`,
      `NODE_ENV=production`,
    ].join('\n') + '\n';
    await writeFile(`${remotePath}/.env`, envContent);
    log('.env written with hub credentials', 62);

    // ── STEP 7: Write systemd unit file ──────────────────────────────────────
    log('Installing systemd service...', 65);
    const unitContent = [
      '[Unit]',
      'Description=Nova TelemetryHub Edge Agent',
      'After=network-online.target',
      'Wants=network-online.target',
      '',
      '[Service]',
      'Type=simple',
      `WorkingDirectory=${remotePath}`,
      `Environment=AGENT_SECRET=${agentSecret}`,
      `Environment=AGENT_TOKEN=${agentSecret}`,
      `Environment=HUB_URL=${hubUrl}`,
      `Environment=HOST_ID=${agentHostId}`,
      `Environment=NODE_ENV=production`,
      `ExecStart=${nodeBin} ${agentDest}`,
      'Restart=on-failure',
      'RestartSec=10',
      'StartLimitIntervalSec=120',
      'StartLimitBurst=5',
      'StandardOutput=journal',
      'StandardError=journal',
      'SyslogIdentifier=nova-agent',
      '',
      '[Install]',
      'WantedBy=multi-user.target',
    ].join('\n') + '\n';
    const unitPath = '/etc/systemd/system/nova-agent.service';
    // Stop and unmask before overwriting (handles masked/conflicting units from prior runs)
    await run(S('systemctl stop nova-agent.service 2>/dev/null || true')).catch(() => {});
    await run(S('systemctl disable nova-agent.service 2>/dev/null || true')).catch(() => {});
    await run(S('systemctl unmask nova-agent.service 2>/dev/null || true')).catch(() => {});
    await writeFile(unitPath, unitContent);
    await run(S('systemctl daemon-reload'));
    await run(S('systemctl enable nova-agent.service'));
    log('Systemd service installed and enabled', 72);

    // ── STEP 8: Start / restart the service ──────────────────────────────────
    log('Starting nova-agent service...', 75);
    await run(S('systemctl restart nova-agent.service'), 30_000);
    await new Promise(r => setTimeout(r, 2000));

    const svcStatus = await run(S('systemctl is-active nova-agent.service')).catch(() => 'unknown');
    if (svcStatus.trim() !== 'active') {
      const journal = await run(S('journalctl -u nova-agent -n 15 --no-pager 2>/dev/null || true')).catch(() => '');
      log(`Service status: ${svcStatus.trim()}. Last logs:\n${journal}`, 80, 'warn');
    } else {
      log('nova-agent.service is active', 80);
    }

    // ── STEP 9: Wait for agent heartbeat ─────────────────────────────────────
    log('Waiting for agent to phone home (up to 30s)...', 82);
    const heartbeat = await new Promise(resolve => {
      let tries = 0;
      const poll = () => {
        const h = hosts[hostId];
        if (h && h.connectionType === 'agent_push' && h.status === 'online') {
          return resolve(true);
        }
        if (++tries >= 15) return resolve(false);
        setTimeout(poll, 2000);
      };
      setTimeout(poll, 3000);
    });

    if (heartbeat) {
      log('Agent heartbeat confirmed — deployment complete!', 100, 'success');
    } else {
      // Get diagnostics
      const agentLog = await run(S('journalctl -u nova-agent -n 10 --no-pager 2>/dev/null || true')).catch(() => '');
      const connTest = await run(`curl -sf "http://${HUB_IP}:5010/api/health" -o /dev/null && echo reachable || echo unreachable`).catch(() => 'error');
      log(
        `Agent started but no heartbeat yet.\nHub reachability: ${connTest}\nAgent log tail:\n${agentLog}\n\nCheck: journalctl -u nova-agent -f`,
        100, 'warn'
      );
    }

    // ── Register host in fleet ────────────────────────────────────────────────
    if (!hosts[hostId] || hosts[hostId].connectionType !== 'agent_push') {
      hosts[hostId] = {
        name: config.name || config.host,
        os: 'linux', disks: [], partitions: [], history: [],
        lastUpdate: Date.now(), status: heartbeat ? 'online' : 'deploying',
        connectionType: 'ssh',
      };
    }
    if (!sshConfigs.find(c => c.host === config.host)) sshConfigs.push(config);
    db.saveSshHost(config);
    io.emit('hosts_update', hosts);

  } catch (e) {
    if (!session.cancelled) {
      log(`Deployment failed: ${e.message}`, 100, 'error');
    }
  } finally {
    clearTimeout(session.timeout);
    deploymentSessions.delete(hostId);
    if (session.conn) try { session.conn.end(); } catch(_) {}
  }
}


// Remove SSH target
app.delete('/api/ssh/delete/:host', (req, res) => {
  const host = req.params.host;
  sshConfigs = sshConfigs.filter(c => c.host !== host);
  db.deleteSshHost(host);
  const hostId = `ssh-${host}`;
  if (hosts[hostId]) {
    delete hosts[hostId];
    io.emit('hosts_update', hosts);
    // Note: Standard background polling for this hostId may throw errors, 
    // but the system recovers gracefully. Ideally we'd abort but this is out of scope.
  }
  res.json({ success: true });
});

// Remove host
app.delete('/api/hosts/:id', (req, res) => {
  const hostId = req.params.id;
  if (hostId === 'localhost') return res.status(403).json({ error: 'Cannot remove local hub server' });

  // 1. Cleanup SSH session if active
  if (sshSessions[hostId]) {
    if (sshSessions[hostId].shell) sshSessions[hostId].shell.end();
    if (sshSessions[hostId].conn) sshSessions[hostId].conn.end();
    delete sshSessions[hostId];
  }

  // 2. Remove from sshConfigs if exist
  const ipToRemove = hostId.replace('ssh-', '');
  sshConfigs = sshConfigs.filter(c => c.host !== ipToRemove);
  db.deleteSshHost(ipToRemove);

  // 3. Remove Host entry
  delete hosts[hostId];

  logEvent('system', `Node removed from fleet: ${hostId}`, {});
  io.emit('hosts_update', hosts);
  res.json({ success: true });
});

// Agent reporting
app.post('/api/report', (req, res) => {
  const { hostId, hostname, os, disks, partitions, cpu, mem, event, network, smartData, perfData, raidData, zfsData, dockerContainers } = req.body;
  if (!hosts[hostId]) logEvent('system', `New agent connected: ${hostname}`, { os }, hostId);

  const currentHost = hosts[hostId] || { history: [] };
  const avgUsage = (partitions || []).reduce((a, p) => a + (p.use || 0), 0) / ((partitions || []).length || 1);
  const newHistory = [...(currentHost.history || []), { time: new Date().toLocaleTimeString(), usage: Math.round(avgUsage), cpu: cpu || 0, mem: mem || 0 }].slice(-60);

  // 1. Process SMART & Health
  const enrichedDisks = (disks || []).map(d => {
    let health = { score: 100, risk: 'low', signs: [], actions: [], prediction: null, demerits: 0 };
    if (smartData) {
      const smart = smartData.find(s => s.device === d.device);
      if (smart) {
        health = analyzeDiskHealth(d, smart);

        // Smart Alerting for Remote Agents
        const store = diskHealthStore[d.serial || d.name];
        if (store && store.snapshots.length > 0) {
          const drop = store.snapshots[store.snapshots.length - 1].score - health.score;
          if (drop >= alertThresholds.healthDrop && drop > 0) {
            fireAlert('critical', `⚠️ HEALTH DROP: ${hostname} - ${d.name} score decreased by ${Math.round(drop)} points`, hostId, { disk: d.name, drop });
          }
        }
      }
    }
    return { ...d, health, status: health.risk === 'critical' ? 'ERROR' : 'OK' };
  });

  // 2. Broadcast Performance Data
  if (perfData && perfData.length > 0) {
    const perfStats = perfData.map(p => ({
      name: p.device,
      serialNum: enrichedDisks.find(d => d.device === p.device)?.serial || '',
      rIops: p.rIops,
      wIops: p.wIops,
      rSpeed: p.rSpeed,
      wSpeed: p.wSpeed,
      latency: p.latency,
      host: hostname // Tag with agent name
    }));
    io.emit('performance_update', perfStats);
  }

  // 3. Identity Merging & Context Inheritance
  // If an SSH host exists with the current IP or hostname, merge them
  let mergedId = hostId;
  const existingSshHost = Object.keys(hosts).find(id => {
    return id.startsWith('ssh-') && (id.includes(hostname) || hostname.includes(id.replace('ssh-', '')));
  });
  
  if (existingSshHost) {
     mergedId = existingSshHost;
     logEvent('system', `Merged agent identity with SSH context: ${hostname}`, {}, mergedId);
  }

  hosts[mergedId] = {
    name: hostname,
    os,
    disks: enrichedDisks,
    partitions: partitions || [],
    history: newHistory,
    lastUpdate: Date.now(),
    status: 'online',
    connectionType: existingSshHost ? 'ssh' : 'agent',
    cpu: cpu || 0,
    mem: mem || 0,
    network: network || { rx: 0, tx: 0 },
    storageData: {
      raid: raidData || [],
      zfs: zfsData || null
    },
    dockerContainers: dockerContainers || []
  };

  (partitions || []).forEach(p => {
    if (p.use > alertThresholds.diskUsage) fireAlert('warning', `Agent ${hostname}: ${p.mount} at ${p.use}%`, hostId, { mount: p.mount, use: p.use });
  });
  if (cpu > alertThresholds.cpuLoad) fireAlert('warning', `Agent ${hostname}: High CPU ${cpu}%`, hostId, { cpu });
  if (event) { logEvent(event.type, event.message, event.details || {}, hostId); }

  io.emit('hosts_update', hosts);
  res.json({ success: true });
});

// ─── Socket.io ────────────────────────────────────────────────────────────────

// Socket.io authentication middleware
io.use((socket, next) => {
  const auth = socket.handshake.auth || {};
  // Agents must provide valid agent token
  if (auth.role === 'agent') {
    if (auth.token === AGENT_SECRET) {
      socket.isAgent = true;
      return next();
    }
    console.warn(`[SECURITY] Rejected agent connection with invalid token from ${socket.handshake.address}`);
    return next(new Error('Invalid agent token'));
  }
  // UI clients: validate JWT if provided
  if (auth.token) {
    try {
      socket.user = jwt.verify(auth.token, JWT_SECRET);
    } catch { /* viewer without auth — read-only events only */ }
  }
  next();
});

io.on('connection', (socket) => {
  console.log(`Client connected: ${socket.id} [${socket.isAgent ? 'AGENT' : 'UI'}]`);
  socket.emit('hosts_update', hosts);
  socket.emit('bandwidth_update', { history: bandwidthHistory, current: bandwidthHistory[bandwidthHistory.length - 1] || { rx: 0, tx: 0 } });
  socket.emit('network_devices', Object.values(networkDevices));
  socket.emit('raid_zfs_update', raidZfsCache);

  // ─── Edge Agent Handlers ───
  socket.on('agent:register', (info) => {
    const hostId = socket.handshake.auth?.hostId || `agent-${socket.id.substring(0,6)}`;
    socket.hostId = hostId;
    socket.isAgent = true;
    console.log(`[Hub] Edge Agent Registered: ${hostId}`);
    hosts[hostId] = {
      name: `Agent: ${info.hostname}`,
      os: info.platform,
      disks: [], partitions: [], history: [],
      lastUpdate: Date.now(), status: 'online',
      connectionType: 'agent_push', cpu: 0, mem: 0,
      network: { rx: 0, tx: 0, iface: '' }
    };
    io.emit('hosts_update', hosts);
  });

  socket.on('agent:telemetry:push', (payload) => {
    const hostId = socket.hostId;
    if (!hostId || !hosts[hostId]) return;

    hosts[hostId].lastUpdate     = Date.now();
    hosts[hostId].status         = 'online';
    hosts[hostId].cpu            = payload.cpu || 0;
    hosts[hostId].mem            = payload.mem || 0;
    hosts[hostId].network        = payload.network || { rx: 0, tx: 0, iface: '' };
    hosts[hostId].disks          = payload.disks || [];
    hosts[hostId].partitions     = payload.partitions || [];
    hosts[hostId].raidArrays     = payload.raidArrays || [];
    hosts[hostId].lvm            = payload.lvm || null;
    hosts[hostId].virtualization = payload.virtualization || null;
    hosts[hostId].ioStats        = payload.ioStats || [];

    io.emit('hosts_update', hosts);

    // Push live IO stream to any UI client currently watching this host
    Array.from(io.sockets.sockets.values()).forEach(s => {
      if (s.watchingHostId === hostId && !s.isAgent) {
        s.emit('disk:io:live', {
          hostId,
          ioStats: payload.ioStats || [],
          disks: payload.disks || [],
          partitions: payload.partitions || [],
          cpu: payload.cpu || 0,
          mem: payload.mem || 0,
          ts: Date.now()
        });
      }
    });
  });

  socket.on('agent:scan:progress', ({ jobId, diskName, progress }) => {
    io.emit('scan:progress', { jobId, hostId: socket.hostId, diskName, progress });
  });

  socket.on('agent:scan:result', ({ jobId, diskName, type, result }) => {
    io.emit('scan:complete', { jobId, hostId: socket.hostId, diskName, result, failed: result.failed || false });
  });

  // ── Live disk watch subscriptions from UI clients ──
  socket.on('disk:watch:start', ({ hostId }) => {
    socket.watchingHostId = hostId || null;
  });
  socket.on('disk:watch:stop', () => {
    socket.watchingHostId = null;
  });

  // ── Scan log events forwarded to watching UI clients ──
  socket.on('agent:scan:log', ({ jobId, level, message }) => {
    const hid = socket.hostId;
    if (!hid) return;
    Array.from(io.sockets.sockets.values()).forEach(s => {
      if (s.watchingHostId === hid && !s.isAgent) {
        s.emit('scan:log', { jobId, hostId: hid, level, message, ts: Date.now() });
      }
    });
  });

  socket.on('run_scan', async (hostId) => {
    if (hostId === 'localhost') {
      await pollDisks();
      socket.emit('scan_complete', { hostId: 'localhost' });
    }
  });

  socket.on('set_thresholds', (thresholds) => {
    alertThresholds = { ...alertThresholds, ...thresholds };
    logEvent('system', 'Thresholds updated via UI', alertThresholds);
    io.emit('thresholds_update', alertThresholds);
  });

  socket.on('disconnect', () => {
    console.log('Client disconnected:', socket.id);
    // FIX #9: Detach socket but start idle timer — do NOT kill session
    Object.keys(sshSessions).forEach(id => {
      if (sshSessions[id].socketId === socket.id) {
        sshSessions[id].socketId = null;
        // Auto-kill if unused for 30 minutes
        if (sshSessions[id].idleTimer) clearTimeout(sshSessions[id].idleTimer);
        sshSessions[id].idleTimer = setTimeout(() => {
          const s = sshSessions[id];
          if (s && !s.socketId && !s.killed) {
            console.log(`[Hub] Auto-killing idle session for ${id} (30min timeout)`);
            if (s.local && s.shell) s.shell.kill();
            else { if (s.shell) s.shell.end(); if (s.conn) s.conn.end(); }
            s.killed = true;
            delete sshSessions[id];
          }
        }, 30 * 60 * 1000);
      }
    });
  });

  // ─── Real-time SSH Shell (Persistent) ──────────────────────────────────────
  socket.on('ssh_shell_start', async (hostId) => {
    console.log(`[SSH] ssh_shell_start received for hostId="${hostId}" from socket=${socket.id}`);
    // 1. Restore Existing Session if already running in the background
    const existingSession = sshSessions[hostId];
    if (existingSession && existingSession.shell && !existingSession.killed) {
      console.log(`[Hub] Restoring persistent terminal session for ${hostId}`);
      existingSession.socketId = socket.id;
      // FIX #9: Clear idle timer since user reconnected
      if (existingSession.idleTimer) { clearTimeout(existingSession.idleTimer); existingSession.idleTimer = null; }
      if (existingSession.history) {
        // FIX #8: Send ANSI reset before replaying history to avoid broken terminal colors
        socket.emit('ssh_shell_output', { hostId, data: '\x1b[0m' + existingSession.history });
      }
      return;
    }

    // FIX #2: Race Condition guard — prevent duplicate concurrent session creation
    if (existingSession && existingSession.starting) {
      console.warn(`[Hub] Session for ${hostId} is already starting. Ignoring duplicate.`);
      return;
    }

    // Lock: Mark as starting to block concurrent requests for same hostId
    sshSessions[hostId] = { starting: true, history: '', idleTimer: null };

    // Helper: line-based buffer (FIX #8) + stream to active socket
    const handleOutput = (d) => {
      const session = sshSessions[hostId];
      if (!session) return;
      const str = d.toString('utf8');
      session.history += str;
      // FIX #8: Keep last 1500 lines to avoid mid-line ANSI sequence breaks
      const lines = session.history.split('\n');
      if (lines.length > 1500) {
        session.history = lines.slice(-1500).join('\n');
      }
      if (session.socketId) {
        io.to(session.socketId).emit('ssh_shell_output', { hostId, data: str });
      }
    };

    if (hostId === 'localhost') {
       const isWindows = process.platform === 'win32';
       const shellCmd = isWindows ? 'powershell.exe' : '/bin/bash';
       const shellArgs = isWindows ? [] : ['--login'];
       const shellProc = spawn(shellCmd, shellArgs, { stdio: ['pipe', 'pipe', 'pipe'] });
       sshSessions[hostId] = { shell: shellProc, socketId: socket.id, local: true, history: '', idleTimer: null };

       shellProc.stdout.on('data', handleOutput);
       shellProc.stderr.on('data', handleOutput);
       shellProc.on('close', () => {
         if (sshSessions[hostId] && sshSessions[hostId].socketId) io.to(sshSessions[hostId].socketId).emit('ssh_shell_closed', hostId);
         if (sshSessions[hostId]) sshSessions[hostId].killed = true;
         delete sshSessions[hostId];
       });
       return;
    }

    let config = sshConfigs.find(c => `ssh-${c.host}` === hostId);
    console.log(`[SSH] sshConfigs has ${sshConfigs.length} entries. Lookup result: ${config ? 'FOUND ' + config.host : 'NOT FOUND'}`);
    // Fallback: reload from DB if not in memory
    if (!config) {
      try {
        const dbHosts = await db.getSshHosts();
        sshConfigs = dbHosts;
        config = dbHosts.find(c => `ssh-${c.host}` === hostId);
        console.log(`[SSH] DB fallback: ${dbHosts.length} hosts loaded. Lookup: ${config ? 'FOUND ' + config.host : 'STILL NOT FOUND'}`);
      } catch(e) { console.warn('[Hub] DB fallback failed:', e.message); }
    }
    if (!config) {
      console.error(`[SSH] FATAL: No config found for hostId="${hostId}". Available hosts: ${sshConfigs.map(c => c.host).join(', ')}`);
      delete sshSessions[hostId]; // FIX #2: Release starting lock
      return socket.emit('ssh_shell_error', 'Host configuration not found.');
    }
    console.log(`[SSH] Connecting to ${config.host}:${config.port || 22} as ${config.user}`);

    const conn = new Client();
    conn.on('ready', () => {
      conn.shell({ term: 'xterm-256color', rows: 30, cols: 100 }, (err, stream) => {
        if (err) {
          delete sshSessions[hostId]; // FIX #2: Release on error
          return socket.emit('ssh_shell_error', `Shell Error: ${err.message}`);
        }

        sshSessions[hostId] = { conn, shell: stream, socketId: socket.id, history: '', idleTimer: null };

        stream.on('data', handleOutput).on('close', () => {
          if (sshSessions[hostId] && sshSessions[hostId].socketId) {
            io.to(sshSessions[hostId].socketId).emit('ssh_shell_closed', hostId);
          }
          if (sshSessions[hostId]) sshSessions[hostId].killed = true;
          delete sshSessions[hostId];
        });
      });
    }).on('error', (err) => {
      delete sshSessions[hostId]; // FIX #2: Release lock on connection error
      socket.emit('ssh_shell_error', `Connection Error: ${err.message}`);
    }).connect({
      host: config.host,
      port: config.port || 22,
      username: config.user || config.username,
      password: config.pass || config.password,
      readyTimeout: 15000,
      keepaliveInterval: 10000
    });
  });

  // FIX #4: PTY Resize — sync terminal dimensions with remote shell on browser window resize
  socket.on('ssh_shell_resize', ({ hostId, cols, rows }) => {
    const session = sshSessions[hostId];
    if (!session || session.killed || session.local || session.starting) return;
    try {
      if (session.shell && typeof session.shell.setWindow === 'function') {
        session.shell.setWindow(rows, cols, 0, 0);
      }
    } catch (e) {
      console.error('[Hub] PTY resize error:', e.message);
    }
  });

  socket.on('ssh_shell_data', ({ hostId, data }) => {
    const session = sshSessions[hostId];
    if (session && session.shell) {
      try {
        if (session.local) {
           if (!session.killed) session.shell.stdin.write(data);
        } else {
           if (!session.killed) session.shell.write(data);
        }
      } catch (err) {
        console.error('Socket Shell Write Error:', err.message);
      }
    }
  });

  socket.on('ssh_shell_stop', (hostId) => {
    const session = sshSessions[hostId];
    if (session) {
      session.killed = true;
      if (session.idleTimer) clearTimeout(session.idleTimer);
      if (session.local) {
         if (session.shell) session.shell.kill();
      } else {
         if (session.shell) session.shell.end();
         if (session.conn) session.conn.end();
      }
      delete sshSessions[hostId];
    }
  });
});

// ─── Persistence & Auto-Healing ──────────────────────────────────────────────
const dispatchAlert = async (msg) => {
  try {
    const webhooks = await db.getWebhooks();
    webhooks.filter(w => w.enabled).forEach(async (w) => {
      if (w.type === 'discord') {
         await axios.post(w.url, { content: `🚨 **TelemetryHub Alert**: ${msg}` });
      } else if (w.type === 'telegram') {
         const url = `https://api.telegram.org/bot${w.token}/sendMessage`;
         await axios.post(url, { chat_id: w.chatId, text: `🚨 TelemetryHub Alert:\n${msg}` });
      }
    });
  } catch (e) { console.error('[Alert] Dispatch error:', e.message); }
};

setInterval(async () => {
  // 1. Save History for all online nodes
  Object.keys(hosts).forEach(id => {
    const h = hosts[id];
    if (h.status === 'online') {
      db.saveHistory(id, { 
        cpu: h.cpu, 
        mem: h.mem, 
        network: h.network 
      });
    }
  });

  // 2. Prune old data (7 days)
  db.pruneHistory();

  // 3. Evaluate Auto-Healing Rules
  try {
    const rules = await db.getRules();
    rules.filter(r => r.enabled).forEach(rule => {
      const h = hosts[rule.hostId];
      if (!h || h.status !== 'online') return;

      let trigger = false;
      if (rule.metric === 'cpu' && h.cpu > rule.threshold) trigger = true;
      if (rule.metric === 'mem' && h.mem > rule.threshold) trigger = true;

      if (trigger) {
        db.logEvent(rule.hostId, 'auto-healing', `Triggered: ${rule.name}. Running: ${rule.action}`);
        const session = sshSessions[rule.hostId];
        if (session && session.conn) {
          session.conn.exec(rule.action, (err, stream) => {
            if (err) console.error('[Auto-Healing] Exec error:', err);
            else stream.on('close', () => console.log('[Auto-Healing] Action completed.'));
          });
        }
      }
    });
  } catch (e) { console.error('[Auto-Healing] Error:', e.message); }
}, 60000); // 1 minute

// ─── Deep Disk Diagnostics APIs ─────────────────────────────────────────────
const executeGhostPayload = (hostId, basePayloadName, winArgs, linArgs) => {
  return new Promise((resolve, reject) => {
    // Local Hub Execution
    if (hostId === 'localhost') {
      if (process.platform === 'linux') {
        const linCmd = (basePayloadName === 'raw') ? linArgs
          : (basePayloadName === 'smartctl') ? ('smartctl ' + linArgs)
          : (require('path').join(__dirname, 'payloads', basePayloadName + '-linux') + ' ' + linArgs);
        require('child_process').exec(linCmd, { timeout: 15000 }, (err, stdout) => resolve(stdout || ''));
        return;
      }
      if (basePayloadName === 'raw') {
        require('child_process').exec(`powershell -Command "${winArgs.replace(/"/g, '\\"')}"`, (err, stdout) => resolve(stdout || ''));
        return;
      }
      if (basePayloadName === 'smartctl') {
        require('child_process').exec(`powershell -Command "smartctl ${winArgs}"`, (err, stdout) => resolve(stdout || ''));
        return;
      }
      const localPath = path.join(__dirname, 'payloads', `${basePayloadName}.exe`);
      require('child_process').exec(`powershell -Command "& '${localPath}' ${winArgs}"`, (err, stdout) => resolve(stdout || ''));
      return;
    }

    const config = sshConfigs.find(c => `ssh-${c.host}` === hostId);
    if (!config) return reject(new Error('SSH Configuration not tied to this host.'));

    const conn = new Client();
    conn.on('ready', () => {
      // Step 1: Detect Target OS
      conn.exec('uname', (err, stream) => {
        let isLinux = false;
        if (!err) {
          stream.on('data', (d) => { if (d.toString().toLowerCase().includes('linux')) isLinux = true; });
        }
        
        stream.on('close', () => {
           // Step 2: Push relevant payload or execute raw
           const args = isLinux ? linArgs : winArgs;

           if (basePayloadName === 'raw') {
             conn.exec(args, (err, stream2) => {
                let output = '';
                if (err) { conn.end(); return reject(err); }
                stream2.on('data', d => output += d).on('close', () => { conn.end(); resolve(output); });
             });
             return;
           }

           const payloadName = isLinux ? `${basePayloadName}-linux` : `${basePayloadName}.exe`;
           
           conn.sftp((err, sftp) => {
             if (err) { conn.end(); return reject(err); }

             const localFile = path.join(__dirname, 'payloads', payloadName);
             if (!fs.existsSync(localFile)) { conn.end(); return reject(new Error(`Payload [${payloadName}] missing inside Hub.`)); }

             const remoteFileName = `/tmp/ghost_${Date.now()}_${payloadName}`;

             sftp.fastPut(localFile, remoteFileName, (err) => {
                if (err) { conn.end(); return reject(err); }

                const execCmd = !isLinux ? `powershell -Command "& '${remoteFileName}' ${args}"` : `chmod +x ${remoteFileName} && ${remoteFileName} ${args}`;
                const delCmd = !isLinux ? `del /F /Q "${remoteFileName}"` : `rm -f ${remoteFileName}`;

                conn.exec(execCmd, (err, stream) => {
                   let output = '';
                   if (err) return conn.exec(delCmd, () => { conn.end(); reject(err); }); 
                   
                   stream.on('data', (d) => output += d ).on('close', () => {
                      // GHOST: Clean up instantly
                      conn.exec(delCmd, () => {
                         conn.end();
                         resolve(output);
                      });
                   });
                });
             });
           });
        });
      });
    }).on('error', err => reject(err)).connect({
      host: config.host, port: config.port || 22, username: config.username, password: config.password, privateKey: config.privateKey
    });
  });
};

// ─── Ghost Engine Abstraction ───────────────────────────────────────────────
const executeInvisibleSmartPoll = async (hostId, diskName) => {
  // ── Fast path: localhost on Windows/Linux — use systeminformation directly ──
  if (hostId === 'localhost') {
    try {
      const [disks, smartArr] = await Promise.all([
        si.diskLayout().catch(() => []),
        si.smartData ? si.smartData().catch(() => []) : Promise.resolve([])
      ]);

      // Find matching disk
      const disk = disks.find(d =>
        d.name === diskName || d.device === diskName ||
        (d.device && d.device.replace(/\\\\.\\/, '') === diskName)
      ) || disks[0];

      if (!disk) {
        return { success: false, error: `Disk '${diskName}' not found in layout` };
      }

      const smart = Array.isArray(smartArr)
        ? (smartArr.find(s => s.serialNum === disk.serialNum) || smartArr[0])
        : null;

      const attrs = (smart && smart.attributes) ? smart.attributes : {};
      const isVirtualDisk = Object.keys(attrs).length === 0;

      // Helper to read a SMART attribute — checks by key name (any case) or by id
      const readAttr = (names, ids) => {
        for (const n of (names || [])) {
          const k = Object.keys(attrs).find(k => k.toLowerCase() === n.toLowerCase());
          if (k && attrs[k]) {
            const v = attrs[k].raw_value ?? attrs[k].rawValue ?? attrs[k].raw ?? attrs[k].value;
            const parsed = parseInt(String(v).replace(/[^0-9]/g, ''), 10);
            if (!isNaN(parsed)) return parsed;
          }
        }
        for (const id of (ids || [])) {
          const k = Object.keys(attrs).find(k => String(k) === String(id) || k.startsWith(`${id}_`) || k.startsWith(`${id} `));
          if (k && attrs[k]) {
            const v = attrs[k].raw_value ?? attrs[k].rawValue ?? attrs[k].raw ?? attrs[k].value;
            const parsed = parseInt(String(v).replace(/[^0-9]/g, ''), 10);
            if (!isNaN(parsed)) return parsed;
          }
        }
        return isVirtualDisk ? 0 : 'N/A';
      };

      const isNvme = (disk.name || disk.device || '').toLowerCase().includes('nvme') ||
                     (disk.interfaceType || '').toLowerCase().includes('nvme');

      const tempVal = readAttr(['Temperature_Celsius', 'Airflow_Temperature_Cel'], ['190', '194']);
      const temperature = (smart && smart.temperature && smart.temperature !== 'N/A')
        ? parseInt(smart.temperature)
        : (tempVal !== 'N/A' ? tempVal : 30);

      const reallocated  = readAttr(['Reallocated_Sector_Ct'], ['5']);
      const uncorrectable = readAttr(['Uncorrectable_Error_Cnt', 'UDMA_CRC_Error_Count'], ['187', '199']);
      const pending      = readAttr(['Current_Pending_Sector'], ['197']);
      const offline      = readAttr(['Offline_Uncorrectable'], ['198']);
      const wearLevel    = readAttr(['Wear_Leveling_Count', 'Percent_Lifetime_Used'], ['173', '177', '231', '233']);
      const mediaErrors  = readAttr(['Media_Wearout_Indicator', 'Media_and_Data_Integrity_Errors'], ['184', '188']);
      const percentUsed  = readAttr(['Percent_Lifetime_Used', 'SSD_Life_Left'], ['177', '231']);

      const num = (v) => v === 'N/A' ? 0 : v;
      const isAtRisk = isNvme
        ? (num(mediaErrors) > 0 || num(percentUsed) > 80)
        : (num(reallocated) > 10 || num(uncorrectable) > 0 || num(pending) > 0 || num(offline) > 0);

      // Predictive slope analysis
      let predictedDays = null;
      try {
        const history = await db.getDiskAnalytics(hostId, disk.name || diskName, 10);
        if (history.length > 3) {
          const first = history[history.length - 1];
          const errDiff = isNvme ? (mediaErrors - first.uncorrectable) : (reallocated - first.reallocated);
          const timeDiffDays = (new Date(history[0].timestamp) - new Date(first.timestamp)) / (1000 * 60 * 60 * 24);
          if (errDiff > 0 && timeDiffDays > 0) {
            const slope = errDiff / timeDiffDays;
            const remainingToCrit = isNvme ? (100 - percentUsed) : (50 - reallocated);
            if (slope > 0) predictedDays = Math.max(1, Math.round(remainingToCrit / slope));
            if (predictedDays !== null && predictedDays < 30) isAtRisk = true;
          }
        }
      } catch (e) {}

      // Persist to DB
      db.saveDiskAnalytics(hostId, disk.name || diskName,
        isAtRisk ? 'WARNING' : 'PASSED',
        temperature,
        isNvme ? percentUsed : (reallocated || 0),
        isNvme ? mediaErrors : (uncorrectable || 0)
      );

      // OS metadata
      let osMetadata = null;
      try {
        const cp = require('child_process'), util = require('util');
        const exec = util.promisify(cp.exec);
        if (process.platform === 'win32') {
          const pdMatch = (disk.device || '').match(/PHYSICALDRIVE(\d+)/i);
          const pdIndex = pdMatch ? pdMatch[1] : '0';
          const { stdout } = await exec(
            `powershell -NoProfile -Command "Get-PhysicalDisk -DeviceNumber ${pdIndex} | Select-Object MediaType,HealthStatus,OperationalStatus | ConvertTo-Json"`
          );
          osMetadata = JSON.parse(stdout);
        }
      } catch (e) {}

      return {
        success: true, scan_type: 'fast',
        disk: disk.name || diskName,
        diskModel: disk.model || disk.name,
        diskSize: disk.size,
        diskInterface: disk.interfaceType,
        diskSerial: disk.serialNum,
        timestamp: new Date().toISOString(),
        predicted_days: predictedDays,
        fatal_five: isNvme ? {
          'NVMe Media Errors':     mediaErrors,
          'NVMe Percentage Used':  percentUsed,
          'NVMe Available Spare':  readAttr(['Available_Spare'], ['13']) || (100 - percentUsed),
          'Temperature (°C)':      temperature
        } : {
          'SMART 5 (Reallocated Sectors)':       reallocated,
          'SMART 187 (Uncorrectable Errors)':    uncorrectable,
          'SMART 197 (Pending Sectors)':         pending,
          'SMART 198 (Offline Uncorrectable)':   offline,
          'SMART 173 (Wear Leveling)':           wearLevel || 0,
        },
        temperature,
        overall_health: isAtRisk ? 'WARNING' : 'PASSED',
        overallStatus: isAtRisk ? 'WARNING' : 'PASSED',
        errorCount: isNvme ? num(mediaErrors) : (num(reallocated) + num(uncorrectable) + num(pending) + num(offline)),
        smartStatus: (smart && smart.status) || (disk.smartStatus) || 'OK',
        isAtRisk,
        reallocated: isNvme ? mediaErrors : reallocated,
        os_metadata: osMetadata
      };
    } catch (err) {
      return { success: false, error: err.message };
    }
  }

  // ── SSH/Remote path (unchanged) ──────────────────────────────────────────
  try {
    const isNvme = diskName.toLowerCase().includes('nvme');
    let rawOutput;
    let winArgs = `-a /dev/${diskName}`;
    let osMetadata = null;

    try {
      const isWin = await executeGhostPayload(hostId, 'raw', 'echo win', 'echo lin');
      if (isWin.includes('lin')) {
        const out = await executeGhostPayload(hostId, 'raw', '', `lsblk /dev/${diskName} -o NAME,SIZE,TYPE,FSTYPE,MOUNTPOINT -J`);
        if (out && out.includes('{')) osMetadata = JSON.parse(out.substring(out.indexOf('{')));
      }
    } catch (e) {}

    if (isNvme) {
      rawOutput = await executeGhostPayload(hostId, 'raw', `smartctl ${winArgs}`, `nvme smart-log /dev/${diskName} || smartctl -a /dev/${diskName}`);
    } else {
      rawOutput = await executeGhostPayload(hostId, 'smartctl', winArgs, `-a /dev/${diskName}`);
    }

    const extract = (regex) => { const match = rawOutput.match(regex); return match ? parseInt(match[1].replace(/,/g, ''), 10) : 0; };
    const temperature = isNvme ? extract(/temperature\s*:\s*(\d+)/i) : extract(/Temperature_Celsius.*?\s+(\d+)(?:\r?\n|$)/) || 30;
    const reallocated  = isNvme ? extract(/available_spare\s*:\s*(\d+)/i) : extract(/Reallocated_Sector_Ct.*?\s+(\d+)(?:\r?\n|$)/);
    const mediaErrors  = isNvme ? extract(/media_errors\s*:\s*(\d+)/i) : 0;
    const percentageUsed = isNvme ? extract(/percentage_used\s*:\s*(\d+)/i) : 0;
    const uncorrectable = isNvme ? mediaErrors : extract(/Uncorrectable_Error_Cnt.*?\s+(\d+)(?:\r?\n|$)/);
    const pending = extract(/Current_Pending_Sector.*?\s+(\d+)(?:\r?\n|$)/);
    const offline = extract(/Offline_Uncorrectable.*?\s+(\d+)(?:\r?\n|$)/);
    const wearLevel = isNvme ? percentageUsed : extract(/Wear_Leveling_Count.*?\s+(\d+)(?:\r?\n|$)/);
    const isAtRisk = isNvme ? (mediaErrors > 0 || percentageUsed > 80) : (reallocated > 10 || uncorrectable > 0 || pending > 0 || offline > 0);

    db.saveDiskAnalytics(hostId, diskName, isAtRisk ? 'WARNING' : 'PASSED', temperature, isNvme ? percentageUsed : (reallocated || 0), isNvme ? mediaErrors : (uncorrectable || 0));

    return {
      success: true, scan_type: 'fast', disk: diskName, timestamp: new Date().toISOString(),
      fatal_five: isNvme ? {
        'NVMe Media Errors': mediaErrors, 'NVMe Percentage Used': percentageUsed,
        'NVMe Available Spare': extract(/available_spare\s*:\s*(\d+)/i) || 100, 'Temperature': temperature
      } : {
        'SMART 5 (Reallocated Sectors)': reallocated, 'SMART 187 (Uncorrectable Errors)': uncorrectable,
        'SMART 197 (Pending Sectors)': pending, 'SMART 198 (Offline Uncorrectable)': offline,
        'SMART 173 (Wear Leveling)': wearLevel || 0,
      },
      temperature, overall_health: isAtRisk ? 'WARNING' : 'PASSED', isAtRisk,
      reallocated: (isNvme ? mediaErrors : reallocated), os_metadata: osMetadata
    };
  } catch (e) {
    return { success: false, error: e.message };
  }
};

