});

// ─── API Routes (Services) ──────────────────────────────────────────────────
// ─── Docker Container Management ──────────────────────────────────────────
const cp = require('child_process');
const util = require('util');
const execPromise = util.promisify(cp.exec);

app.post('/api/docker/:action', verifyAdmin, async (req, res) => {
  const action = req.params.action;
  const { containerId } = req.body;
  if (!['start', 'stop', 'restart'].includes(action)) {
    return res.status(400).json({ error: 'Invalid action' });
  }
  if (!containerId || !SAFE_CONTAINER_ID.test(containerId)) {
    db.logEvent('hub', 'security', `[BLOCKED] Invalid container ID format: '${String(containerId).substring(0, 50)}' from user ${req.user.username}`);
    return res.status(400).json({ error: 'Invalid container ID format. Only alphanumeric, dots, hyphens, and underscores allowed.' });
  }
  
  try {
    // Use execFile (not exec) to prevent shell injection entirely
    const { execFile } = require('child_process');
    const result = await new Promise((resolve, reject) => {
      execFile('docker', [action, containerId], { timeout: 30000 }, (err, stdout, stderr) => {
        if (err) return reject(err);
        resolve({ stdout, stderr });
      });
    });
    logEvent('system', `Docker container ${containerId} ${action}ed by ${req.user.username}`, { output: result.stdout || result.stderr });
    res.json({ success: true, message: `Container ${action}ed successfully.` });
  } catch (err) {
    logEvent('error', `Failed to ${action} docker container ${containerId}`, { error: err.message });
    res.status(500).json({ error: 'Docker operation failed. Check container status.' });
  }
});

app.use('/', require('./routes/services'));

// ─── Global API Error Handler ─────────────────────────────────────────────────
app.use('/api', (err, req, res, next) => {
  console.error('[API Error]', req.method, req.path, err.message || err);
  res.status(err.status || 500).json({
    error: process.env.NODE_ENV === 'production'
      ? 'Internal server error'
      : err.message || 'Unknown error'
  });
});

// Serve live disk monitor script (no auth — loaded by index.html)
app.get('/live-disk-monitor.js', (req, res) => {
  const monPath = path.join(__dirname, 'live-disk-monitor.js');
  if (fs.existsSync(monPath)) {
    res.setHeader('Content-Type', 'application/javascript');
    res.setHeader('Cache-Control', 'no-store');
    res.sendFile(monPath);
  } else {
    res.status(404).send('// live-disk-monitor.js not found');
  }
});

// ─── Serve Frontend Static Files ──────────────────────────────────────────────
const FRONTEND_DIST = path.join(__dirname, '..', 'frontend', 'dist');
if (fs.existsSync(FRONTEND_DIST)) {
  // Serve hashed assets (JS/CSS) with long cache — filenames change on each build
  app.use('/assets', express.static(path.join(FRONTEND_DIST, 'assets'), {
    maxAge: '1y',
    immutable: true,
  }));
  // Serve everything else with no-cache (especially index.html)
  app.use(express.static(FRONTEND_DIST, {
    etag: true,
    lastModified: true,
    setHeaders: (res, filePath) => {
      if (filePath.endsWith('index.html')) {
        res.setHeader('Cache-Control', 'no-store, no-cache, must-revalidate');
        res.setHeader('Pragma', 'no-cache');
        res.setHeader('Expires', '0');
      }
    }
  }));
  // SPA fallback — Express v5 requires '/{*path}' instead of '*'
  app.get('/{*path}', (req, res) => {
    if (!req.path.startsWith('/api/') && !req.path.startsWith('/socket.io')) {
      res.setHeader('Cache-Control', 'no-store, no-cache, must-revalidate');
      res.sendFile(path.join(FRONTEND_DIST, 'index.html'));
    }
  });
  console.log(`[TelemetryHub] Serving frontend from: ${FRONTEND_DIST}`);
} else {
  console.warn('[TelemetryHub] Frontend dist not found — run "npm run build" in /frontend');
}


// ─── Scan Report Visualization ───────────────────────────────────────────────
app.get('/api/scan/report/:jobId', authMiddleware, (req, res) => {
  const cached = scanResultCache.get(req.params.jobId);
  if (!cached) return res.status(404).json({ error: 'Scan result not found. Run a deep scan first.' });
  res.setHeader('Content-Type', 'text/html; charset=utf-8');
  res.send(generateScanReportHTML(cached.result, cached.hostId, cached.diskName));
});

app.post('/api/scan/report/render', authMiddleware, (req, res) => {
  const result = req.body;
  if (!result || typeof result !== 'object') return res.status(400).json({ error: 'Provide scan result JSON in request body' });
  res.setHeader('Content-Type', 'text/html; charset=utf-8');
  res.send(generateScanReportHTML(result, result.hostId, result.disk));
});

// ─── Boot ─────────────────────────────────────────────────────────────────────

const PORT = process.env.PORT || 5010;
server.listen(PORT, '0.0.0.0', async () => {
  console.log(`[TelemetryHub] Enterprise Backend running on port ${PORT} (0.0.0.0)`);

  db.logEvent('hub', 'system', 'Server started with persistence and automation engines active.');
  pollDisks();
  discoverNetworkDevices();

  // ── Auto-create default admin if no users exist ──────────────────────────
  try {
    const users = await db.getUsers();
    if (users.length === 0) {
      const hash = await bcrypt.hash('root', 12);
      await db.createUser('root', hash, 'admin');
      console.log('\n  ╔══════════════════════════════════════════════════════╗');
      console.log('  ║  DEFAULT ADMIN CREATED                               ║');
      console.log('  ║  Username: root     Password: root                   ║');
      console.log('  ║  ⚠  CHANGE YOUR PASSWORD IMMEDIATELY AFTER LOGIN     ║');
      console.log('  ╚══════════════════════════════════════════════════════╝\n');
    }
  } catch (e) { console.error('[Auth] Admin init error:', e.message); }
});
